		<div class="ltfoot"><div class="skins"><div id="sk_midnight" class="skin-dot sd-midnight on" action="skin:midnight"></div><div id="sk_ember" class="skin-dot sd-ember" action="skin:ember"></div><div id="sk_forest" class="skin-dot sd-forest" action="skin:forest"></div><div id="sk_paper" class="skin-dot sd-paper" action="skin:paper"></div></div>
			<div class="spacer"></div>
			<div class="chromes"><div class="chip" action="chrome:redguides">redguides</div><div class="chip" action="chrome:azure">azure</div><div class="chip" action="chrome:violet">violet</div><div class="chip" action="chrome:ember">ember</div><div class="chip" action="chrome:jade">jade</div><div class="chip" action="chrome:rose">rose</div></div></div>
	</div>

	</div>
</div>
</body>
</rml>
