/* RmlUi Pro showcase for MQ2RmlUi (RmlUi 6.2, RenderInterface_DX9).
   Effect properties only apply under the .cap-* classes on #shell (from rml_render_caps). Infinite animations only run on the visible page (.page.on).
   Borders are "<width> <colour>" (RmlUi has no border-style keyword). */

#window-frame, #window-content { animation: none; }
#window-content { display: flex; flex-direction: column; padding: 0; overflow: hidden; }

/* ---------- skins (class swap on #shell) ---------- */
.shell { display: flex; flex-direction: row; flex: 1; min-height: 0;
	transition: background-color 0.35s cubic-out; }
.skin-midnight { background-color: #0d111a; color: #dfe6f5; }
.skin-ember    { background-color: #1a0f0b; color: #f5e2d8; }
.skin-forest   { background-color: #0c1611; color: #dcefe3; }
.skin-paper    { background-color: #e9e4d8; color: #2a2620; }

.skin-midnight .card, .skin-midnight .side { background-color: #151b28; border-color: #2a3550; }
.skin-ember    .card, .skin-ember    .side { background-color: #251510; border-color: #5a2c1c; }
.skin-forest   .card, .skin-forest   .side { background-color: #13221a; border-color: #2b4a38; }
.skin-paper    .card, .skin-paper    .side { background-color: #f6f2e8; border-color: #c9bfa8; }

.skin-midnight .accent-bg, .skin-midnight .nav.on, .skin-midnight .btn.primary { background-color: #3d6fe0; }
.skin-ember    .accent-bg, .skin-ember    .nav.on, .skin-ember    .btn.primary { background-color: #d9572b; }
.skin-forest   .accent-bg, .skin-forest   .nav.on, .skin-forest   .btn.primary { background-color: #2f9e62; }
.skin-paper    .accent-bg, .skin-paper    .nav.on, .skin-paper    .btn.primary { background-color: #8a6a2f; color: #ffffff; }
.skin-paper .lbl, .skin-paper .cap, .skin-paper .muted { color: #6d6555; }
.skin-paper .h1, .skin-paper .h2 { color: #2a2620; }
.skin-paper .nav { color: #5a5242; }
.skin-paper .nav:hover { background-color: #00000010; color: #2a2620; }
.skin-paper .nav.on { color: #ffffff; }
.skin-paper .btn { background-color: #00000010; border-color: #00000025; color: #2a2620; }
.skin-paper .brand-sub, .skin-paper .side-foot, .skin-paper .nav-n { color: #8a8270; }
.skin-paper .mono { color: #1d4fa8; }

/* ---------- layout ---------- */
.side { flex: 0 0 190dp; display: flex; flex-direction: column; gap: 2dp; padding: 12dp 8dp;
	border-width: 0 1dp 0 0; border-color: #2a3550;
	transition: background-color 0.35s cubic-out; }
.brand { padding: 4dp 10dp 12dp 10dp; }
.brand-title { font-size: 18dp; font-weight: bold; font-effect: glow(1dp 4dp #4c8dff88); }
.brand-sub { font-size: 10.5dp; color: #8d97ad; }
.nav { padding: 7dp 10dp; border-radius: 7dp; font-size: 12.5dp; color: #aab3c8; cursor: pointer;
	transition: background-color color padding-left 0.18s cubic-out; }
.nav:hover { background-color: #ffffff10; color: #ffffff; padding-left: 14dp; }
.nav.on { color: #ffffff; font-weight: bold; }
.nav-n { font-size: 10dp; color: #6f7a94; margin-right: 8dp; }
.nav.on .nav-n { color: #ffffffaa; }
.side-fill { flex: 1; }
.side-foot { font-size: 10.5dp; color: #6f7a94; padding: 4dp 10dp; }

.main { flex: 1; min-width: 0; position: relative; overflow: hidden auto; padding: 14dp 16dp; }
.page { display: none; flex-direction: column; gap: 10dp; }
.page > * { flex-shrink: 0; }
.page.on { display: flex; animation: 0.28s cubic-out 1 page-in; }
@keyframes page-in {
	from { opacity: 0; transform: translateX(14dp); }
	to   { opacity: 1; transform: translateX(0dp); }
}
.cap { font-size: 10.5dp; color: #7f8aa6; text-transform: uppercase; letter-spacing: 0.5dp; }
.h1 { font-size: 22dp; font-weight: bold; color: #ffffff; }
.h2 { font-size: 15dp; font-weight: bold; }
.p { font-size: 12.5dp; line-height: 1.4; }
.lbl { font-size: 10.5dp; font-weight: bold; color: #8d97ad; margin-bottom: 6dp; }
.muted { color: #8d97ad; }
.mono { font-size: 11.5dp; color: #9ec4ff; }
.small { font-size: 10dp; }
.row { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 8dp; }
.row.center { justify-content: center; }
.grid2, .grid3 { display: flex; flex-direction: row; flex-wrap: wrap; gap: 10dp; }
.grid2 > div { flex: 1 1 260dp; }
.grid3 > div { flex: 1 1 170dp; }
.card { padding: 10dp 12dp; border-radius: 10dp; border: 1dp #2a3550; background-color: #151b28;
	transition: background-color border-color 0.35s cubic-out; }
.card.wide { flex: 0 0 auto; }
.grid2 > .card.wide, .grid3 > .card.wide { flex: 1 1 100%; }
.stage { height: 90dp; display: flex; align-items: center; justify-content: center; }

.btn { display: inline-block; padding: 6dp 12dp; border-radius: 7dp; font-size: 12dp; font-weight: bold;
	background-color: #ffffff12; border: 1dp #ffffff1a; cursor: pointer;
	transition: background-color transform 0.15s cubic-out; }
.btn:hover { background-color: #ffffff24; transform: translateY(-1dp); }
.btn:active { transform: scale(0.96); }
.btn.primary { color: #ffffff; border-color: #ffffff30; }

.page.on /* ---------- 01 motion ---------- */
.spinner { width: 46dp; height: 46dp; border-radius: 23dp; border: 4dp #ffffff18; border-top-color: #4c8dff;
	animation: 0.9s linear-in-out infinite spin; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.page.on .pulse { width: 40dp; height: 40dp; border-radius: 20dp; background-color: #ff5a7a;
	animation: 0.8s sine-in-out infinite alternate pulse; }
@keyframes pulse { from { transform: scale(0.7); opacity: 0.45; } to { transform: scale(1.15); opacity: 1; } }
.page.on .hopper { width: 30dp; height: 30dp; border-radius: 6dp; background-color: #2fcf95;
	animation: 1.4s bounce-out infinite hop; }
@keyframes hop {
	0%   { transform: translateY(-30dp) rotate(0deg); }
	50%  { transform: translateY(20dp) rotate(90deg); }
	75%  { transform: translateY(0dp) rotate(135deg); }
	100% { transform: translateY(-30dp) rotate(180deg); }
}
.dots { gap: 6dp; }
.page.on .dot { width: 12dp; height: 12dp; border-radius: 6dp; background-color: #ffcf45;
	animation: 0.6s quadratic-in-out infinite alternate dotup; }
.page.on .d2 { animation: 0.6s quadratic-in-out 0.1s infinite alternate dotup; }
.page.on .d3 { animation: 0.6s quadratic-in-out 0.2s infinite alternate dotup; }
.page.on .d4 { animation: 0.6s quadratic-in-out 0.3s infinite alternate dotup; }
.page.on .d5 { animation: 0.6s quadratic-in-out 0.4s infinite alternate dotup; }
@keyframes dotup { from { transform: translateY(10dp); opacity: 0.3; } to { transform: translateY(-10dp); opacity: 1; } }
.page.on .hue { width: 120dp; height: 34dp; border-radius: 8dp; animation: 3s linear-in-out infinite hues; }
@keyframes hues {
	0%   { background-color: #ff4d6d; }
	33%  { background-color: #ffcf45; }
	66%  { background-color: #4c8dff; }
	100% { background-color: #ff4d6d; }
}
.hoverbox { padding: 10dp 16dp; border-radius: 8dp; background-color: #ffffff12; border: 1dp #ffffff22;
	transition: background-color border-color transform 0.3s elastic-out; }
.hoverbox:hover { background-color: #4c8dff55; border-color: #4c8dff; transform: scale(1.15) rotate(-4deg); }
.tw { padding: 4dp 8dp; border-radius: 6dp; font-size: 11dp; background-color: #ffffff0c; cursor: pointer; }
.tw.on { background-color: #4c8dff66; color: #ffffff; }
.track { height: 30dp; margin: 8dp 0; border-radius: 15dp; background-color: #00000040; position: relative; }
.runner { position: absolute; left: 0dp; top: 3dp; width: 24dp; height: 24dp; border-radius: 12dp;
	background-color: #ffcf45; transition: left 0.8s cubic-out; }
.runner.far { left: 380dp; }

/* ---------- 02 3D ---------- */
.persp { height: 120dp; display: flex; align-items: center; justify-content: center;
	perspective: 400dp; perspective-origin: 50% 50%; }
.flip { width: 110dp; height: 80dp; position: relative; cursor: pointer;
	transition: transform 0.7s cubic-in-out; }
.flip.on { transform: rotateY(180deg); }
.face { position: absolute; left: 0; top: 0; width: 110dp; height: 80dp; border-radius: 10dp;
	text-align: center; padding-top: 22dp; box-sizing: border-box; font-weight: bold; }
.face.front { background-color: #3d6fe0; color: #ffffff; }
/* RmlUi has no backface-visibility: the back face is pre-rotated and faded in at the halfway point */
.face.back { background-color: #d9572b; color: #ffffff; transform: rotateY(180deg); opacity: 0;
	transition: opacity 0.01s linear-in-out 0.35s; }
.flip.on .face.back { opacity: 1; }
.flip .face.front { transition: opacity 0.01s linear-in-out 0.35s; }
.flip.on .face.front { opacity: 0; }
.page.on .turntable { width: 80dp; height: 80dp; border-radius: 10dp; background-color: #9b6bff; color: #ffffff;
	text-align: center; line-height: 80dp; font-size: 20dp; font-weight: bold;
	animation: 4s linear-in-out infinite turn; }
@keyframes turn { from { transform: rotateY(0deg); } to { transform: rotateY(360deg); } }
.tilt { width: 120dp; height: 70dp; border-radius: 10dp; background-color: #2fcf95; color: #0b1a12;
	text-align: center; line-height: 70dp; font-weight: bold;
	transition: transform 0.4s back-out; }
.tilt:hover { transform: rotateX(35deg) scale(1.08); }
.page.on .tumble { width: 60dp; height: 60dp; border-radius: 8dp; background-color: #ffcf45;
	animation: 3s linear-in-out infinite tumble; }
@keyframes tumble { from { transform: rotate3d(1, 1, 0, 0deg); } to { transform: rotate3d(1, 1, 0, 360deg); } }
.page.on .skewer { width: 90dp; height: 50dp; border-radius: 6dp; background-color: #ff5a7a; color: #ffffff;
	text-align: center; line-height: 50dp; animation: 1.6s sine-in-out infinite alternate skew; }
@keyframes skew { from { transform: skewX(-20deg) scale(0.9); } to { transform: skewX(20deg) scale(1.1); } }
.page.on .door { width: 70dp; height: 90dp; border-radius: 4dp; background-color: #8a6a2f; color: #ffffff;
	text-align: center; line-height: 90dp; transform-origin: 0% 50%;
	animation: 2.4s cubic-in-out infinite alternate door; }
@keyframes door { from { transform: rotateY(0deg); } to { transform: rotateY(-70deg); } }

/* ---------- 03 gradients (straight-gradient decorators) ---------- */
.swatch { height: 76dp; border-radius: 10dp; border: 1dp #ffffff14; position: relative; }
.swatch span { position: absolute; left: 10dp; bottom: 8dp; font-size: 11dp; font-weight: bold; color: #ffffff;
	font-effect: shadow(1dp 1dp #000000aa); }
.g1 { decorator: horizontal-gradient(#ff4d6d #ffcf45); }
.g2 { decorator: vertical-gradient(#4c8dff #10204a); }
.g3 { decorator: horizontal-gradient(#00000000 #000000aa), vertical-gradient(#2fcf95 #1d4fa8); }
.g4 { border-radius: 38dp; decorator: horizontal-gradient(#9b6bff #ff5a7a); }
.page.on .g5 { animation: 2.5s sine-in-out infinite alternate gshift; }
@keyframes gshift {
	from { decorator: horizontal-gradient(#4c8dff #9b6bff); }
	to   { decorator: horizontal-gradient(#ff5a7a #ffcf45); }
}
.g6 { border: 3dp #00000000; decorator: horizontal-gradient(#ff4d6d #4c8dff); background-color: #0d111a; }
.note { padding: 10dp 12dp; border-radius: 8dp; border: 1dp #ffcf4555; background-color: #ffcf4512; font-size: 12dp; line-height: 1.4; }
.note-h { font-weight: bold; color: #ffcf45; margin-bottom: 4dp; }

.sg-off { display: none; }
.swatch span { z-index: 2; }
.clip { overflow: hidden; }
.sgbase { background-color: #0b0f18; }
.page.on /* shimmer: a translucent linear-gradient band slides across */
.sweep { position: absolute; top: 0; left: 0; width: 70dp; height: 100%;
	decorator: linear-gradient(to right, #ffffff00, #ffffff70, #ffffff00);
	animation: 1.8s cubic-in-out infinite shimmer; }
@keyframes shimmer { from { transform: translateX(-80dp) skewX(-20deg); } to { transform: translateX(260dp) skewX(-20deg); } }
.page.on /* radial glow pulse */
.glow { position: absolute; left: 50%; top: 50%; width: 120dp; height: 120dp; margin: -60dp 0 0 -60dp;
	decorator: radial-gradient(circle, #ffffffff 0%, #9b6bffcc 30%, #4c8dff00 70%);
	animation: 1.2s sine-in-out infinite alternate glowpulse; }
@keyframes glowpulse { from { transform: scale(0.6); opacity: 0.5; } to { transform: scale(1.2); opacity: 1; } }
.page.on /* conic ring: spinning conic disc with a dark disc on top */
.ring { position: absolute; left: 50%; top: 50%; width: 64dp; height: 64dp; margin: -32dp 0 0 -32dp; border-radius: 32dp;
	decorator: conic-gradient(#4c8dff00, #4c8dff, #2fcf95, #ffffff);
	animation: 1.1s linear-in-out infinite spin; }
.ring-hole { position: absolute; left: 50%; top: 50%; width: 46dp; height: 46dp; margin: -23dp 0 0 -23dp; border-radius: 23dp; background-color: #0b0f18; }
.page.on /* barber pole: stripes period 16dp at 45deg = 22.63dp horizontally, .page.on so a 22.63dp translate loops seamlessly */
.pole { position: absolute; top: 0; left: -23dp; right: -23dp; height: 100%;
	decorator: repeating-linear-gradient(45deg, #ffcf45 0dp, #ffcf45 8dp, #1a1a1a 8dp, #1a1a1a 16dp);
	animation: 0.6s linear-in-out infinite pole; }
@keyframes pole { from { transform: translateX(0dp); } to { transform: translateX(22.63dp); } }
.page.on .ripple { position: absolute; left: 50%; top: 50%; width: 240dp; height: 240dp; margin: -120dp 0 0 -120dp;
	decorator: repeating-radial-gradient(circle, #4c8dff 0dp, #10204a 12dp, #4c8dff 24dp);
	animation: 1.5s linear-in-out infinite ripple; }
@keyframes ripple { from { transform: scale(1); } to { transform: scale(1.2); } }
.page.on .rays { position: absolute; left: 50%; top: 50%; width: 260dp; height: 260dp; margin: -130dp 0 0 -130dp;
	decorator: repeating-conic-gradient(#ffffff 0deg, #ffffff 15deg, #222222 15deg, #222222 30deg);
	animation: 8s linear-in-out infinite spin; }
.hovercard { border: 2dp #3d6fe000; transition: transform border-color opacity 0.25s back-out; opacity: 0.85; }
.hovercard:hover { transform: translateY(-4dp) scale(1.04); border-color: #9ec4ff; opacity: 1; }
/* shader gradients (need RenderInterface::CompileShader, i.e. the MQ2RmlUi gradients build) */
.sg1 { decorator: linear-gradient(135deg, #ff4d6d, #ffcf45 50%, #4c8dff); }
.sg2 { decorator: radial-gradient(circle, #ffffff 0%, #9b6bff 40%, #10204a 100%); }
.sg3 { decorator: conic-gradient(#ff4d6d, #ffcf45, #2fcf95, #4c8dff, #ff4d6d); }
.sg4 { decorator: repeating-linear-gradient(45deg, #ffcf45 0dp, #ffcf45 8dp, #1a1a1a 8dp, #1a1a1a 16dp); }
.sg5 { decorator: repeating-radial-gradient(circle, #4c8dff 0dp, #10204a 12dp, #4c8dff 24dp); }
.sg6 { decorator: repeating-conic-gradient(#ffffff 0deg, #ffffff 15deg, #222222 15deg, #222222 30deg); }
.sg7 { decorator: image(i3 contain), linear-gradient(to right, #00000000, #3d6fe0ee); }
.sg8 { decorator: radial-gradient(ellipse at 0% 0%, #ffcf45, #d9572b 50%, #00000000 100%); }
.sg9 { border-radius: 38dp; decorator: conic-gradient(from 90deg, #9b6bff, #2fcf95, #9b6bff); }
.page.on .spin-slow { animation: 6s linear-in-out infinite spinslow; }
@keyframes spinslow { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

/* ---------- 04 glow & text fx ---------- */
.fx-text { font-size: 30dp; font-weight: bold; text-align: center; padding: 10dp 0; color: #ffffff; }
.fx-glow    { font-effect: glow(3dp 6dp #4c8dff); }
.fx-outline { color: #ffcf45; font-effect: outline(2dp #000000); }
.fx-shadow  { font-effect: shadow(3dp 3dp #000000); }
.fx-neon    { color: #ffe8ff; font-effect: glow(2dp 8dp #ff4dd2), outline(1dp #ff4dd2); }
.halo { padding: 5dp; border-radius: 22dp; margin: 6dp 12dp; }
.halo-in { padding: 10dp 22dp; border-radius: 17dp; font-weight: bold; color: #ffffff; }
.h-blue { background-color: #4c8dff22; border: 2dp #4c8dff44; }
.h-blue .halo-in { background-color: #3d6fe0; border: 1dp #9ec4ff; }
.h-gold { background-color: #ffcf4522; border: 2dp #ffcf4544; }
.h-gold .halo-in { background-color: #b8860b; border: 1dp #ffe08a; }
.h-red { background-color: #ff4d6d22; border: 2dp #ff4d6d44; }
.h-red .halo-in { background-color: #c4141c; border: 1dp #ff9aa8; }
.page.on .pulse-halo { animation: 0.9s sine-in-out infinite alternate halo; }
@keyframes halo {
	from { background-color: #ff4d6d10; border-color: #ff4d6d22; }
	to   { background-color: #ff4d6d44; border-color: #ff4d6daa; }
}

/* ---------- 05 clipping ---------- */
.clip-circle { width: 90dp; height: 90dp; border-radius: 45dp; overflow: hidden; margin: 0 auto; border: 2dp #4c8dff; }
.page.on .clip-scroll { width: 300dp; height: 90dp; decorator: horizontal-gradient(#ff4d6d #4c8dff);
	animation: 3s sine-in-out infinite alternate slide; }
@keyframes slide { from { transform: translateX(0dp); } to { transform: translateX(-210dp); } }
.clip-pill { height: 26dp; border-radius: 13dp; overflow: hidden; background-color: #00000050; margin-top: 30dp; }
.page.on .stripe { width: 60dp; height: 26dp; background-color: #ffffff55; transform: skewX(-25deg);
	animation: 1.6s cubic-in-out infinite stripe; }
@keyframes stripe { from { transform: translateX(-60dp) skewX(-25deg); } to { transform: translateX(260dp) skewX(-25deg); } }
.clip-outer { width: 100dp; height: 90dp; border-radius: 24dp; overflow: hidden; margin: 0 auto; background-color: #ffcf45; padding: 10dp; box-sizing: border-box; }
.clip-inner { width: 80dp; height: 70dp; border-radius: 35dp; overflow: hidden; }
.clip-list { height: 120dp; overflow-y: auto; border-radius: 12dp; background-color: #00000040; }
.li { padding: 6dp 12dp; font-size: 12dp; border-width: 0 0 1dp 0; border-color: #ffffff0c;
	transition: background-color 0.15s linear-in-out; }
.li:hover { background-color: #4c8dff33; }

/* scrollbars (RmlUi scrollbarvertical) */
scrollbarvertical { width: 8dp; margin-left: 2dp; }
scrollbarvertical slidertrack { background-color: #00000030; border-radius: 4dp; }
scrollbarvertical sliderbar { background-color: #ffffff40; border-radius: 4dp; }
scrollbarvertical sliderbar:hover { background-color: #ffffff70; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0; width: 0; }
scrollbarhorizontal { height: 0; }

/* ---------- 06 sprites ---------- */
@spritesheet pro-icons {
	src: iconsheet.png;
	i0: 0px 0px 40px 40px;
	i1: 40px 0px 40px 40px;
	i2: 80px 0px 40px 40px;
	i3: 120px 0px 40px 40px;
	i4: 160px 0px 40px 40px;
	i5: 200px 0px 40px 40px;
	i6: 240px 0px 40px 40px;
	i7: 280px 0px 40px 40px;
	/* nine slices of sprite i0 (12px corners) for tiled-box and ninepatch */
	b-tl: 0px 0px 12px 12px;   b-t: 12px 0px 16px 12px;   b-tr: 28px 0px 12px 12px;
	b-l: 0px 12px 12px 16px;   b-c: 12px 12px 16px 16px;  b-r: 28px 12px 12px 16px;
	b-bl: 0px 28px 12px 12px;  b-b: 12px 28px 16px 12px;  b-br: 28px 28px 12px 12px;
}
.spr { width: 34dp; height: 34dp; border-radius: 6dp; transition: transform 0.2s back-out; }
.spr:hover { transform: scale(1.25); }
.s0 { decorator: image(i0); } .s1 { decorator: image(i1); } .s2 { decorator: image(i2); } .s3 { decorator: image(i3); }
.s4 { decorator: image(i4); } .s5 { decorator: image(i5); } .s6 { decorator: image(i6); } .s7 { decorator: image(i7); }
.tint-red { image-color: #ff8080; } .tint-green { image-color: #80ff9a; }
.tint-blue { image-color: #80b0ff; } .tint-gold { image-color: #ffd070; }
.tiled-h { height: 40dp; decorator: tiled-horizontal(i0, i1, i2); }
.tiled-b { height: 80dp; padding: 30dp; box-sizing: border-box; text-align: center; font-weight: bold;
	decorator: tiled-box(b-tl, b-tr, b-bl, b-br, b-l, b-r, b-t, b-b, b-c); }
.nine { height: 70dp; padding: 22dp; box-sizing: border-box; text-align: center; font-weight: bold;
	decorator: ninepatch(i0, b-c, 12dp); }
.page.on .flipbook { width: 40dp; height: 40dp; margin: 10dp auto; animation: 0.8s linear-in-out infinite book; }
@keyframes book {
	0%   { decorator: image(i0); }
	25%  { decorator: image(i1); }
	50%  { decorator: image(i2); }
	75%  { decorator: image(i3); }
	100% { decorator: image(i0); }
}
.fit { width: 44dp; height: 30dp; border: 1dp #ffffff30; }
.f1 { decorator: image(i2 contain); } .f2 { decorator: image(i2 cover); } .f3 { decorator: image(i2 scale-none); }
.eqi { width: 32dp; height: 32dp; border-radius: 4dp; }

/* ---------- 07 controls ---------- */
.pg { display: block; height: 14dp; margin: 6dp 0; border-radius: 7dp; background-color: #00000050; }
.pg fill { border-radius: 7dp; decorator: horizontal-gradient(#3d6fe0 #9ec4ff); }
.pg-gold fill { decorator: horizontal-gradient(#b8860b #ffe08a); }
input.range { display: block; width: 100%; height: 22dp; margin: 6dp 0; }
input.range slidertrack { margin-top: 9dp; height: 4dp; border-radius: 2dp; background-color: #ffffff30; }
input.range sliderbar { width: 16dp; height: 16dp; margin-top: 3dp; border-radius: 8dp; background-color: #e7eaf3;
	transition: background-color 0.15s linear-in-out; }
input.range sliderbar:hover { background-color: #ffcf45; }
input.range sliderarrowdec, input.range sliderarrowinc { width: 0; height: 0; }
input.text, textarea.ta { display: block; width: 100%; box-sizing: border-box; padding: 6dp 8dp; border-radius: 6dp;
	background-color: #00000045; border: 1dp #ffffff22; color: #f2f4fa; font-size: 12dp; }
input.text { height: 30dp; }
input.text:focus, textarea.ta:focus { border-color: #4c8dffaa; }
textarea.ta { height: 64dp; margin-top: 6dp; }
.chk { display: block; padding: 4dp 0; font-size: 12.5dp; }
input.checkbox, input.radio { width: 14dp; height: 14dp; margin-right: 6dp; border: 1dp #ffffff55; background-color: #00000040;
	vertical-align: middle; transition: background-color 0.15s linear-in-out; }
input.checkbox { border-radius: 3dp; }
input.radio { border-radius: 7dp; }
input.checkbox:checked, input.radio:checked { background-color: #4c8dff; border-color: #9ec4ff; }
select.sel { display: block; width: 100%; height: 28dp; padding: 4dp 8dp; box-sizing: border-box; border-radius: 6dp;
	background-color: #00000045; border: 1dp #ffffff22; font-size: 12dp; }
select.sel selectvalue { padding-top: 2dp; }
select.sel selectarrow { width: 14dp; background-color: #ffffff20; border-radius: 4dp; }
select.sel selectbox { margin-top: 2dp; background-color: #1d2536; border: 1dp #3a4870; border-radius: 6dp; padding: 3dp; }
select.sel selectbox option { padding: 4dp 6dp; border-radius: 4dp; }
select.sel selectbox option:hover { background-color: #4c8dff44; }
.out { padding: 8dp 10dp; border-radius: 8dp; background-color: #00000045; white-space: pre-wrap; }

/* ---------- 08 tabset & lists ---------- */
tabset.ts { display: block; }
tabset.ts tabs { display: flex; flex-direction: row; gap: 4dp; padding: 3dp; border-radius: 9dp; background-color: #00000040; }
tabset.ts tab { flex: 1; padding: 7dp; text-align: center; font-size: 12dp; font-weight: bold; color: #8d97ad;
	border-radius: 6dp; cursor: pointer; transition: background-color color 0.18s cubic-out; }
tabset.ts tab:hover { color: #ffffff; }
tabset.ts tab:selected { background-color: #3d6fe0; color: #ffffff; }
tabset.ts panels { display: block; margin-top: 8dp; }
.list { height: 300dp; overflow-y: auto; border-radius: 10dp; background-color: #00000035; }
.li .spr { display: inline-block; vertical-align: middle; margin-right: 8dp; width: 24dp; height: 24dp; }
.li .r { float: right; color: #8d97ad; }

/* ---------- 09 tooltips ---------- */
.tips { padding: 70dp 0 30dp 0; gap: 28dp; }
.tipwrap { position: relative; }
.tip { position: absolute; bottom: 44dp; left: -20dp; width: 180dp; padding: 8dp 10dp; border-radius: 8dp;
	background-color: #0b0f18f2; border: 1dp #4c8dff88; font-size: 11.5dp; color: #dfe6f5;
	pointer-events: none; visibility: hidden; opacity: 0; transform: translateY(6dp);
	transition: opacity transform 0.18s cubic-out; }
.tipwrap:hover .tip { visibility: visible; opacity: 1; transform: translateY(0dp); }
.tip-h { font-weight: bold; color: #ffcf45; margin-bottom: 3dp; }

/* ---------- 10 live ---------- */
.vital { display: flex; flex-direction: row; align-items: center; gap: 8dp; margin: 5dp 0; font-size: 12dp; }
.vital span { flex: 0 0 44dp; }
.vbar { flex: 1; height: 12dp; border-radius: 6dp; background-color: #00000050; overflow: hidden; }
.vfill { height: 12dp; width: 100%; border-radius: 6dp; transition: width 0.4s cubic-out; }
.vfill.hp { decorator: horizontal-gradient(#c4141c #ff6b6b); }
.vfill.mn { decorator: horizontal-gradient(#1d4fa8 #6fa8ff); }
.vfill.en { decorator: horizontal-gradient(#b8860b #ffe08a); }
.page.on .vfill.low { animation: 0.5s linear-in-out infinite alternate lowhp; }
@keyframes lowhp { from { opacity: 1; } to { opacity: 0.35; } }
.kv { display: flex; flex-direction: row; justify-content: space-between; padding: 4dp 0; font-size: 12dp;
	border-width: 0 0 1dp 0; border-color: #ffffff0c; }
.log { height: 110dp; overflow-y: auto; font-size: 11dp; }
.log-line { padding: 2dp 0; color: #b8c0d4; }
.log-line .t { color: #6f7a94; margin-right: 8dp; }

/* ---------- 11 themes ---------- */
.skin-btn { padding: 10dp 16dp; border-radius: 8dp; font-weight: bold; cursor: pointer; border: 2dp #ffffff20;
	transition: border-color transform 0.2s back-out; }
.skin-btn:hover { transform: translateY(-2dp); }
.skin-btn.on { border-color: #ffffff; }
#sk_midnight { background-color: #151b28; color: #9ec4ff; }
#sk_ember { background-color: #3a1c12; color: #ffb08a; }
#sk_forest { background-color: #163324; color: #8ff0b8; }
#sk_paper { background-color: #f6f2e8; color: #5a4a2a; }
.preview { margin-top: 8dp; }

/* ---------- 12 effects build (only when the plugin reports render effects) ---------- */
/* ---- page 12: effects. Effect properties only apply under the #page12 cap-* classes set from
   rml_render_caps(), so a DLL without them never sees filter/box-shadow/mask (no log spam). ---- */
.fxc { min-height: 120dp; }
.cap-yes, .cap-no { display: inline-block; padding: 1dp 7dp; margin: 2dp 4dp 0 0; border-radius: 8dp; font-size: 11dp; }
.cap-yes { background-color: #2fcf9533; color: #7dffc8; }
.cap-no { background-color: #ff4d6d22; color: #ff9aa8; }
.fxc .demo { display: none; }
.fxc .nosup { display: block; margin-top: 10dp; padding: 14dp 10dp; border-radius: 8dp; border: 1dp #ffffff22;
	background-color: #00000033; color: #8d97ad; font-size: 11.5dp; text-align: center; }
.cap-filters .need-filters .demo, .cap-boxshadow .need-boxshadow .demo, .cap-backdrop .need-backdrop .demo,
.cap-mask .need-mask .demo { display: flex; }
.cap-backdrop .need-backdrop .demo.glassbox { display: block; }
.cap-filters .need-filters .nosup, .cap-boxshadow .need-boxshadow .nosup, .cap-backdrop .need-backdrop .nosup,
.cap-mask .need-mask .nosup { display: none; }
.fxrow { flex-direction: row; align-items: center; gap: 14dp; margin-top: 10dp; min-height: 70dp; }

.bchip { width: 54dp; height: 54dp; border-radius: 10dp; background-color: #4c8dff; color: #ffffff; font-weight: bold;
	text-align: center; line-height: 54dp; border: 3dp #ffcf45; }
.cap-filters .b1 { filter: blur(1.5dp); }
.cap-filters .b2 { filter: blur(4dp); }
.cap-filters .b3 { filter: blur(9dp); }

.dstext { font-size: 22dp; font-weight: bold; color: #ffcf45; }
.cap-filters .dstext { filter: drop-shadow(#000000e0 3dp 4dp 3dp); }
.dsico { width: 44dp; height: 44dp; }
.cap-filters .dsico { filter: drop-shadow(#000000c0 4dp 5dp 4dp); }
.cap-filters .page.on .dsico.glowico { filter: drop-shadow(#4c8dffff 0dp 0dp 6dp); animation: 1.6s sine-in-out infinite alternate icofloat; }
@keyframes icofloat { from { transform: translateY(0dp); } to { transform: translateY(-6dp); } }

.bsq { width: 70dp; height: 50dp; border-radius: 10dp; background-color: #e9eefa; color: #1a2233; font-size: 11dp;
	font-weight: bold; text-align: center; line-height: 50dp; margin: 6dp; }
.cap-boxshadow .bs-out { box-shadow: #000000c0 4dp 8dp 12dp 0dp; }
.cap-boxshadow .page.on .bs-glow { background-color: #1d2a44; color: #9ec4ff; box-shadow: #4c8dffcc 0dp 0dp 14dp 3dp;
	animation: 1.4s sine-in-out infinite alternate glowscale; }
@keyframes glowscale { from { transform: scale(0.94); } to { transform: scale(1.06); } }
.cap-boxshadow .bs-in { background-color: #2fcf95; box-shadow: #00000099 0dp 4dp 10dp 2dp inset, #ffffff66 0dp -2dp 4dp 0dp inset; }

.glassbox { position: relative; height: 120dp; margin-top: 10dp; border-radius: 10dp; }
.busy { position: absolute; left: 0; top: 0; right: 0; bottom: 0;
	decorator: repeating-linear-gradient(60deg, #ff4d6d 0dp, #ff4d6d 8dp, #ffcf45 8dp, #ffcf45 16dp, #4c8dff 16dp, #4c8dff 24dp); }
.blob { position: absolute; width: 70dp; height: 70dp; border-radius: 35dp; }
.page.on .b-a { left: 20dp; top: 10dp; background-color: #2fcf95; animation: 3s sine-in-out infinite alternate blobx; }
.page.on .b-b { right: 30dp; top: 40dp; background-color: #9b6bff; animation: 2.3s sine-in-out infinite alternate bloby; }
@keyframes blobx { from { transform: translateX(0dp); } to { transform: translateX(140dp); } }
@keyframes bloby { from { transform: translateY(-30dp); } to { transform: translateY(20dp); } }
.glass { position: absolute; left: 30dp; top: 22dp; right: 30dp; bottom: 22dp; border-radius: 12dp; padding: 10dp 14dp;
	background-color: #ffffff26; border: 1dp #ffffff88; }
.cap-backdrop .glass { backdrop-filter: blur(7dp) saturate(1.6); }
.glass-h { font-size: 16dp; font-weight: bold; color: #ffffff; font-effect: shadow(1dp 1dp #00000088); }
.glass-t { font-size: 11dp; color: #ffffff; font-effect: shadow(1dp 1dp #00000088); }

.cf-none, .cf-gray, .cf-sepia, .cf-hue, .cf-inv, .cf-pulse { width: 44dp; height: 44dp; }
.cap-filters .cf-gray { filter: grayscale(1); }
.cap-filters .cf-sepia { filter: sepia(1); }
.cap-filters .page.on .cf-hue { animation: 3s linear-in-out infinite huecycle; }
@keyframes huecycle { from { filter: hue-rotate(0deg); } to { filter: hue-rotate(360deg); } }
.cap-filters .cf-inv { filter: invert(1); }
.cap-filters .page.on .cf-pulse { animation: 1.2s sine-in-out infinite alternate cfpulse; }
@keyframes cfpulse { from { filter: grayscale(1) brightness(0.6); } to { filter: grayscale(0) brightness(1.4) contrast(1.2); } }

.ogroup { position: relative; width: 110dp; height: 70dp; }
.oa, .ob { position: absolute; width: 64dp; height: 46dp; border-radius: 8dp; }
.oa { left: 0; top: 0; background-color: #ff4d6d; }
.ob { left: 40dp; top: 22dp; background-color: #4c8dff; }
.og-plain .oa, .og-plain .ob { opacity: 0.55; }
.cap-filters .og-filter { filter: opacity(0.55); }

.maskbox { position: relative; width: 110dp; height: 110dp; }
.page.on .maskspin { position: absolute; left: 0; top: 0; width: 110dp; height: 110dp;
	decorator: conic-gradient(#ff4d6d, #ffcf45, #2fcf95, #4c8dff, #9b6bff, #ff4d6d); animation: 4s linear-in-out infinite spin; }
.cap-mask .maskbox { mask-image: radial-gradient(circle, #000000 35%, #00000000 70%); }
.maskbar { width: 260dp; height: 40dp; border-radius: 8dp;
	decorator: linear-gradient(90deg, #4c8dff, #9b6bff, #ff4d6d); }
.cap-mask .maskbar { mask-image: repeating-linear-gradient(90deg, #000000 0dp, #000000 14dp, #00000022 14dp, #00000022 20dp); }

/* ---------- 13 MQ examples ---------- */
/* code snippets: hidden until the page-level "Show code" toggle adds .show-code */
.code { display: none; }
.show-code .code { display: block; margin-top: 8dp; padding: 6dp 9dp; border-radius: 5dp;
	background-color: #05070c; border: 1dp #2a3550; border-left-width: 3dp; border-left-color: #4c8dff;
	font-family: Consolas; font-size: 10.5dp; line-height: 1.35; color: #c9d6f0; white-space: pre-wrap; }
.spacer { flex: 1; }
.small-btn { padding: 3dp 9dp; font-size: 10.5dp; }
.skin-paper .code { background-color: #00000010; color: #1d4fa8; }
.mqv { display: flex; flex-direction: row; align-items: center; gap: 8dp; margin: 5dp 0; font-size: 12dp; }
.mqv span { flex: 0 0 40dp; }
.mqv span.mono { flex: 0 0 52dp; white-space: nowrap; }
.mbar { flex: 1; height: 16dp; border-radius: 8dp; background-color: #00000060; overflow: hidden; border: 1dp #ffffff14; }
.mfill { position: relative; height: 16dp; width: 100%; border-radius: 8dp; overflow: hidden; transition: width 0.3s cubic-out; }
.f-hp { decorator: horizontal-gradient(#8a0f14 #ff5a5a); }
.shader-on .f-hp { decorator: linear-gradient(to right, #8a0f14, #ff5a5a); }
.f-mn { decorator: horizontal-gradient(#12357a #6fa8ff); }
.shader-on .f-mn { decorator: linear-gradient(to right, #12357a, #6fa8ff); }
.f-en { decorator: horizontal-gradient(#7a5a08 #ffe08a); }
.shader-on .f-en { decorator: linear-gradient(to right, #7a5a08, #ffe08a); }
.mqv.nores { opacity: 0.4; }
.mqv.nores .mfill { width: 0%; }
.page.on .mfill.low { animation: 0.45s sine-in-out infinite alternate lowhp; }
.mshine { position: absolute; left: 0; top: 0; width: 100%; height: 7dp;
	decorator: vertical-gradient(#ffffff40 #ffffff00); }
.shader-on .mshine { decorator: linear-gradient(to bottom, #ffffff40, #ffffff00); }
.castname { font-weight: bold; color: #ffcf45; }
.castname.idle { color: #8d97ad; font-weight: normal; }
.cbar.idle { opacity: 0.45; border-color: #ffffff20; }
.cbar { position: relative; height: 18dp; margin: 6dp 0; border-radius: 9dp; background-color: #00000060; border: 1dp #ffcf4540; }
.cfill { position: absolute; left: 0; top: 0; height: 100%; width: 0%;
	decorator: horizontal-gradient(#b8860b #ffcf45); }
.shader-on .cfill { decorator: linear-gradient(to right, #b8860b, #ffcf45); }
.csweep { position: absolute; top: 0; left: 0; width: 50dp; height: 100%; opacity: 0;
	background-color: #ffffff40; }
.shader-on .csweep { background-color: #00000000; decorator: linear-gradient(to right, #ffffff00, #ffffffaa, #ffffff00); }
.page.on .csweep.on { opacity: 1; animation: 0.9s linear-in-out infinite castsweep; }
@keyframes castsweep { from { transform: translateX(-50dp); } to { transform: translateX(330dp); } }
.bcol { display: flex; flex-direction: column; align-items: center; gap: 2dp; }
.bring { position: relative; width: 40dp; height: 40dp; border-radius: 8dp; padding: 2dp; box-sizing: border-box;
	background-color: #ffffff18; }
.shader-on .bring { background-color: #00000000; }
.buff { position: relative; width: 36dp; height: 36dp; border-radius: 6dp; overflow: hidden; background-color: #000000; }
.buff img, .buff .bspr { position: absolute; left: 0; top: 0; width: 36dp; height: 36dp; }
.bfill { position: absolute; left: 0; bottom: 0; width: 36dp; height: 0%; background-color: #000000a0; transition: height 0.4s linear-in-out; }
.bt { font-size: 9.5dp; color: #c9d6f0; }
.bcol.expiring .bt { color: #ff6b6b; font-weight: bold; }
.page.on .bcol.expiring .buff { animation: 0.4s sine-in-out infinite alternate lowhp; }
.tname { font-weight: bold; }
.tbar { height: 16dp; border-radius: 8dp; background-color: #00000060; overflow: hidden; border: 1dp #ffffff14; }
.tbar.notarget { opacity: 0.4; }
.tfill { height: 16dp; width: 100%; transition: width 0.3s cubic-out; }
.con-grey { decorator: horizontal-gradient(#4a4a4a #9a9a9a); }
.shader-on .con-grey { decorator: linear-gradient(to right, #4a4a4a, #9a9a9a); }
.con-green { decorator: horizontal-gradient(#0d5a1e #3ddc6a); }
.shader-on .con-green { decorator: linear-gradient(to right, #0d5a1e, #3ddc6a); }
.con-lightblue { decorator: horizontal-gradient(#1f6f8a #7fe0ff); }
.shader-on .con-lightblue { decorator: linear-gradient(to right, #1f6f8a, #7fe0ff); }
.con-blue { decorator: horizontal-gradient(#12357a #4c8dff); }
.shader-on .con-blue { decorator: linear-gradient(to right, #12357a, #4c8dff); }
.con-white { decorator: horizontal-gradient(#9aa4b8 #f4f7ff); }
.shader-on .con-white { decorator: linear-gradient(to right, #8790a6, #e9eefa 70%, #ffffff); }
.con-yellow { decorator: horizontal-gradient(#8a6a00 #ffe040); }
.shader-on .con-yellow { decorator: linear-gradient(to right, #8a6a00, #ffe040); }
.con-red { decorator: horizontal-gradient(#7a0000 #ff3b3b); }
.shader-on .con-red { decorator: linear-gradient(to right, #7a0000, #ff3b3b); }
.xbar { position: relative; height: 14dp; margin: 6dp 0; border-radius: 7dp; background-color: #00000060; overflow: hidden; border: 1dp #ffffff14; }
.xfill { position: absolute; left: 0; top: 0; height: 100%; width: 0%; transition: width 0.5s cubic-out;
	decorator: horizontal-gradient(#6a2fbf #c77dff); }
.shader-on .xfill { decorator: linear-gradient(to right, #6a2fbf, #c77dff); }
.xticks { display: none; }
.shader-on .xticks { display: block; }
.xticks { position: absolute; left: 0; top: 0; width: 100%; height: 100%;
	decorator: repeating-linear-gradient(to right, #00000000 0%, #00000000 9.6%, #00000080 9.6%, #00000080 10%); }

/* ======================= Combat HUD ======================= */
.hudtop { display: flex; flex-direction: row; align-items: center; gap: 10dp; }
.spacer { flex: 1; }
.simbtn.on { background-color: #c4141c; color: #ffffff; border-color: #ff6b6b; }
.hud { position: relative; height: 520dp; border-radius: 14dp; overflow: hidden; background-color: #070a12;
	border: 1dp #ffffff14; decorator: vertical-gradient(#0b1020 #05070c); }
.shader-on .hud { decorator: radial-gradient(ellipse at 50% 0%, #1a2550, #070a12 70%); }
.hudbg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none; }
.shader-on .hudbg { display: block; }
.orb { position: absolute; width: 360dp; height: 360dp; }
.o1 { left: -80dp; top: 120dp; decorator: radial-gradient(circle, #3d6fe055, #3d6fe000 70%); }
.o2 { right: -100dp; top: -60dp; decorator: radial-gradient(circle, #c4141c44, #c4141c00 70%); }
.o3 { left: 200dp; top: 300dp; decorator: radial-gradient(circle, #9b6bff33, #9b6bff00 70%); }
.page.on .o1 { animation: 9s sine-in-out infinite alternate orb1; }
.page.on .o2 { animation: 11s sine-in-out infinite alternate orb2; }
.page.on .o3 { animation: 7s sine-in-out infinite alternate orb3; }
@keyframes orb1 { from { transform: translate(0dp, 0dp); } to { transform: translate(220dp, -60dp); } }
@keyframes orb2 { from { transform: translate(0dp, 0dp); } to { transform: translate(-180dp, 120dp); } }
@keyframes orb3 { from { transform: translate(0dp, 0dp) scale(1); } to { transform: translate(140dp, -80dp) scale(1.3); } }
.gridlines { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 0.35;
	decorator: repeating-linear-gradient(0deg, #ffffff08 0dp, #ffffff08 1dp, #00000000 1dp, #00000000 28dp); }

/* shake + flash on big hits (A/B keyframe twins so a class swap restarts them) */
.hudin { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hudin.shA { animation: 0.32s linear-in-out 1 shakeA; }
.hudin.shB { animation: 0.32s linear-in-out 1 shakeB; }
@keyframes shakeA { 0% { transform: translate(0dp, 0dp); } 20% { transform: translate(-7dp, 3dp); } 40% { transform: translate(6dp, -4dp); }
	60% { transform: translate(-4dp, 2dp); } 80% { transform: translate(3dp, -1dp); } 100% { transform: translate(0dp, 0dp); } }
@keyframes shakeB { 0% { transform: translate(0dp, 0dp); } 20% { transform: translate(7dp, -3dp); } 40% { transform: translate(-6dp, 4dp); }
	60% { transform: translate(4dp, -2dp); } 80% { transform: translate(-3dp, 1dp); } 100% { transform: translate(0dp, 0dp); } }
.flash { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #ff2a2a; opacity: 0; pointer-events: none; }
.flash.fA { animation: 0.35s cubic-out 1 flashA; }
.flash.fB { animation: 0.35s cubic-out 1 flashB; }
@keyframes flashA { from { opacity: 0.38; } to { opacity: 0; } }
@keyframes flashB { from { opacity: 0.38; } to { opacity: 0; } }
.vig { position: absolute; left: 0; top: 0; right: 0; bottom: 0; opacity: 0; pointer-events: none; display: none; }
.shader-on .vig { display: block; decorator: radial-gradient(ellipse, #00000000 45%, #ff141466 80%, #ff1414cc 100%); }
.vig.low { animation: 0.85s sine-in-out infinite heartbeat; }
@keyframes heartbeat { 0% { opacity: 0.25; } 14% { opacity: 1; } 28% { opacity: 0.45; } 42% { opacity: 0.9; } 100% { opacity: 0.25; } }

/* frames */
.frame { position: absolute; top: 16dp; width: 47%; height: 124dp; border-radius: 14dp; padding: 12dp; box-sizing: border-box;
	background-color: #0e1424e6; border: 1dp #ffffff22; display: flex; flex-direction: row; gap: 12dp; }
.cap-backdrop .frame { background-color: #ffffff12; backdrop-filter: blur(5dp); }
#pf { left: 16dp; }
#tf { right: 16dp; }
.portrait { position: relative; flex: 0 0 64dp; height: 64dp; border-radius: 32dp; border: 2dp #ffcf45; overflow: hidden;
	background-color: #000000; }
.pimg { position: absolute; left: 6dp; top: 6dp; width: 48dp; height: 48dp; }
.plvl { position: absolute; left: 50dp; top: 66dp; width: 24dp; height: 18dp; border-radius: 9dp; background-color: #ffcf45;
	color: #1a1208; font-size: 11dp; font-weight: bold; text-align: center; line-height: 18dp; }
.fbody { flex: 1; display: flex; flex-direction: column; gap: 5dp; min-width: 0; }
.fname { font-size: 15dp; font-weight: bold; color: #ffffff; font-effect: shadow(1dp 1dp #000000aa); white-space: nowrap; }

/* vitals with damage trail, heal glow and absorb stripes */
.vb { position: relative; height: 16dp; border-radius: 8dp; background-color: #00000099; overflow: hidden; border: 1dp #ffffff14; }
.vb.big { height: 20dp; border-radius: 10dp; }
.vb.thin { height: 10dp; border-radius: 5dp; }
.trail { position: absolute; left: 0; top: 0; bottom: 0; width: 100%; background-color: #fff2c8;
	transition: width 0.55s 0.4s cubic-out; }
.fill { position: absolute; left: 0; top: 0; bottom: 0; width: 100%; transition: width 0.18s cubic-out; }
.hp .fill { decorator: horizontal-gradient(#8a0f14 #ff4d5a); }
.mn .fill { decorator: horizontal-gradient(#1747b8 #59a8ff); }
.en .fill { decorator: horizontal-gradient(#8a6410 #ffd45a); }
.thp .fill { decorator: horizontal-gradient(#7a0000 #ff5a3b); }
.shader-on .hp .fill { decorator: linear-gradient(to right, #6e0a10, #e0303e 60%, #ff7a82); }
.shader-on .mn .fill { decorator: linear-gradient(to right, #10357f, #3d84ff 60%, #8cc6ff); }
.shader-on .en .fill { decorator: linear-gradient(to right, #6b4c08, #e0a826 60%, #ffe39a); }
.shader-on .thp .fill { decorator: linear-gradient(to right, #5a0000, #e03a1e 60%, #ff9a6b); }
.mn .trail { background-color: #cfe4ff; }
.gloss { position: absolute; left: 0; right: 0; top: 0; height: 45%; background-color: #ffffff22; }
.vtxt { position: absolute; left: 8dp; right: 8dp; top: 0; display: flex; flex-direction: row; font-size: 10.5dp;
	font-weight: bold; color: #ffffff; font-effect: outline(1dp #000000cc); line-height: 16dp; }
.big .vtxt { line-height: 20dp; font-size: 11.5dp; }
.thin .vtxt { display: none; }
.vtxt .r { flex: 1; text-align: right; }
.shield { position: absolute; top: 0; bottom: 0; left: 100%; width: 0%; background-color: #9ec4ff66;
	transition: left width 0.25s cubic-out; }
.shader-on .shield { background-color: #00000000;
	decorator: repeating-linear-gradient(135deg, #e8f2ffcc 0dp, #e8f2ffcc 3dp, #9ec4ff33 3dp, #9ec4ff33 7dp); }
.healfx { position: absolute; left: 0; top: 0; bottom: 0; right: 0; opacity: 0; background-color: #6dff9a; }
.healfx.hA { animation: 0.7s cubic-out 1 healA; }
.healfx.hB { animation: 0.7s cubic-out 1 healB; }
@keyframes healA { 0% { opacity: 0; } 20% { opacity: 0.75; } 100% { opacity: 0; } }
@keyframes healB { 0% { opacity: 0; } 20% { opacity: 0.75; } 100% { opacity: 0; } }
.vb.nores { opacity: 0.35; }
.fill.low { animation: 0.5s sine-in-out infinite alternate lowpulse; }
@keyframes lowpulse { from { opacity: 0.6; } to { opacity: 1; } }

/* target frame */
.tring { position: relative; flex: 0 0 64dp; height: 64dp; border-radius: 32dp; border: 3dp #ffffff; background-color: #000000; }
.tring-in { position: absolute; left: 0; right: 0; top: 18dp; text-align: center; font-size: 18dp; font-weight: bold; color: #ffffff; }
.tring-spin { position: absolute; left: -3dp; top: -3dp; width: 64dp; height: 64dp; border-radius: 32dp; display: none; }
.shader-on .tring-spin { display: block; decorator: conic-gradient(#ffffff00, #ffffff00 60%, #ffffffaa); }
.page.on .tring-spin { animation: 2.2s linear-in-out infinite spin; }
.con-grey { border-color: #9a9a9a; } .con-green { border-color: #35d35a; } .con-lightblue { border-color: #5fd4ff; }
.con-blue { border-color: #3b6cff; } .con-white { border-color: #f4f7ff; } .con-yellow { border-color: #ffd23f; } .con-red { border-color: #ff3b3b; }
.cap-boxshadow .con-grey { box-shadow: #9a9a9a88 0dp 0dp 10dp 1dp; } .cap-boxshadow .con-green { box-shadow: #35d35a99 0dp 0dp 12dp 2dp; }
.cap-boxshadow .con-lightblue { box-shadow: #5fd4ff99 0dp 0dp 12dp 2dp; } .cap-boxshadow .con-blue { box-shadow: #3b6cffaa 0dp 0dp 12dp 2dp; }
.cap-boxshadow .con-white { box-shadow: #f4f7ff88 0dp 0dp 12dp 2dp; } .cap-boxshadow .con-yellow { box-shadow: #ffd23faa 0dp 0dp 12dp 2dp; }
.cap-boxshadow .con-red { box-shadow: #ff3b3bbb 0dp 0dp 14dp 3dp; }
.tf-none { opacity: 0.35; }
.tcast { position: relative; height: 14dp; border-radius: 7dp; background-color: #00000099; overflow: hidden; opacity: 0;
	transition: opacity 0.2s linear-in-out; }
.tcast.on { opacity: 1; }
.tcast-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0%; decorator: horizontal-gradient(#5a2a8a #d08cff); }
.tcast-n { position: absolute; left: 8dp; top: 0; font-size: 9.5dp; line-height: 14dp; font-weight: bold; color: #ffffff;
	font-effect: outline(1dp #000000); }
.tcast.intr .tcast-fill { decorator: horizontal-gradient(#5a0000 #ff3b3b); }

/* player cast bar */
.cbwrap { position: absolute; left: 50%; top: 318dp; width: 360dp; margin-left: -180dp; }
.cb { position: relative; height: 24dp; border-radius: 12dp; background-color: #000000b0; border: 1dp #ffcf4555; }
.cb.idle { opacity: 0; }
.cbclip { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 12dp; overflow: hidden; }
.cbfill { position: absolute; left: 0; top: 0; bottom: 0; width: 0%; decorator: horizontal-gradient(#8a5a00 #ffcf45); }
.shader-on .cbfill { decorator: linear-gradient(to right, #6b3c00, #ffb82e 75%, #fff2b0); }
.spark { position: absolute; top: -8dp; width: 24dp; height: 40dp; margin-left: -12dp; left: 0%; display: none; }
.shader-on .spark { display: block; decorator: radial-gradient(circle, #ffffff 0%, #fff2b0 20%, #ffcf4500 65%); }
.cap-filters .spark { filter: blur(1.5dp); }
.cbname { position: absolute; left: 12dp; top: 0; font-size: 12dp; line-height: 24dp; font-weight: bold; color: #ffffff;
	font-effect: outline(1dp #000000cc); }
.cbtime { position: absolute; right: 12dp; top: 0; font-size: 11dp; line-height: 24dp; color: #fff2c8; font-effect: outline(1dp #000000cc); }
.cb.okA { animation: 0.45s cubic-out 1 okA; }
.cb.okB { animation: 0.45s cubic-out 1 okB; }
@keyframes okA { 0% { background-color: #fff2b0; transform: scale(1.06); opacity: 1; } 100% { background-color: #000000b0; transform: scale(1); opacity: 0; } }
@keyframes okB { 0% { background-color: #fff2b0; transform: scale(1.06); opacity: 1; } 100% { background-color: #000000b0; transform: scale(1); opacity: 0; } }
.cb.inA { animation: 0.5s linear-in-out 1 inA; }
.cb.inB { animation: 0.5s linear-in-out 1 inB; }
@keyframes inA { 0% { transform: translateX(0dp); background-color: #c4141c; } 25% { transform: translateX(-8dp); } 50% { transform: translateX(7dp); }
	75% { transform: translateX(-4dp); } 100% { transform: translateX(0dp); background-color: #c4141c00; opacity: 0; } }
@keyframes inB { 0% { transform: translateX(0dp); background-color: #c4141c; } 25% { transform: translateX(8dp); } 50% { transform: translateX(-7dp); }
	75% { transform: translateX(4dp); } 100% { transform: translateX(0dp); background-color: #c4141c00; opacity: 0; } }

/* floating combat text: pooled; kind + A/B animation class set in one class-attribute write */
.fct { position: absolute; width: 160dp; margin-left: -80dp; text-align: center; font-size: 20dp; font-weight: bold;
	color: #ffffff; opacity: 0; pointer-events: none; font-effect: outline(2dp #000000cc); }
.fct.out { color: #ffffff; }
.fct.inc { color: #ff6b6b; }
.fct.heal { color: #6dff9a; font-effect: glow(1dp 5dp #2fcf5a), outline(1dp #000000cc); }
.fct.miss { color: #a7aebc; font-size: 15dp; }
.fct.crit { color: #ffad33; font-size: 30dp; font-effect: glow(2dp 8dp #ff6a00), outline(2dp #3a1400); }
.cap-filters .fct.crit { filter: drop-shadow(#ff6a00aa 0dp 0dp 6dp); }
.fct.a { animation: 1.1s cubic-out 1 fctA; }
.fct.b { animation: 1.1s cubic-out 1 fctB; }
.fct.crit.a { animation: 1.3s cubic-out 1 critA; }
.fct.crit.b { animation: 1.3s cubic-out 1 critB; }
@keyframes fctA { 0% { opacity: 0; transform: translateY(0dp) scale(0.4); } 12% { opacity: 1; transform: translateY(-6dp) scale(1.25); }
	28% { transform: translateY(-12dp) scale(1); opacity: 1; } 100% { opacity: 0; transform: translateY(-64dp) scale(0.9); } }
@keyframes fctB { 0% { opacity: 0; transform: translateY(0dp) scale(0.4); } 12% { opacity: 1; transform: translateY(-6dp) scale(1.25); }
	28% { transform: translateY(-12dp) scale(1); opacity: 1; } 100% { opacity: 0; transform: translateY(-64dp) scale(0.9); } }
@keyframes critA { 0% { opacity: 0; transform: translateY(0dp) scale(0.3) rotate(-8deg); } 14% { opacity: 1; transform: translateY(-4dp) scale(1.6) rotate(4deg); }
	30% { transform: translateY(-10dp) scale(1.1) rotate(0deg); opacity: 1; } 100% { opacity: 0; transform: translateY(-80dp) scale(1); } }
@keyframes critB { 0% { opacity: 0; transform: translateY(0dp) scale(0.3) rotate(8deg); } 14% { opacity: 1; transform: translateY(-4dp) scale(1.6) rotate(-4deg); }
	30% { transform: translateY(-10dp) scale(1.1) rotate(0deg); opacity: 1; } 100% { opacity: 0; transform: translateY(-80dp) scale(1); } }

/* buffs */
.buffbar { position: absolute; left: 16dp; top: 160dp; display: flex; flex-direction: row; gap: 8dp; }
.bslot { position: relative; width: 40dp; height: 40dp; border-radius: 8dp; background-color: #000000; border: 1dp #ffffff30; }
.bslot.debuff { border-color: #ff3b3b; }
.bslot .bi { position: absolute; left: 2dp; top: 2dp; width: 34dp; height: 34dp; border-radius: 6dp; }
.bclip { position: absolute; left: 2dp; top: 2dp; width: 34dp; height: 34dp; border-radius: 6dp; overflow: hidden; }
.bsw { position: absolute; left: 0; bottom: 0; width: 34dp; height: 0%; background-color: #000000a0; }
.shader-on .bsw { height: 34dp; background-color: #00000000; }
.bst { position: absolute; right: 1dp; bottom: -1dp; font-size: 11dp; font-weight: bold; color: #ffffff; font-effect: outline(1dp #000000); }
.btm { position: absolute; left: 0; right: 0; top: 42dp; text-align: center; font-size: 9.5dp; color: #c9d6f0; }
.bslot.new { animation: 0.9s cubic-out 1 bnew; }
@keyframes bnew { 0% { transform: scale(1.5); border-color: #ffffff; background-color: #ffcf45; } 100% { transform: scale(1); border-color: #ffffff30; background-color: #000000; } }
.bslot.exp { animation: 0.35s linear-in-out infinite alternate bexp; }
@keyframes bexp { from { opacity: 1; } to { opacity: 0.25; } }
.bslot.exp .btm { color: #ff6b6b; font-weight: bold; }

/* DPS meter */
.dps { position: absolute; right: 16dp; top: 156dp; width: 230dp; height: 96dp; border-radius: 12dp; padding: 10dp 12dp;
	box-sizing: border-box; background-color: #0e1424cc; border: 1dp #ffffff1a; }
.dpsn { font-size: 26dp; font-weight: bold; color: #ffffff; font-effect: glow(1dp 6dp #4c8dff88); }
.dpsn.up { color: #ffcf45; }
.dpsu { font-size: 11dp; color: #8d97ad; }
.spark-row { position: absolute; left: 12dp; right: 12dp; bottom: 10dp; height: 30dp; display: flex; flex-direction: row;
	align-items: flex-end; gap: 2dp; }
.sp { flex: 1; height: 10%; border-radius: 2dp 2dp 0 0; background-color: #4c8dff99; transition: height 0.4s cubic-out; }
.sp.last { background-color: #ffcf45; }
.combo { position: absolute; right: 12dp; top: 10dp; font-size: 18dp; font-weight: bold; color: #ff9a3b; opacity: 0;
	font-effect: outline(1dp #000000); }
.combo.on { opacity: 1; }
.combo.pA { animation: 0.3s back-out 1 cpopA; }
.combo.pB { animation: 0.3s back-out 1 cpopB; }
@keyframes cpopA { from { transform: scale(1.7); } to { transform: scale(1); } }
@keyframes cpopB { from { transform: scale(1.7); } to { transform: scale(1); } }

/* ability bar */
.abar { position: absolute; left: 50%; bottom: 22dp; width: 520dp; margin-left: -260dp; height: 84dp; border-radius: 16dp;
	padding: 12dp 14dp; box-sizing: border-box; background-color: #0e1424d9; border: 1dp #ffffff1f;
	display: flex; flex-direction: row; justify-content: space-between; }
.ab { position: relative; width: 52dp; height: 52dp; border-radius: 10dp; background-color: #000000; border: 2dp #3a4766;
	cursor: pointer; transition: transform border-color 0.12s cubic-out; }
.ab:hover { border-color: #9ec4ff; transform: translateY(-2dp); }
.ab.ready { border-color: #ffcf45; }
.cap-boxshadow .ab.ready { box-shadow: #ffcf4566 0dp 0dp 8dp 1dp; }
.ab .abi { position: absolute; left: 4dp; top: 4dp; width: 40dp; height: 40dp; border-radius: 6dp; }
.abclip { position: absolute; left: 0; top: 0; width: 48dp; height: 48dp; border-radius: 8dp; overflow: hidden; }
.abcd { position: absolute; left: 0; top: 0; width: 48dp; height: 0%; background-color: #000000b0; }
.shader-on .abcd { height: 48dp; background-color: #00000000; }
.abt { position: absolute; left: 0; right: 0; top: 13dp; text-align: center; font-size: 16dp; font-weight: bold; color: #ffffff;
	font-effect: outline(2dp #000000); }
.abk { position: absolute; left: 3dp; top: 1dp; font-size: 10dp; font-weight: bold; color: #ffcf45; font-effect: outline(1dp #000000); }
.shine { position: absolute; top: -10dp; left: -40dp; width: 26dp; height: 70dp; background-color: #ffffff55; opacity: 0;
	transform: skewX(-25deg); }
.shader-on .shine { background-color: #00000000; decorator: linear-gradient(to right, #ffffff00, #ffffffcc, #ffffff00); }
.shine.sA { animation: 0.7s cubic-out 1 shineA; }
.shine.sB { animation: 0.7s cubic-out 1 shineB; }
@keyframes shineA { from { opacity: 1; transform: translateX(0dp) skewX(-25deg); } to { opacity: 1; transform: translateX(120dp) skewX(-25deg); } }
@keyframes shineB { from { opacity: 1; transform: translateX(0dp) skewX(-25deg); } to { opacity: 1; transform: translateX(120dp) skewX(-25deg); } }
.ab.pA { animation: 0.22s back-out 1 pressA; }
.ab.pB { animation: 0.22s back-out 1 pressB; }
@keyframes pressA { 0% { transform: scale(0.82); } 100% { transform: scale(1); } }
@keyframes pressB { 0% { transform: scale(0.82); } 100% { transform: scale(1); } }

/* stance / xp strip under the ability bar */
.xpstrip { position: absolute; left: 50%; bottom: 10dp; width: 520dp; margin-left: -260dp; height: 6dp; border-radius: 3dp;
	background-color: #00000099; overflow: hidden; }
.xpfill { position: absolute; left: 0; top: 0; bottom: 0; width: 0%; decorator: horizontal-gradient(#5b2bd6 #c78bff);
	transition: width 0.6s cubic-out; }
.xpticks { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none; }
.shader-on .xpticks { display: block; decorator: repeating-linear-gradient(to right, #00000000 0%, #00000000 9.6%, #000000aa 9.6%, #000000aa 10%); }

/* mid-screen boss / event banner */
.banner { position: absolute; left: 0; right: 0; top: 262dp; text-align: center; font-size: 26dp; font-weight: bold; color: #ffffff;
	opacity: 0; font-effect: glow(2dp 10dp #ff3b3b), outline(2dp #2a0000); }
.banner.bA { animation: 1.8s cubic-out 1 banA; }
.banner.bB { animation: 1.8s cubic-out 1 banB; }
@keyframes banA { 0% { opacity: 0; transform: scale(2); } 15% { opacity: 1; transform: scale(1); } 75% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(0.9); } }
@keyframes banB { 0% { opacity: 0; transform: scale(2); } 15% { opacity: 1; transform: scale(1); } 75% { opacity: 1; transform: scale(1); } 100% { opacity: 0; transform: scale(0.9); } }
.fctarena { position: absolute; left: 0; top: 0; right: 0; bottom: 0; pointer-events: none; }
.bigval { font-size: 34dp; font-weight: bold; color: #ffffff; font-effect: glow(1dp 6dp #4c8dff88); }
.sg-hide { display: none; }

/* ======================= Controls ======================= */
.cgrid { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12dp; }
.ccard { flex: 1 1 200dp; display: flex; flex-direction: column; gap: 10dp; padding: 14dp; box-sizing: border-box; margin: 0; }
.ccard.wide2 { flex: 1 1 420dp; }
.crow { display: flex; flex-direction: row; align-items: center; gap: 10dp; }
.cl { flex: 1; font-size: 12.5dp; color: #c9d3e8; }
.cv { font-size: 12dp; font-weight: bold; color: #ffffff; min-width: 34dp; text-align: right; }

/* toggle switch */
.tg { position: relative; width: 44dp; height: 24dp; border-radius: 12dp; background-color: #2a3247; border: 1dp #ffffff1a;
	cursor: pointer; transition: background-color border-color 0.25s cubic-out; }
.tg .knob { position: absolute; left: 3dp; top: 3dp; width: 18dp; height: 18dp; border-radius: 9dp; background-color: #c9d0de;
	transition: left background-color 0.25s back-out; }
.tg.on .knob { left: 23dp; background-color: #ffffff; }
.tg:active .knob { width: 22dp; }
.tg.on { border-color: #ffffff40; }
.page.ctl .tg-green.on { background-color: #2fcf95; } .page.ctl .tg-gold.on { background-color: #e0a826; } .page.ctl .tg-red.on { background-color: #e0303e; }
.cap-boxshadow .page.ctl .tg-green.on { box-shadow: #2fcf9588 0dp 0dp 10dp 1dp; }
.cap-boxshadow .page.ctl .tg-gold.on { box-shadow: #ffcf4588 0dp 0dp 10dp 1dp; }
.cap-boxshadow .page.ctl .tg-red.on { box-shadow: #ff3b3b88 0dp 0dp 10dp 1dp; }

/* segmented control */
.seg { position: relative; display: flex; flex-direction: row; height: 32dp; border-radius: 16dp; background-color: #00000050;
	border: 1dp #ffffff14; padding: 3dp; box-sizing: border-box; }
.segpill { position: absolute; top: 3dp; bottom: 3dp; left: 3dp; width: 32%; border-radius: 13dp; transition: left 0.3s back-out; }
.seg.sel2 .segpill { left: 34%; } .seg.sel3 .segpill { left: 66%; }
.segopt { position: relative; flex: 1; text-align: center; line-height: 26dp; font-size: 12dp; font-weight: bold; color: #9aa6c0;
	cursor: pointer; transition: color 0.2s linear-in-out; }
.segopt.on { color: #ffffff; }

/* chips */
.chips { display: flex; flex-direction: row; flex-wrap: wrap; gap: 6dp; }
.chip { padding: 4dp 11dp; border-radius: 12dp; font-size: 11.5dp; background-color: #ffffff0c; border: 1dp #ffffff22; color: #b8c2d8;
	cursor: pointer; transition: background-color border-color color transform 0.18s cubic-out; }
.chip:hover { border-color: #ffffff55; }
.chip:active { transform: scale(0.92); }
.chip.on { color: #ffffff; }

/* sliders */
.slwrap { position: relative; height: 30dp; margin-top: 14dp; }
.slwrap input.range { margin: 4dp 0; }
input.rg-grad slidertrack { height: 6dp; margin-top: 8dp; border-radius: 3dp; decorator: horizontal-gradient(#3d6fe0 #ff4d6d); }
.shader-on input.rg-grad slidertrack { decorator: linear-gradient(to right, #2fcf95, #ffcf45 50%, #ff4d6d); }
input.rg-step slidertrack { height: 6dp; margin-top: 8dp; border-radius: 3dp; background-color: #ffffff22; }
input.rg-vol slidertrack { height: 6dp; margin-top: 8dp; border-radius: 3dp; decorator: horizontal-gradient(#ffffff20 #ffffffb0); }
input.range sliderbar:active { transform: scale(1.25); }
.bubble { position: absolute; top: -22dp; width: 36dp; margin-left: -18dp; height: 20dp; border-radius: 10dp; text-align: center;
	line-height: 20dp; font-size: 11dp; font-weight: bold; color: #ffffff; transition: left 0.08s linear-in-out; }
.ticks { position: absolute; left: 8dp; right: 8dp; top: 22dp; height: 6dp; display: flex; flex-direction: row; justify-content: space-between; }
.tk { width: 2dp; height: 6dp; background-color: #ffffff55; }
.vol { gap: 12dp; }
.vol input.range { flex: 1; }
.spk { position: relative; width: 28dp; height: 22dp; cursor: pointer; flex: 0 0 28dp; }
.spk-b { position: absolute; left: 0; top: 7dp; width: 6dp; height: 8dp; background-color: #e7eaf3; border-radius: 1dp; }
.spk-c { position: absolute; left: 5dp; top: 3dp; width: 7dp; height: 16dp; background-color: #e7eaf3; border-radius: 0 4dp 4dp 0; }
.spk-w { position: absolute; border: 2dp #00000000; border-right-color: #e7eaf3; transition: opacity 0.2s linear-in-out; }
.w1 { left: 8dp; top: 5dp; width: 8dp; height: 8dp; border-radius: 6dp; }
.w2 { left: 9dp; top: 0dp; width: 14dp; height: 18dp; border-radius: 11dp; }
.spk-w.off { opacity: 0.12; }
.spk.muted .spk-b, .spk.muted .spk-c { background-color: #ff6b6b; }

/* rotary knob + stepper */
.knobrow { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 14dp; }
.kbtn, .stb { width: 30dp; height: 30dp; border-radius: 15dp; background-color: #ffffff14; border: 1dp #ffffff2a; text-align: center;
	line-height: 28dp; font-size: 16dp; font-weight: bold; color: #ffffff; cursor: pointer; transition: transform background-color 0.12s cubic-out; }
.kbtn:hover, .stb:hover { background-color: #ffffff2a; }
.kbtn:active, .stb:active { transform: scale(0.85); }
.dial { position: relative; width: 96dp; height: 96dp; cursor: pointer; }
.dial-arc { position: absolute; left: 0; top: 0; width: 96dp; height: 96dp; border-radius: 48dp; background-color: #ffffff10; }
.dial-face { position: absolute; left: 10dp; top: 10dp; width: 76dp; height: 76dp; border-radius: 38dp; background-color: #1b2233;
	border: 1dp #ffffff22; decorator: vertical-gradient(#2a3450 #121826); }
.dial-rot { position: absolute; left: 0; top: 0; width: 76dp; height: 76dp; transition: transform 0.3s back-out; }
.dial-dot { position: absolute; left: 34dp; top: 6dp; width: 8dp; height: 8dp; border-radius: 4dp; background-color: #ffffff; }
.dial-v { position: absolute; left: 0; right: 0; top: 36dp; text-align: center; font-size: 18dp; font-weight: bold; color: #ffffff; }
.stepper { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 10dp; }
.stv { min-width: 56dp; text-align: center; font-size: 24dp; font-weight: bold; color: #ffffff; }
.stv.bA { animation: 0.25s back-out 1 bumpA; }
.stv.bB { animation: 0.25s back-out 1 bumpB; }
@keyframes bumpA { from { transform: scale(1.35); } to { transform: scale(1); } }
@keyframes bumpB { from { transform: scale(1.35); } to { transform: scale(1); } }

/* progress ring + segmented bar */
.ringrow { display: flex; flex-direction: row; align-items: center; gap: 16dp; }
.pring { position: relative; flex: 0 0 84dp; height: 84dp; }
.pring-arc { position: absolute; left: 0; top: 0; width: 84dp; height: 84dp; border-radius: 42dp; background-color: #ffffff14; }
.pring-spin { position: absolute; left: 0; top: 0; width: 84dp; height: 84dp; border-radius: 42dp; display: none; }
.shader-on .pring-spin { display: block; decorator: conic-gradient(#ffffff00, #ffffff00 75%, #ffffff55); }
.page.on .pring-spin { animation: 1.6s linear-in-out infinite spin; }
.pring-hole { position: absolute; left: 10dp; top: 10dp; width: 64dp; height: 64dp; border-radius: 32dp; background-color: #121826;
	text-align: center; line-height: 64dp; font-size: 16dp; font-weight: bold; color: #ffffff; }
.segbar-wrap { flex: 1; display: flex; flex-direction: column; gap: 10dp; }
.segbar { display: flex; flex-direction: row; gap: 3dp; height: 14dp; }
.sb { flex: 1; border-radius: 3dp; background-color: #ffffff14; transition: background-color 0.3s cubic-out; }
.charge { position: relative; height: 8dp; border-radius: 4dp; background-color: #00000060; overflow: hidden; }
.charge-f { position: absolute; left: 0; top: 0; bottom: 0; width: 40%; decorator: horizontal-gradient(#2fcf9500 #2fcf95); }
.page.on .charge-f { animation: 1.6s cubic-in-out infinite charge; }
@keyframes charge { from { transform: translateX(-140dp); } to { transform: translateX(300dp); } }

/* checkboxes */
.ck { display: flex; flex-direction: row; align-items: center; gap: 10dp; cursor: pointer; font-size: 12.5dp; color: #d6deee; }
.ckbox { position: relative; width: 20dp; height: 20dp; border-radius: 5dp; border: 2dp #ffffff40; box-sizing: border-box;
	transition: background-color border-color 0.2s cubic-out; }
.ckmark { position: absolute; left: 5dp; top: 1dp; width: 5dp; height: 10dp; border: 2dp #00000000; border-right-color: #ffffff;
	border-bottom-color: #ffffff; transform: rotate(45deg) scale(0); transition: transform 0.25s back-out; }
.ck.on .ckmark { transform: rotate(45deg) scale(1); }
.ck:active .ckbox { transform: scale(0.85); }

/* radio cards */
.rcards { display: flex; flex-direction: row; gap: 10dp; }
.rcard { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4dp; padding: 12dp 8dp; border-radius: 12dp;
	background-color: #ffffff08; border: 2dp #ffffff14; cursor: pointer; transition: border-color background-color transform 0.2s cubic-out; }
.rcard:hover { transform: translateY(-2dp); background-color: #ffffff10; }
.rcard .spr { width: 36dp; height: 36dp; }
.rct { font-size: 13dp; font-weight: bold; color: #ffffff; }
.rcs { font-size: 11dp; color: #8d97ad; }

/* swatches + keybind */
.swatches { display: flex; flex-direction: row; gap: 10dp; }
.sw { width: 26dp; height: 26dp; border-radius: 13dp; border: 3dp #00000000; cursor: pointer; transition: transform border-color 0.2s back-out; }
.sw:hover { transform: scale(1.15); }
.sw.on { border-color: #ffffff; transform: scale(1.1); }
.sw-blue { background-color: #4c8dff; } .sw-gold { background-color: #ffcf45; } .sw-green { background-color: #2fcf95; }
.sw-pink { background-color: #ff4dd2; } .sw-red { background-color: #ff5a5a; }
.kbf { height: 32dp; border-radius: 8dp; border: 1dp #ffffff2a; background-color: #00000050; text-align: center; line-height: 30dp;
	font-size: 13dp; font-weight: bold; color: #ffffff; cursor: pointer; transition: border-color background-color 0.2s linear-in-out; }
.kbf.listen { color: #ffcf45; animation: 0.7s sine-in-out infinite alternate kblisten; }
@keyframes kblisten { from { background-color: #ffcf4510; } to { background-color: #ffcf4530; } }

/* fields */
.field { position: relative; }
input.tin { height: 32dp; border-radius: 8dp; padding: 7dp 30dp 7dp 10dp; border: 1dp #ffffff22; background-color: #00000050;
	transition: border-color 0.2s linear-in-out; }
input.tin.search { padding-left: 30dp; }
.clr { position: absolute; right: 7dp; top: 7dp; width: 18dp; height: 18dp; border-radius: 9dp; background-color: #ffffff22; text-align: center;
	line-height: 16dp; font-size: 11dp; font-weight: bold; color: #ffffff; cursor: pointer; }
.clr:hover { background-color: #ff5a5a; }
.mag { position: absolute; left: 9dp; top: 8dp; width: 16dp; height: 16dp; z-index: 2; }
.mag-c { position: absolute; left: 0; top: 0; width: 11dp; height: 11dp; border-radius: 6dp; border: 2dp #9aa6c0; box-sizing: border-box; }
.mag-h { position: absolute; left: 9dp; top: 10dp; width: 6dp; height: 2dp; background-color: #9aa6c0; transform: rotate(45deg); }

/* buttons */
.btnrow { display: flex; flex-direction: row; flex-wrap: wrap; gap: 10dp; align-items: center; }
.cb2 { position: relative; height: 34dp; padding: 0 16dp; border-radius: 9dp; line-height: 34dp; font-size: 12.5dp; font-weight: bold;
	color: #ffffff; cursor: pointer; overflow: hidden; display: flex; flex-direction: row; align-items: center; gap: 8dp;
	transition: transform background-color border-color 0.12s cubic-out; border: 1dp #00000000; }
.cb2:hover { transform: translateY(-1dp); }
.cb2:active { transform: scale(0.94); }
.cb2.ghost { background-color: #00000000; border-color: #ffffff40; color: #d6deee; }
.cb2.ghost:hover { background-color: #ffffff12; }
.cb2.danger { background-color: #c4141c; }
.cb2.danger:hover { background-color: #e0303e; }
.cap-boxshadow .cb2.danger:hover { box-shadow: #ff3b3b77 0dp 0dp 10dp 1dp; }
.cb2.icon { width: 34dp; padding: 0; justify-content: center; background-color: #ffffff14; border-color: #ffffff22; }
.cb2.icon .spr { width: 22dp; height: 22dp; }
.ldspin { width: 14dp; height: 14dp; border-radius: 7dp; border: 2dp #ffffff40; border-top-color: #ffffff; display: none; box-sizing: border-box; }
.cb2.loading .ldspin { display: block; animation: 0.7s linear-in-out infinite spin; }
.cb2.loading { opacity: 0.8; }
.cb2.shiny { background-color: #8a5a00; decorator: horizontal-gradient(#8a5a00 #e0a826); }
.shn { position: absolute; top: -6dp; left: -40dp; width: 22dp; height: 48dp; background-color: #ffffff60; transform: skewX(-25deg);
	transition: left 0.5s cubic-out; }
.cb2.shiny:hover .shn { left: 110dp; }

/* accent colour (swatch picker swaps .acc-* on #page9) */
.acc-blue .tg.on, .acc-blue .segpill, .acc-blue .bubble, .acc-blue .chip.on, .acc-blue .ck.on .ckbox, .acc-blue .cb2.primary, .acc-blue .sb.on, .acc-blue input.rg-step sliderbar, .acc-blue input.rg-vol sliderbar { background-color: #4c8dff; }
.acc-blue .chip.on, .acc-blue .ck.on .ckbox, .acc-blue .rcard.on, .acc-blue input.tin:focus, .acc-blue .kbf.listen, .acc-blue .dial-face { border-color: #4c8dff; }
.cap-boxshadow .acc-blue .tg.on, .cap-boxshadow .acc-blue .rcard.on, .cap-boxshadow .acc-blue input.tin:focus { box-shadow: #4c8dff88 0dp 0dp 10dp 1dp; }
.acc-gold .tg.on, .acc-gold .segpill, .acc-gold .bubble, .acc-gold .chip.on, .acc-gold .ck.on .ckbox, .acc-gold .cb2.primary, .acc-gold .sb.on, .acc-gold input.rg-step sliderbar, .acc-gold input.rg-vol sliderbar { background-color: #e0a826; }
.acc-gold .chip.on, .acc-gold .ck.on .ckbox, .acc-gold .rcard.on, .acc-gold input.tin:focus, .acc-gold .kbf.listen, .acc-gold .dial-face { border-color: #e0a826; }
.cap-boxshadow .acc-gold .tg.on, .cap-boxshadow .acc-gold .rcard.on, .cap-boxshadow .acc-gold input.tin:focus { box-shadow: #e0a82688 0dp 0dp 10dp 1dp; }
.acc-green .tg.on, .acc-green .segpill, .acc-green .bubble, .acc-green .chip.on, .acc-green .ck.on .ckbox, .acc-green .cb2.primary, .acc-green .sb.on, .acc-green input.rg-step sliderbar, .acc-green input.rg-vol sliderbar { background-color: #2fcf95; }
.acc-green .chip.on, .acc-green .ck.on .ckbox, .acc-green .rcard.on, .acc-green input.tin:focus, .acc-green .kbf.listen, .acc-green .dial-face { border-color: #2fcf95; }
.cap-boxshadow .acc-green .tg.on, .cap-boxshadow .acc-green .rcard.on, .cap-boxshadow .acc-green input.tin:focus { box-shadow: #2fcf9588 0dp 0dp 10dp 1dp; }
.acc-pink .tg.on, .acc-pink .segpill, .acc-pink .bubble, .acc-pink .chip.on, .acc-pink .ck.on .ckbox, .acc-pink .cb2.primary, .acc-pink .sb.on, .acc-pink input.rg-step sliderbar, .acc-pink input.rg-vol sliderbar { background-color: #e040b8; }
.acc-pink .chip.on, .acc-pink .ck.on .ckbox, .acc-pink .rcard.on, .acc-pink input.tin:focus, .acc-pink .kbf.listen, .acc-pink .dial-face { border-color: #e040b8; }
.cap-boxshadow .acc-pink .tg.on, .cap-boxshadow .acc-pink .rcard.on, .cap-boxshadow .acc-pink input.tin:focus { box-shadow: #e040b888 0dp 0dp 10dp 1dp; }
.acc-red .tg.on, .acc-red .segpill, .acc-red .bubble, .acc-red .chip.on, .acc-red .ck.on .ckbox, .acc-red .cb2.primary, .acc-red .sb.on, .acc-red input.rg-step sliderbar, .acc-red input.rg-vol sliderbar { background-color: #e0303e; }
.acc-red .chip.on, .acc-red .ck.on .ckbox, .acc-red .rcard.on, .acc-red input.tin:focus, .acc-red .kbf.listen, .acc-red .dial-face { border-color: #e0303e; }
.cap-boxshadow .acc-red .tg.on, .cap-boxshadow .acc-red .rcard.on, .cap-boxshadow .acc-red input.tin:focus { box-shadow: #e0303e88 0dp 0dp 10dp 1dp; }

/* ======================= Tabs and lists ======================= */
.tabs { position: relative; display: flex; flex-direction: row; height: 38dp; padding: 4dp; box-sizing: border-box; border-radius: 12dp;
	background-color: #00000050; border: 1dp #ffffff12; margin-bottom: 12dp; }
.tabpill { position: absolute; top: 4dp; bottom: 4dp; left: 4dp; width: 32.5%; border-radius: 9dp; background-color: #3d6fe0;
	transition: left 0.35s back-out; }
.cap-boxshadow .tabpill { box-shadow: #4c8dff66 0dp 0dp 10dp 0dp; }
.tabs.t2 .tabpill { left: 33.8%; } .tabs.t3 .tabpill { left: 67%; }
.tabb { position: relative; flex: 1; text-align: center; line-height: 30dp; font-size: 13dp; font-weight: bold; color: #8d97ad; cursor: pointer;
	transition: color 0.2s linear-in-out; }
.tabb:hover { color: #d6deee; }
.tabb.on { color: #ffffff; }
.tpanel { display: none; }
.tpanel.on { display: block; animation: 0.3s cubic-out 1 panelin; }
@keyframes panelin { from { opacity: 0; transform: translateY(8dp); } to { opacity: 1; transform: translateY(0dp); } }

.bag { display: flex; flex-direction: row; flex-wrap: wrap; gap: 10dp; padding: 14dp; border-radius: 14dp; background-color: #0b0f18;
	border: 1dp #ffffff10; }
.bslot2 { position: relative; width: 62dp; height: 62dp; border-radius: 10dp; background-color: #151b28; border: 2dp #2c3446; cursor: pointer;
	transition: transform border-color background-color 0.18s back-out; }
.bslot2:hover { transform: translateY(-4dp) scale(1.06); background-color: #1d2536; }
.bslot2.sel { transform: scale(1.08); background-color: #26304a; }
.bslot2 .spr { position: absolute; left: 11dp; top: 11dp; width: 36dp; height: 36dp; }
.bslot2 img { position: absolute; left: 11dp; top: 11dp; width: 36dp; height: 36dp; }
.bslot2 .bq { position: absolute; right: 4dp; bottom: 1dp; font-size: 11dp; font-weight: bold; color: #ffffff; font-effect: outline(1dp #000000); }
.bslot2.empty { background-color: #0f131c; border-color: #1e2433; cursor: default; }
.bslot2.empty:hover { transform: none; }
.r-common { border-color: #6b7488; } .r-uncommon { border-color: #2fcf5a; } .r-rare { border-color: #3d84ff; }
.r-epic { border-color: #b05cff; } .r-legendary { border-color: #ff9a1f; }
.cap-boxshadow .r-uncommon { box-shadow: #2fcf5a55 0dp 0dp 8dp 0dp; }
.cap-boxshadow .r-rare { box-shadow: #3d84ff66 0dp 0dp 9dp 1dp; }
.cap-boxshadow .r-epic { box-shadow: #b05cff77 0dp 0dp 10dp 1dp; }
.cap-boxshadow .r-legendary { box-shadow: #ff9a1f88 0dp 0dp 12dp 2dp; }
.bslot2.sel { border-color: #ffffff; }
.c-common { color: #c9d0de; } .c-uncommon { color: #4ee07a; } .c-rare { color: #5f9cff; } .c-epic { color: #c27cff; }
.c-legendary { color: #ffad33; } .c-spell { color: #9ec4ff; }

.shead { display: flex; flex-direction: row; padding: 0 12dp; height: 30dp; border-radius: 10dp 10dp 0 0; background-color: #1a2132; }
.shc { line-height: 30dp; font-size: 11.5dp; font-weight: bold; color: #8d97ad; cursor: pointer; transition: color 0.15s linear-in-out; }
.shc:hover { color: #ffffff; }
.shc.sorted { color: #ffcf45; }
.sname { flex: 1; } .slvl { width: 70dp; text-align: right; } .smana { width: 80dp; text-align: right; }
.arr { display: inline-block; width: 12dp; text-align: center; }
.splist { max-height: 380dp; overflow-y: auto; border-radius: 0 0 10dp 10dp; background-color: #0b0f18; }
.sprow { display: flex; flex-direction: row; align-items: center; height: 40dp; padding: 0 12dp; gap: 10dp;
	transition: background-color 0.15s linear-in-out; }
.sprow.alt { background-color: #ffffff06; }
.sprow:hover { background-color: #3d6fe033; }
.sprow .spr { width: 28dp; height: 28dp; }
.pip { width: 8dp; height: 8dp; border-radius: 4dp; }
.sc-evocation { background-color: #ff6a3d; } .sc-alteration { background-color: #4ee07a; } .sc-abjuration { background-color: #5f9cff; }
.sc-conjuration { background-color: #c27cff; } .sc-divination { background-color: #ffd23f; }
.spn { flex: 1; font-size: 13dp; color: #e7eaf3; }
.spl { width: 70dp; text-align: right; font-size: 12.5dp; color: #c9d0de; }
.spm { width: 80dp; text-align: right; font-size: 12.5dp; font-weight: bold; color: #59a8ff; }

.quest { margin-bottom: 8dp; border-radius: 12dp; background-color: #121826; border: 1dp #ffffff12; overflow: hidden;
	transition: border-color 0.2s linear-in-out; }
.quest.open { border-color: #4c8dff66; }
.qhead { display: flex; flex-direction: row; align-items: center; gap: 10dp; height: 42dp; padding: 0 14dp; cursor: pointer; }
.qhead:hover { background-color: #ffffff08; }
.qchev { width: 8dp; height: 8dp; border: 2dp #00000000; border-right-color: #9aa6c0; border-bottom-color: #9aa6c0;
	transform: rotate(-45deg); transition: transform 0.25s back-out; }
.quest.open .qchev { transform: rotate(45deg); }
.qt { flex: 1; font-size: 13.5dp; font-weight: bold; color: #ffffff; }
.qpct { font-size: 12dp; font-weight: bold; color: #ffcf45; }
.qbody { height: 0dp; padding: 0 16dp; opacity: 0; transition: height opacity 0.3s cubic-out; }
.quest.open .qbody { height: 108dp; opacity: 1; }
.qdesc { font-size: 12dp; color: #9aa6c0; margin: 2dp 0 10dp 0; }
.qstep { display: flex; flex-direction: row; flex-wrap: wrap; margin-bottom: 8dp; }
.qsn { flex: 1; font-size: 12dp; color: #d6deee; }
.qsv { font-size: 11.5dp; color: #ffffff; font-weight: bold; }
.qbar { width: 100%; height: 6dp; margin-top: 4dp; border-radius: 3dp; background-color: #00000070; overflow: hidden; }
.qfill { height: 6dp; border-radius: 3dp; decorator: horizontal-gradient(#2f9e62 #7dffb0); }

/* ======================= Tooltips ======================= */
.tipstage { display: flex; flex-direction: column; align-items: center; gap: 150dp; padding-top: 215dp; }
.tiprow { display: flex; flex-direction: row; gap: 14dp; padding: 12dp 16dp; border-radius: 14dp; background-color: #0e1424; border: 1dp #ffffff14; }
.islot { width: 54dp; height: 54dp; border-radius: 9dp; background-color: #151b28; border: 2dp #2c3446; transition: transform 0.18s back-out; }
.islot .spr { margin: 7dp; width: 36dp; height: 36dp; }
.abslot { width: 54dp; height: 54dp; border-radius: 12dp; background-color: #000000; border: 2dp #3a4766; transition: transform border-color 0.18s back-out; }
.abslot .spr { margin: 7dp; width: 36dp; height: 36dp; }
.tipwrap:hover .islot, .tipwrap:hover .abslot, .tipwrap.force .islot, .tipwrap.force .abslot { transform: translateY(-3dp); }
.tipwrap:hover .abslot, .tipwrap.force .abslot { border-color: #ffcf45; }
.ttip { position: absolute; z-index: 50; width: 240dp; padding: 12dp 14dp; border-radius: 10dp; background-color: #0a0d16f2;
	border: 1dp #ffcf4566; opacity: 0; visibility: hidden; pointer-events: none;
	transition: opacity transform 0.18s cubic-out; }
.cap-boxshadow .ttip { box-shadow: #000000aa 0dp 8dp 20dp 0dp; }
.ttip.spell { border-color: #5f9cff77; }
.t-above { left: -93dp; bottom: 66dp; transform: translateY(8dp); }
.t-below { left: -93dp; top: 66dp; transform: translateY(-8dp); }
.t-right { left: 66dp; top: -40dp; transform: translateX(-8dp); }
.tipwrap:hover .ttip, .tipwrap.force .ttip { opacity: 1; visibility: visible; transform: translate(0dp, 0dp);
	transition: opacity transform 0.2s 0.25s cubic-out; }
.tarr { position: absolute; width: 12dp; height: 12dp; background-color: #0a0d16; border: 1dp #00000000; transform: rotate(45deg); }
.t-above .tarr { left: 114dp; bottom: -7dp; border-right-color: #ffcf4566; border-bottom-color: #ffcf4566; }
.t-below .tarr { left: 114dp; top: -7dp; border-left-color: #ffcf4566; border-top-color: #ffcf4566; }
.t-right .tarr { left: -7dp; top: 58dp; border-left-color: #ffcf4566; border-bottom-color: #ffcf4566; }
.spell .tarr { border-color: #00000000; }
.spell.t-above .tarr { border-right-color: #5f9cff77; border-bottom-color: #5f9cff77; }
.spell.t-right .tarr { border-left-color: #5f9cff77; border-bottom-color: #5f9cff77; }
.tth { display: flex; flex-direction: row; gap: 10dp; align-items: center; margin-bottom: 8dp; }
.tico { width: 40dp; height: 40dp; border-radius: 8dp; border: 2dp #2c3446; background-color: #151b28; }
.tico .spr { margin: 4dp; width: 28dp; height: 28dp; }
.ttn { font-size: 14dp; font-weight: bold; }
.tts { font-size: 11dp; color: #8d97ad; }
.tstats { border-width: 1dp 0 1dp 0; border-color: #ffffff14; padding: 6dp 0; }
.tsr { display: flex; flex-direction: row; font-size: 12dp; color: #9aa6c0; line-height: 18dp; }
.tsr span { flex: 1; }
.tsv { text-align: right; color: #ffffff; font-weight: bold; }
.tsv.mana { color: #59a8ff; }
.tres { display: flex; flex-direction: row; gap: 5dp; margin-top: 7dp; }
.rp { flex: 1; height: 5dp; border-radius: 3dp; background-color: #ffffff12; overflow: hidden; }
.rpf { height: 5dp; }
.rp.fire .rpf { background-color: #ff6a3d; } .rp.cold .rpf { background-color: #7fd8ff; } .rp.magic .rpf { background-color: #c27cff; }
.rp.poison .rpf { background-color: #7ddf3b; }
.tlore { margin-top: 8dp; font-size: 11.5dp; color: #c8b78a; line-height: 1.35; }
.tprice { margin-top: 8dp; font-size: 12dp; font-weight: bold; color: #e7eaf3; display: flex; flex-direction: row; align-items: center; gap: 6dp; }
.coin { width: 10dp; height: 10dp; border-radius: 5dp; background-color: #d9dde6; border: 1dp #8d97ad; }

/* ======================= Layout themes ======================= */
.lttiles { display: flex; flex-direction: row; gap: 10dp; margin-bottom: 12dp; }
.lttile { position: relative; flex: 1; height: 74dp; border-radius: 10dp; overflow: hidden; cursor: pointer; border: 2dp #ffffff14;
	transition: transform border-color 0.2s back-out; }
.lttile:hover { transform: translateY(-3dp); }
.lttile.on { border-color: #ffffff; transform: scale(1.04); }
.tp-a, .tp-b, .tp-c { position: absolute; }
.tp-n { position: absolute; left: 0; right: 0; bottom: 5dp; text-align: center; font-size: 11dp; font-weight: bold; color: #ffffff;
	font-effect: shadow(1dp 1dp #000000); }
.tile-classic { background-color: #2a2218; decorator: vertical-gradient(#3a2e1e #1a140c); border-color: #8a6a2f; }
.tile-classic .tp-a { left: 8dp; top: 8dp; right: 8dp; height: 12dp; background-color: #8a6a2f; }
.tile-classic .tp-b { left: 8dp; top: 26dp; width: 30dp; height: 24dp; border: 2dp #c9a24a; }
.tile-classic .tp-c { left: 44dp; top: 28dp; right: 8dp; height: 6dp; background-color: #a3232a; }
.tile-glass { background-color: #1a2550; decorator: horizontal-gradient(#3d6fe0 #9b6bff); }
.tile-glass .tp-a { left: 10dp; top: 10dp; width: 50dp; height: 34dp; border-radius: 8dp; background-color: #ffffff40; border: 1dp #ffffffaa; }
.tile-glass .tp-b { right: 10dp; top: 14dp; width: 30dp; height: 30dp; border-radius: 15dp; background-color: #ffffff30; }
.tile-raid { background-color: #101318; }
.tile-raid .tp-a { left: 6dp; top: 8dp; right: 6dp; height: 4dp; background-color: #e0303e; }
.tile-raid .tp-b { left: 6dp; top: 16dp; right: 6dp; height: 4dp; background-color: #e0303e; }
.tile-raid .tp-c { left: 6dp; top: 24dp; right: 30dp; height: 4dp; background-color: #3d84ff; }
.tile-scifi { background-color: #04121a; }
.tile-scifi .tp-a { left: 8dp; top: 10dp; right: 8dp; height: 2dp; background-color: #22e6ff; }
.tile-scifi .tp-b { left: 8dp; top: 18dp; width: 40dp; height: 26dp; border: 1dp #22e6ff; }
.tile-scifi .tp-c { right: 8dp; top: 18dp; width: 14dp; height: 14dp; background-color: #22e6ff; transform: rotate(45deg); }
.tile-scifi .tp-n { font-family: Consolas; color: #22e6ff; }
.tile-tome { background-color: #e9dcc0; decorator: vertical-gradient(#f3e8cf #d6c29b); border-color: #8a6a2f; }
.tile-tome .tp-a { left: 50%; top: 8dp; width: 2dp; height: 42dp; background-color: #8a6a2f; }
.tile-tome .tp-b { left: 12dp; top: 14dp; width: 40dp; height: 3dp; background-color: #5a3d1e; }
.tile-tome .tp-c { right: 12dp; top: 14dp; width: 40dp; height: 3dp; background-color: #5a3d1e; }
.tile-tome .tp-n { color: #3a2412; font-family: Georgia; font-effect: none; }
.cap-boxshadow .lttile.on { box-shadow: #ffffff55 0dp 0dp 12dp 1dp; }

.ltstage { position: relative; height: 410dp; border-radius: 14dp; overflow: hidden; display: flex; align-items: center; justify-content: center;
	background-color: #0b0f18; transition: background-color 0.4s linear-in-out; }
.lt-orb { position: absolute; width: 260dp; height: 260dp; border-radius: 130dp; opacity: 0; }
.lo1 { left: -40dp; top: -60dp; background-color: #3d6fe0; } .lo2 { right: -60dp; bottom: -80dp; background-color: #c4141c; }
.st-classic { background-color: #15100a; decorator: vertical-gradient(#241a10 #0c0905); }
.st-glass { background-color: #0d1430; }
.st-glass .lt-orb { opacity: 0.9; }
.page.on .st-glass .lo1 { animation: 6s sine-in-out infinite alternate orb1; }
.page.on .st-glass .lo2 { animation: 7s sine-in-out infinite alternate orb2; }
.shader-on .st-glass .lt-orb { background-color: #00000000; }
.shader-on .st-glass .lo1 { decorator: radial-gradient(circle, #4c8dff, #4c8dff00 70%); }
.shader-on .st-glass .lo2 { decorator: radial-gradient(circle, #ff4dd2, #ff4dd200 70%); }
.st-raid { background-color: #07090c; }
.st-scifi { background-color: #020a10; }
.shader-on .st-scifi { decorator: repeating-linear-gradient(0deg, #22e6ff0a 0dp, #22e6ff0a 1dp, #00000000 1dp, #00000000 22dp); }
.st-tome { background-color: #3a2614; decorator: vertical-gradient(#4a3018 #24160a); }

.lt { position: relative; width: 560dp; padding: 16dp; box-sizing: border-box; display: flex; flex-direction: column; gap: 12dp; }
.lt.swA { animation: 0.45s back-out 1 ltswA; }
.lt.swB { animation: 0.45s back-out 1 ltswB; }
@keyframes ltswA { from { transform: scale(0.92) translateY(14dp); } to { transform: scale(1) translateY(0dp); } }
@keyframes ltswB { from { transform: scale(0.92) translateY(14dp); } to { transform: scale(1) translateY(0dp); } }
.lt-cut, .lt-line { display: none; }
.lt-head { display: flex; flex-direction: row; align-items: center; gap: 12dp; }
.lt-por { width: 56dp; height: 56dp; flex: 0 0 56dp; }
.lt-por .spr { margin: 10dp; width: 36dp; height: 36dp; }
.lt-id { flex: 1; }
.lt-name { font-size: 18dp; font-weight: bold; }
.lt-sub { font-size: 12dp; }
.lt-gold { font-size: 12dp; font-weight: bold; }
.lt-body { display: flex; flex-direction: row; gap: 14dp; }
.lt-side { flex: 0 0 190dp; display: flex; flex-direction: column; gap: 8dp; }
.lt-main { flex: 1; display: flex; flex-direction: column; gap: 10dp; }
.lbar { position: relative; height: 18dp; overflow: hidden; background-color: #00000080; }
.lbf { position: absolute; left: 0; top: 0; bottom: 0; }
.lhp .lbf { background-color: #c4141c; } .lmn .lbf { background-color: #2a64d8; } .len .lbf { background-color: #c99a1e; }
.lbt { position: absolute; left: 8dp; top: 0; font-size: 10.5dp; line-height: 18dp; font-weight: bold; color: #ffffff; font-effect: outline(1dp #000000aa); }
.lbv { position: absolute; right: 8dp; top: 0; font-size: 10.5dp; line-height: 18dp; color: #ffffff; font-effect: outline(1dp #000000aa); }
.lt-btns { display: flex; flex-direction: row; gap: 6dp; margin-top: 4dp; }
.lt-btn { flex: 1; text-align: center; height: 28dp; line-height: 28dp; font-size: 11.5dp; font-weight: bold; cursor: pointer;
	transition: transform background-color 0.15s cubic-out; }
.lt-btn:hover { transform: translateY(-1dp); }
.lt-btn:active { transform: scale(0.94); }
.lt-stats { display: flex; flex-direction: row; flex-wrap: wrap; }
.lst { width: 25%; display: flex; flex-direction: column; padding: 4dp 0; }
.lsk { font-size: 10dp; } .lsv { font-size: 14dp; font-weight: bold; }
.lt-items { display: flex; flex-direction: column; }
.lit { display: flex; flex-direction: row; align-items: center; gap: 8dp; height: 30dp; padding: 0 6dp; }
.lit .spr { width: 22dp; height: 22dp; }
.lin { flex: 1; font-size: 12dp; }
.liq { font-size: 11dp; }

/* (a) Classic EQ: stone and bronze, square, serif gold */
.lt-classic { background-color: #2b241c; border: 4dp #8a6a2f; decorator: vertical-gradient(#3a3024 #1e1912); }
.lt-classic .lt-head { border-width: 0 0 2dp 0; border-color: #8a6a2f; padding-bottom: 10dp; }
.lt-classic .lt-por { border: 3dp #c9a24a; background-color: #0e0b07; }
.lt-classic .lt-name { font-family: Georgia; color: #f0c860; font-effect: shadow(2dp 2dp #000000); }
.lt-classic .lt-sub, .lt-classic .lsk { color: #b8a37a; font-family: Georgia; }
.lt-classic .lt-gold { color: #f0c860; }
.lt-classic .lbar { border: 1dp #6b5226; }
.lt-classic .lt-btn { background-color: #4a3b26; border: 2dp #8a6a2f; color: #f0d79a; font-family: Georgia; }
.lt-classic .lt-btn:hover { background-color: #5c4a30; }
.lt-classic .lt-stats { background-color: #00000040; border: 1dp #6b5226; padding: 4dp 8dp; }
.lt-classic .lsv { color: #f0e6d0; font-family: Georgia; }
.lt-classic .lit { border-width: 0 0 1dp 0; border-color: #6b522655; }

/* (b) Glass HUD: floating rounded cards, neon accents */
.lt-glass { width: 580dp; padding: 0; gap: 10dp; }
.lt-glass .lt-head, .lt-glass .lt-side, .lt-glass .lt-stats, .lt-glass .lt-items { background-color: #ffffff14; border: 1dp #ffffff30; border-radius: 16dp; padding: 12dp; }
.cap-backdrop .lt-glass .lt-head, .cap-backdrop .lt-glass .lt-side, .cap-backdrop .lt-glass .lt-stats, .cap-backdrop .lt-glass .lt-items { backdrop-filter: blur(8dp); }
.lt-glass .lt-body { flex-direction: row-reverse; }
.lt-glass .lt-por { border-radius: 28dp; border: 2dp #7fe0ff; background-color: #ffffff20; }
.cap-boxshadow .lt-glass .lt-por { box-shadow: #7fe0ff88 0dp 0dp 12dp 1dp; }
.lt-glass .lt-name { color: #ffffff; font-size: 20dp; }
.lt-glass .lt-sub, .lt-glass .lsk { color: #b9d8ff; }
.lt-glass .lt-gold { color: #7fe0ff; }
.lt-glass .lbar { border-radius: 9dp; background-color: #ffffff18; }
.lt-glass .lbf { border-radius: 9dp; }
.lt-glass .lhp .lbf { decorator: horizontal-gradient(#ff4d6d #ff9a6b); }
.lt-glass .lmn .lbf { decorator: horizontal-gradient(#4c8dff #7fe0ff); }
.lt-glass .len .lbf { decorator: horizontal-gradient(#ffcf45 #fff2a0); }
.lt-glass .lt-btn { border-radius: 14dp; background-color: #ffffff1c; border: 1dp #ffffff40; color: #ffffff; }
.lt-glass .lt-btn.pri { background-color: #4c8dffaa; border-color: #7fe0ff; }
.lt-glass .lsv { color: #ffffff; }
.lt-glass .lit { border-radius: 8dp; }
.lt-glass .lit:hover { background-color: #ffffff14; }

/* (c) Compact Raid: dense grid, tiny type, no chrome */
.lt-raid { width: 600dp; padding: 8dp; gap: 6dp; background-color: #0e1116; border: 1dp #262c36; }
.lt-raid .lt-head { gap: 8dp; }
.lt-raid .lt-por { width: 28dp; height: 28dp; flex: 0 0 28dp; background-color: #1a1f28; }
.lt-raid .lt-por .spr { margin: 3dp; width: 22dp; height: 22dp; }
.lt-raid .lt-name { font-size: 13dp; color: #ffffff; }
.lt-raid .lt-sub { font-size: 10dp; color: #7c8596; }
.lt-raid .lt-gold { font-size: 10dp; color: #ffcf45; }
.lt-raid .lt-body { flex-direction: column; gap: 6dp; }
.lt-raid .lt-side { flex: 0 0 auto; flex-direction: row; flex-wrap: wrap; gap: 4dp; }
.lt-raid .lbar { width: 32%; height: 12dp; background-color: #1a1f28; }
.lt-raid .lbt, .lt-raid .lbv { font-size: 9dp; line-height: 12dp; }
.lt-raid .lt-btns { width: 100%; margin-top: 0; }
.lt-raid .lt-btn { height: 20dp; line-height: 20dp; font-size: 10dp; background-color: #1a1f28; color: #c9d0de; }
.lt-raid .lt-btn.pri { background-color: #e0303e; color: #ffffff; }
.lt-raid .lt-main { flex-direction: row; gap: 6dp; }
.lt-raid .lt-stats { width: 45%; background-color: #13171e; }
.lt-raid .lst { width: 25%; padding: 3dp 6dp; box-sizing: border-box; flex-direction: row; justify-content: space-between; }
.lt-raid .lsk { font-size: 9dp; color: #7c8596; } .lt-raid .lsv { font-size: 10dp; color: #ffffff; }
.lt-raid .lt-items { flex: 1; }
.lt-raid .lit { height: 20dp; } .lt-raid .lit:nth-child(odd) { background-color: #13171e; }
.lt-raid .lit .spr { width: 16dp; height: 16dp; } .lt-raid .lin { font-size: 10.5dp; } .lt-raid .liq { color: #7c8596; font-size: 9.5dp; }

/* (d) Sci-fi: clipped corners, cyan glow lines, monospace */
.lt-scifi { background-color: #031820e8; border: 1dp #22e6ff88; font-family: Consolas; }
.lt-scifi .lt-cut { display: block; position: absolute; width: 22dp; height: 22dp; background-color: #020a10; border: 1dp #22e6ff;
	transform: rotate(45deg); }
.lt-scifi .c1 { left: -12dp; top: -12dp; } .lt-scifi .c2 { right: -12dp; bottom: -12dp; }
.lt-scifi .lt-line { display: block; position: absolute; left: 40dp; right: 40dp; top: -1dp; height: 2dp; background-color: #22e6ff; }
.cap-boxshadow .lt-scifi .lt-line { box-shadow: #22e6ffcc 0dp 0dp 8dp 1dp; }
.cap-boxshadow .lt-scifi { box-shadow: #22e6ff33 0dp 0dp 16dp 0dp; }
.lt-scifi .lt-por { border: 1dp #22e6ff; background-color: #22e6ff14; }
.lt-scifi .lt-name { color: #22e6ff; font-family: Consolas; letter-spacing: 2dp; font-effect: glow(1dp 4dp #22e6ff88); }
.lt-scifi .lt-sub, .lt-scifi .lsk, .lt-scifi .liq { color: #5fa8b8; font-family: Consolas; }
.lt-scifi .lt-gold { color: #ffcf45; font-family: Consolas; }
.lt-scifi .lbar { height: 10dp; background-color: #22e6ff14; border: 1dp #22e6ff55; }
.lt-scifi .lhp .lbf { background-color: #ff3b6b; } .lt-scifi .lmn .lbf { background-color: #22e6ff; } .lt-scifi .len .lbf { background-color: #ffcf45; }
.lt-scifi .lbt, .lt-scifi .lbv { top: 10dp; font-family: Consolas; font-size: 9dp; color: #9be9f5; font-effect: none; }
.lt-scifi .lt-side { gap: 16dp; }
.lt-scifi .lt-btn { background-color: #00000000; border: 1dp #22e6ff; color: #22e6ff; font-family: Consolas; }
.lt-scifi .lt-btn:hover { background-color: #22e6ff22; }
.lt-scifi .lt-btn.pri { background-color: #22e6ff; color: #031820; }
.lt-scifi .lt-stats { border: 1dp #22e6ff44; }
.lt-scifi .lst { padding: 4dp 8dp; box-sizing: border-box; border-width: 0 1dp 1dp 0; border-color: #22e6ff22; }
.lt-scifi .lsv { color: #e6fbff; font-family: Consolas; }
.lt-scifi .lin { font-family: Consolas; }
.lt-scifi .lit { border-width: 0 0 0 2dp; border-color: #22e6ff66; margin-bottom: 2dp; background-color: #22e6ff08; }

/* (e) Parchment tome: warm paper, ink, centred book layout */
.lt-tome { width: 600dp; padding: 18dp 24dp; background-color: #efe3c6; decorator: vertical-gradient(#f6ecd4 #dcc79c); border: 2dp #6b4a22;
	border-radius: 6dp; }
.cap-boxshadow .lt-tome { box-shadow: #000000aa 0dp 10dp 24dp 0dp; }
.lt-tome .lt-head { flex-direction: column; text-align: center; gap: 4dp; border-width: 0 0 1dp 0; border-color: #8a6a2f88; padding-bottom: 8dp; }
.lt-tome .lt-por { border-radius: 28dp; border: 2dp #6b4a22; background-color: #e2d2ac; }
.lt-tome .lt-name { font-family: Georgia; color: #3a2412; font-size: 22dp; }
.lt-tome .lt-sub { font-family: Georgia; color: #6b4a22; }
.lt-tome .lt-gold { font-family: Georgia; color: #8a5a00; }
.lt-tome .lt-body { flex-direction: row; gap: 0; }
.lt-tome .lt-side { padding-right: 16dp; border-width: 0 1dp 0 0; border-color: #8a6a2f88; }
.lt-tome .lt-main { padding-left: 16dp; }
.lt-tome .lbar { background-color: #00000018; border-radius: 2dp; height: 14dp; }
.lt-tome .lhp .lbf { background-color: #8a1a14; } .lt-tome .lmn .lbf { background-color: #1e3c78; } .lt-tome .len .lbf { background-color: #8a6410; }
.lt-tome .lbt, .lt-tome .lbv { line-height: 14dp; font-family: Georgia; }
.lt-tome .lt-btn { background-color: #00000000; border-width: 0 0 2dp 0; border-color: #6b4a22; color: #3a2412; font-family: Georgia; }
.lt-tome .lt-btn.pri { color: #8a1a14; border-color: #8a1a14; }
.lt-tome .lst { text-align: center; }
.lt-tome .lsk { font-family: Georgia; color: #6b4a22; } .lt-tome .lsv { font-family: Georgia; color: #2a1a0a; }
.lt-tome .lin { font-family: Georgia; } .lt-tome .liq { color: #6b4a22; }
.lt-tome .c-legendary { color: #a34a00; } .lt-tome .c-epic { color: #6a2a9a; } .lt-tome .c-rare { color: #1e3c98; } .lt-tome .c-uncommon { color: #1e6a2e; }
.lt-tome .lit { border-width: 0 0 1dp 0; border-color: #8a6a2f44; }

.ltfoot { display: flex; flex-direction: row; align-items: center; gap: 10dp; margin-top: 10dp; }
.skins, .chromes { display: flex; flex-direction: row; gap: 6dp; }
.skin-dot { width: 20dp; height: 20dp; border-radius: 10dp; border: 2dp #ffffff22; cursor: pointer; transition: transform border-color 0.15s back-out; }
.skin-dot:hover { transform: scale(1.15); }
.skin-dot.on { border-color: #ffffff; }
.sd-midnight { background-color: #3d6fe0; } .sd-ember { background-color: #d9572b; } .sd-forest { background-color: #2f9e62; } .sd-paper { background-color: #e9dcc0; }
.lt-tome .lt-id { flex: 0 0 auto; }
.lt-tome .lt-head .lt-gold { margin-top: 2dp; }
/* Compact Raid layout: one dense column, bars in a row, 8-column stat strip, two-column item grid */
.lt-raid .lt-side { flex-direction: row; flex-wrap: wrap; gap: 4dp; }
.lt-raid .lbar { flex: 1 1 30%; width: auto; }
.lt-raid .lt-btns { flex: 1 1 100%; }
.lt-raid .lt-main { flex-direction: column; gap: 4dp; }
.lt-raid .lt-stats { width: auto; }
.lt-raid .lst { width: 12.5%; flex-direction: column; justify-content: flex-start; text-align: center; }
.lt-raid .lt-items { flex-direction: row; flex-wrap: wrap; }
.lt-raid .lit { width: 50%; box-sizing: border-box; }

/* ======================= Glow and text ======================= */
.gt-hero { position: relative; height: 112dp; border-radius: 14dp; overflow: hidden; margin-bottom: 12dp; background-color: #07090f;
	decorator: vertical-gradient(#1a1030 #07090f); }
.shader-on .gt-hero { decorator: radial-gradient(ellipse at 50% 100%, #5a1a10, #07090f 70%); }
.hero-t { position: absolute; left: 0; right: 0; top: 14dp; text-align: center; font-size: 54dp; font-weight: bold; letter-spacing: 8dp; }
.hero-glow { color: #ff9a1f; font-effect: glow(4dp 16dp #ff6a00); opacity: 0.5; }
.page.on .hero-glow { animation: 1.8s sine-in-out infinite alternate heroglow; }
@keyframes heroglow { from { opacity: 0.25; } to { opacity: 1; } }
.hero-base { color: #ffd27a; font-effect: outline(2dp #3a1400); }
.hero-top { color: #ff7a1f; opacity: 0; }
.cap-mask .hero-top { opacity: 1; mask-image: linear-gradient(to bottom, #00000000 30%, #000000ff 85%); }
.hero-sub { position: absolute; left: 0; right: 0; bottom: 12dp; text-align: center; font-size: 13dp; letter-spacing: 6dp; color: #d6c29b;
	font-effect: shadow(1dp 1dp #000000); }
.gt-row { display: flex; flex-direction: row; gap: 12dp; margin-bottom: 12dp; }
.gtc { flex: 1; margin: 0; padding: 14dp; box-sizing: border-box; }
.dmgs { display: flex; flex-direction: row; align-items: center; justify-content: space-around; height: 96dp; background-color: #0b0f18; }
.dn { font-size: 19dp; font-weight: bold; color: #ffffff; font-effect: outline(2dp #000000); }
.dn.crit { font-size: 27dp; color: #ffad33; font-effect: glow(2dp 8dp #ff6a00), outline(2dp #3a1400); }
.dn.heal { color: #6dff9a; font-effect: glow(1dp 6dp #2fcf5a), outline(1dp #003a10); }
.dn.magic { color: #d4a0ff; font-effect: glow(1dp 6dp #9b4dff), outline(1dp #20003a); }
.dn.miss { font-size: 16dp; color: #a7aebc; }
.page.on .dn { animation: 2.2s back-out infinite dnpop; }
.page.on .dn.n2 { animation: 2.2s back-out 0.3s infinite dnpop; } .page.on .dn.n3 { animation: 2.2s back-out 0.6s infinite dnpop; } .page.on .dn.n4 { animation: 2.2s back-out 0.9s infinite dnpop; } .page.on .dn.n5 { animation: 2.2s back-out 1.2s infinite dnpop; } 
@keyframes dnpop { 0% { transform: translateY(10dp) scale(0.4); opacity: 0; } 12% { transform: translateY(0dp) scale(1.25); opacity: 1; }
	25% { transform: scale(1); } 75% { transform: translateY(-14dp) scale(1); opacity: 1; } 100% { transform: translateY(-24dp) scale(0.9); opacity: 0; } }
.neonc { height: 96dp; display: flex; flex-direction: column; align-items: center; justify-content: center; background-color: #05060a; }
.neon { font-size: 32dp; font-weight: bold; letter-spacing: 6dp; color: #ffe8ff; font-effect: glow(2dp 10dp #ff2bd6), outline(1dp #ff2bd6); }
.neon2 { font-size: 14dp; font-weight: bold; letter-spacing: 10dp; color: #e0fbff; font-effect: glow(1dp 6dp #22e6ff); }
.page.on .neon { animation: 3.2s linear-in-out infinite flicker; }
.page.on .neon2 { animation: 4.5s linear-in-out infinite flicker2; }
@keyframes flicker { 0% { opacity: 1; } 6% { opacity: 1; } 7% { opacity: 0.2; } 8% { opacity: 1; } 10% { opacity: 0.3; } 12% { opacity: 1; }
	60% { opacity: 1; } 61% { opacity: 0.5; } 63% { opacity: 1; } 100% { opacity: 1; } }
@keyframes flicker2 { 0% { opacity: 1; } 40% { opacity: 1; } 41% { opacity: 0.15; } 44% { opacity: 0.15; } 45% { opacity: 1; } 100% { opacity: 1; } }
.rarity { display: flex; flex-direction: column; gap: 6dp; }
.rn { font-size: 15dp; font-weight: bold; }
.g-uncommon { font-effect: glow(1dp 4dp #2fcf5a66); }
.g-rare { font-effect: glow(1dp 5dp #3d84ff88); }
.g-epic { font-effect: glow(1dp 6dp #b05cffaa); }
.g-legendary { font-effect: glow(2dp 8dp #ff9a1fcc), outline(1dp #3a1400); }
.page.on .g-legendary { animation: 1.4s sine-in-out infinite alternate legpulse; }
@keyframes legpulse { from { color: #ffad33; } to { color: #ffe08a; } }
.chat { display: flex; flex-direction: column; gap: 8dp; }
.bub { position: relative; max-width: 78%; padding: 7dp 11dp; border-radius: 12dp; background-color: #1d2536; display: flex; flex-direction: column; }
.bub.right { margin-left: auto; background-color: #2a3e6e; }
.bub.tell { background-color: #3a2550; }
.btail { position: absolute; bottom: -4dp; width: 10dp; height: 10dp; transform: rotate(45deg); background-color: #1d2536; }
.bub.left .btail { left: 14dp; } .bub.right .btail { right: 14dp; background-color: #2a3e6e; } .bub.tell .btail { background-color: #3a2550; }
.who { font-size: 11dp; font-weight: bold; }
.msg { font-size: 12.5dp; color: #e7eaf3; }
.page.on .bub { animation: 0.4s back-out 1 bubin; }
@keyframes bubin { from { transform: translateY(8dp) scale(0.9); opacity: 0; } to { transform: translateY(0dp) scale(1); opacity: 1; } }
.typer { margin: 0 0 12dp 0; height: 46dp; background-color: #05070c; border: 1dp #2fcf9555; font-family: Consolas; display: flex; flex-direction: row;
	align-items: center; }
.twt { font-family: Consolas; font-size: 15dp; color: #7dffb0; font-effect: glow(1dp 4dp #2fcf9566); }
.caret { width: 9dp; height: 18dp; margin-left: 2dp; background-color: #7dffb0; }
.page.on .caret { animation: 0.5s linear-in-out infinite alternate caretb; }
@keyframes caretb { from { opacity: 1; } to { opacity: 0; } }
.boss { height: 70dp; border-radius: 6dp; padding: 3dp; background-color: #3a0d0d; decorator: horizontal-gradient(#5a0a0a #c4141c); }
.shader-on .boss { decorator: linear-gradient(to right, #2a0505, #c4141c 50%, #2a0505); }
.cap-boxshadow .boss { box-shadow: #ff3b3b66 0dp 0dp 16dp 2dp; }
.boss-in { position: relative; height: 64dp; border-radius: 4dp; overflow: hidden; background-color: #120405; text-align: center; }
.boss-n { margin-top: 8dp; font-size: 26dp; font-weight: bold; letter-spacing: 3dp; color: #ffd27a; font-effect: glow(2dp 8dp #ff3b1f), outline(2dp #2a0000); }
.boss-s { font-size: 11dp; letter-spacing: 5dp; color: #c98a7a; }
.boss-shine { position: absolute; top: -10dp; left: -80dp; width: 50dp; height: 90dp; background-color: #ffffff30; transform: skewX(-25deg); }
.shader-on .boss-shine { background-color: #00000000; decorator: linear-gradient(to right, #ffffff00, #ffffff66, #ffffff00); }
.page.on .boss-shine { animation: 2.6s cubic-in-out infinite bshine; }
@keyframes bshine { 0% { transform: translateX(0dp) skewX(-25deg); } 60% { transform: translateX(800dp) skewX(-25deg); } 100% { transform: translateX(800dp) skewX(-25deg); } }

/* ======================= Clipping ======================= */
.cl-row { display: flex; flex-direction: row; gap: 12dp; margin-bottom: 12dp; }
.clc { flex: 1; margin: 0; height: 170dp; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.clc.clw { flex: 2; }
.porthole { position: relative; width: 140dp; height: 140dp; border-radius: 70dp; overflow: hidden; border: 6dp #8a6a2f; box-sizing: border-box;
	background-color: #5fb8ff; }
.cap-boxshadow .porthole { box-shadow: #000000 0dp 0dp 10dp 2dp inset; }
.scene { position: absolute; left: 0; top: 0; width: 128dp; height: 128dp; }
.sky { position: absolute; left: 0; top: 0; right: 0; bottom: 0; decorator: vertical-gradient(#2a64d8 #ffcf8a); }
.sun { position: absolute; left: 70dp; top: 26dp; width: 30dp; height: 30dp; border-radius: 15dp; background-color: #ffe08a; }
.cap-boxshadow .sun { box-shadow: #ffcf45aa 0dp 0dp 14dp 4dp; }
.clouds { position: absolute; left: 0; top: 14dp; width: 256dp; height: 30dp; }
.page.on .clouds { animation: 9s linear-in-out infinite drift; }
@keyframes drift { from { transform: translateX(0dp); } to { transform: translateX(-128dp); } }
.cl1, .cl2, .cl3 { position: absolute; height: 12dp; border-radius: 6dp; background-color: #ffffffcc; }
.cl1 { left: 10dp; top: 4dp; width: 44dp; } .cl2 { left: 80dp; top: 14dp; width: 30dp; } .cl3 { left: 138dp; top: 4dp; width: 44dp; }
.hills { position: absolute; left: 0; top: 64dp; width: 256dp; height: 40dp; }
.page.on .hills { animation: 14s linear-in-out infinite drift; }
.h1x, .h2x { position: absolute; top: 10dp; width: 128dp; height: 60dp; border-radius: 64dp 64dp 0 0; background-color: #2f9e62; }
.h1x { left: -20dp; } .h2x { left: 100dp; top: 18dp; background-color: #1e7a48; }
.sea { position: absolute; left: 0; right: 0; top: 92dp; bottom: 0; decorator: vertical-gradient(#1e5ab8 #0a2a60); }
.boat { position: absolute; left: 46dp; top: 74dp; width: 34dp; height: 34dp; }
.page.on .boat { animation: 2s sine-in-out infinite alternate bob; }
@keyframes bob { from { transform: translateY(0dp) rotate(-6deg); } to { transform: translateY(4dp) rotate(6deg); } }
.minimap { position: relative; width: 140dp; height: 140dp; border-radius: 70dp; overflow: hidden; background-color: #0a1a12; border: 3dp #2fcf95aa;
	box-sizing: border-box; }
.mm-rot { position: absolute; left: -20dp; top: -20dp; width: 174dp; height: 174dp; }
.page.on .mm-rot { animation: 16s linear-in-out infinite spin; }
.mm-grid { position: absolute; left: 0; top: 0; right: 0; bottom: 0;
	decorator: horizontal-gradient(#2fcf9500 #2fcf9522); }
.shader-on .mm-grid { decorator: repeating-linear-gradient(0deg, #2fcf9533 0dp, #2fcf9533 1dp, #00000000 1dp, #00000000 18dp),
	repeating-linear-gradient(90deg, #2fcf9533 0dp, #2fcf9533 1dp, #00000000 1dp, #00000000 18dp); }
.mm-dot { position: absolute; width: 7dp; height: 7dp; border-radius: 4dp; background-color: #7dffb0; }
.mm-dot.foe { background-color: #ff4d4d; }
.d1 { left: 40dp; top: 50dp; } .d2 { left: 120dp; top: 70dp; } .d3 { left: 70dp; top: 130dp; } .d4 { left: 110dp; top: 40dp; } .d5 { left: 50dp; top: 100dp; }
.mm-sweep { position: absolute; left: 0; top: 0; width: 134dp; height: 134dp; display: none; }
.shader-on .mm-sweep { display: block; decorator: conic-gradient(#2fcf9500 0deg, #2fcf9500 280deg, #2fcf9599 360deg); }
.page.on .mm-sweep { animation: 2.4s linear-in-out infinite spin; }
.mm-me { position: absolute; left: 61dp; top: 61dp; width: 12dp; height: 12dp; background-color: #ffffff; transform: rotate(45deg); }
.mm-n { position: absolute; left: 0; right: 0; top: 4dp; text-align: center; font-size: 11dp; font-weight: bold; color: #ffcf45; }
.wipebox { position: relative; width: 200dp; height: 130dp; border-radius: 12dp; overflow: hidden; }
.wipe-under { position: absolute; left: 0; top: 0; width: 200dp; height: 130dp; background-color: #1d2536; }
.wipe-under .wbi { image-color: #ffffff40; }
.wipe-clip { position: absolute; left: 0; top: 0; width: 0dp; height: 130dp; overflow: hidden; }
.page.on .wipe-clip { animation: 3s cubic-in-out infinite alternate wipe; }
@keyframes wipe { from { width: 0dp; } to { width: 200dp; } }
.wipe-over { position: absolute; left: 0; top: 0; width: 200dp; height: 130dp; decorator: horizontal-gradient(#b05cff #ff9a1f); }
.wbi { position: absolute; left: 64dp; top: 29dp; width: 72dp; height: 72dp; }
.wipe-edge { position: absolute; top: 0; left: -10dp; width: 20dp; height: 130dp; opacity: 0; }
.cap-mask .wipe-edge { opacity: 1; background-color: #ffffff; mask-image: linear-gradient(to right, #00000000, #000000ff 50%, #00000000); }
.page.on .wipe-edge { animation: 3s cubic-in-out infinite alternate wipeedge; }
@keyframes wipeedge { from { transform: translateX(0dp); } to { transform: translateX(200dp); } }
.marquee { position: relative; height: 34dp; border-radius: 17dp; overflow: hidden; background-color: #0b0f18; border: 1dp #ffcf4544; margin-bottom: 12dp; }
.mq-track { position: absolute; left: 0; top: 0; height: 34dp; white-space: nowrap; display: flex; flex-direction: row; align-items: center; width: 1500dp; }
.page.on .mq-track { animation: 18s linear-in-out infinite marq; }
@keyframes marq { from { transform: translateX(0dp); } to { transform: translateX(-830dp); } }
.mq-i { font-size: 13dp; font-weight: bold; color: #e7eaf3; padding: 0 16dp; }
.mq-dot { width: 6dp; height: 6dp; border-radius: 3dp; background-color: #ffcf45; }
.nest1 { width: 130dp; height: 130dp; border-radius: 30dp; overflow: hidden; padding: 10dp; box-sizing: border-box; background-color: #ffcf45; }
.nest2 { width: 110dp; height: 110dp; border-radius: 55dp; overflow: hidden; padding: 12dp; box-sizing: border-box; background-color: #ff4d6d; }
.nest3 { width: 86dp; height: 86dp; border-radius: 16dp; overflow: hidden; background-color: #000000; }
.nest-sc { width: 172dp; height: 86dp; decorator: horizontal-gradient(#4c8dff #2fcf95); }
.page.on .nest-sc { animation: 2.6s sine-in-out infinite alternate slide2; }
@keyframes slide2 { from { transform: translateX(0dp) rotate(0deg); } to { transform: translateX(-86dp) rotate(0deg); } }
.cdrow { display: flex; flex-direction: row; gap: 14dp; }
.cdi { position: relative; width: 52dp; height: 52dp; border-radius: 26dp; overflow: hidden; border: 2dp #3a4766; background-color: #000000; }
.cdi .spr { margin: 6dp; width: 36dp; height: 36dp; }
.cdo { position: absolute; left: 0; bottom: 0; width: 52dp; height: 0%; background-color: #000000b0; }
.page.on .cdo { animation: 3s linear-in-out infinite cdfall; }
@keyframes cdfall { from { height: 100%; } to { height: 0%; } }
.cdw { position: absolute; left: 0; top: 0; width: 52dp; height: 52dp; display: none; }
.shader-on .cdo { display: none; }
.shader-on .cdw { display: block; }
.page.on .cdw { animation: 3s linear-in-out infinite cdsweep; }
@keyframes cdsweep { from { decorator: conic-gradient(#000000b8 0deg, #000000b8 360deg, #00000000 360deg); }
	to { decorator: conic-gradient(#000000b8 0deg, #000000b8 0deg, #00000000 0deg); } }
.page.on .cdo.k2 { animation: 3s linear-in-out 0.6s infinite cdfall; } .page.on .cdw.k2 { animation: 3s linear-in-out 0.6s infinite cdsweep; }
.page.on .cdo.k3 { animation: 3s linear-in-out 1.2s infinite cdfall; } .page.on .cdw.k3 { animation: 3s linear-in-out 1.2s infinite cdsweep; }
.page.on .cdo.k4 { animation: 3s linear-in-out 1.8s infinite cdfall; } .page.on .cdw.k4 { animation: 3s linear-in-out 1.8s infinite cdsweep; }
.page.on .cdo.k5 { animation: 3s linear-in-out 2.4s infinite cdfall; } .page.on .cdw.k5 { animation: 3s linear-in-out 2.4s infinite cdsweep; }


/* ======================= Sprites ======================= */
.sp-row { display: flex; flex-direction: row; gap: 12dp; margin-bottom: 12dp; }
.spc { flex: 1; margin: 0; padding: 14dp; box-sizing: border-box; }
.wall { display: flex; flex-direction: row; flex-wrap: wrap; gap: 6dp; }
.wcell { width: 40dp; height: 40dp; border-radius: 8dp; background-color: #151b28; border: 1dp #2c3446; transition: transform background-color border-color 0.18s back-out; }
.wcell:hover { transform: scale(1.35); background-color: #26304a; border-color: #ffcf45; z-index: 5; }
.cap-boxshadow .wcell:hover { box-shadow: #ffcf4588 0dp 0dp 10dp 1dp; }
.wcell .spr { margin: 3dp; width: 34dp; height: 34dp; }
.wcell .spr:hover { transform: none; }
.eqw { margin-top: 6dp; }
.eqw img { width: 40dp; height: 40dp; border-radius: 8dp; transition: transform 0.18s back-out; }
.eqw img:hover { transform: scale(1.35); }
.anims { display: flex; flex-direction: row; align-items: center; justify-content: space-around; }
.gemw { position: relative; width: 80dp; height: 80dp; }
.gemglow { position: absolute; left: 0; top: 0; width: 80dp; height: 80dp; border-radius: 40dp; background-color: #b05cff30; }
.shader-on .gemglow { background-color: #00000000; decorator: radial-gradient(circle, #b05cffaa, #b05cff00 70%); }
.page.on .gemglow { animation: 0.9s sine-in-out infinite alternate gempulse; }
@keyframes gempulse { from { transform: scale(0.7); opacity: 0.5; } to { transform: scale(1.15); opacity: 1; } }
.gem { position: absolute; left: 16dp; top: 16dp; width: 48dp; height: 48dp; }
.coinw { width: 70dp; height: 70dp; perspective: 300dp; }
.coin3d { width: 64dp; height: 64dp; margin: 3dp; }
.page.on .coin3d { animation: 1.6s linear-in-out infinite coinspin; }
@keyframes coinspin { from { transform: rotateY(0deg); } to { transform: rotateY(360deg); } }
.coin-face { width: 64dp; height: 64dp; border-radius: 32dp; border: 4dp #a87a10; box-sizing: border-box; decorator: vertical-gradient(#ffe08a #c99a1e); }
.shader-on .coin-face { decorator: radial-gradient(circle at 35% 30%, #fff2b0, #ffcf45 40%, #a87a10); }
.frames { display: flex; flex-direction: row; gap: 12dp; }
.frm { flex: 1; height: 90dp; display: flex; align-items: center; justify-content: center; padding: 0; }
.frm .spr { width: 40dp; height: 40dp; }
.fr-bronze { image-color: #e0a060; }
.fr-stone { image-color: #b8bcc8; }
.fr-gold { image-color: #ffd86a; }
.tints { display: flex; flex-direction: row; align-items: center; justify-content: space-around; }
.spr.big { width: 52dp; height: 52dp; }
.tint-shadow { image-color: #000000aa; }
.loot { display: flex; flex-direction: row; align-items: center; gap: 20dp; margin: 0; }
.lootstage { position: relative; flex: 1; height: 120dp; border-radius: 12dp; background-color: #0b0f18; overflow: hidden; }
.chest { position: absolute; left: 50%; bottom: 10dp; width: 56dp; height: 56dp; margin-left: -28dp; cursor: pointer; }
.chest:hover { transform: scale(1.1); }
.drop { position: absolute; left: 50%; bottom: 34dp; width: 0; height: 0; opacity: 0; }
.drop.dA { animation: 1.6s cubic-out 1 dropA; }
.drop.dB { animation: 1.6s cubic-out 1 dropB; }
@keyframes dropA { 0% { opacity: 1; } 85% { opacity: 1; } 100% { opacity: 0; } }
@keyframes dropB { 0% { opacity: 1; } 85% { opacity: 1; } 100% { opacity: 0; } }
.drop-i { position: absolute; left: -20dp; top: -20dp; width: 40dp; height: 40dp; }
.dA .drop-i { animation: 0.9s bounce-out 1 popA; }
.dB .drop-i { animation: 0.9s bounce-out 1 popB; }
@keyframes popA { 0% { transform: translateY(20dp) scale(0.2); } 40% { transform: translateY(-62dp) scale(1.3); } 100% { transform: translateY(-50dp) scale(1); } }
@keyframes popB { 0% { transform: translateY(20dp) scale(0.2); } 40% { transform: translateY(-62dp) scale(1.3); } 100% { transform: translateY(-50dp) scale(1); } }
.drop .drop-i { transform: translateY(-50dp); }
.dropbeam { position: absolute; left: -14dp; top: -110dp; width: 28dp; height: 110dp; background-color: #ff9a1f40; }
.shader-on .dropbeam { background-color: #00000000; decorator: linear-gradient(to top, #ff9a1f88, #ff9a1f00); }
.sparkle { position: absolute; width: 6dp; height: 6dp; background-color: #fff2b0; transform: rotate(45deg) scale(0); }
.cap-boxshadow .sparkle { box-shadow: #ffcf45 0dp 0dp 6dp 1dp; }
.spk1 { left: -40dp; top: -70dp; } .spk2 { left: 30dp; top: -80dp; } .spk3 { left: -30dp; top: -40dp; }
.spk4 { left: 36dp; top: -44dp; } .spk5 { left: -6dp; top: -96dp; } .spk6 { left: 10dp; top: -30dp; }
.dA .sparkle { animation: 0.8s cubic-out 1 sparkA; }
.dB .sparkle { animation: 0.8s cubic-out 1 sparkB; }
.dA .spk2 { animation: 0.8s cubic-out 0.1s 1 sparkA; } .dB .spk2 { animation: 0.8s cubic-out 0.1s 1 sparkB; }
.dA .spk3 { animation: 0.8s cubic-out 0.2s 1 sparkA; } .dB .spk3 { animation: 0.8s cubic-out 0.2s 1 sparkB; }
.dA .spk4 { animation: 0.8s cubic-out 0.15s 1 sparkA; } .dB .spk4 { animation: 0.8s cubic-out 0.15s 1 sparkB; }
.dA .spk5 { animation: 0.8s cubic-out 0.3s 1 sparkA; } .dB .spk5 { animation: 0.8s cubic-out 0.3s 1 sparkB; }
.dA .spk6 { animation: 0.8s cubic-out 0.25s 1 sparkA; } .dB .spk6 { animation: 0.8s cubic-out 0.25s 1 sparkB; }

@keyframes sparkA { 0% { transform: rotate(45deg) scale(0); } 40% { transform: rotate(135deg) scale(1.6); } 100% { transform: rotate(225deg) scale(0); } }
@keyframes sparkB { 0% { transform: rotate(45deg) scale(0); } 40% { transform: rotate(135deg) scale(1.6); } 100% { transform: rotate(225deg) scale(0); } }
.drop-n { position: absolute; left: 0; right: 0; top: 10dp; text-align: center; font-size: 14dp; font-weight: bold; opacity: 0;
	font-effect: glow(1dp 6dp #ff6a00); }
.drop-n.nA { animation: 1.8s cubic-out 1 nameA; }
.drop-n.nB { animation: 1.8s cubic-out 1 nameB; }
@keyframes nameA { 0% { opacity: 0; transform: translateY(6dp); } 30% { opacity: 1; transform: translateY(0dp); } 80% { opacity: 1; } 100% { opacity: 0; } }
@keyframes nameB { 0% { opacity: 0; transform: translateY(6dp); } 30% { opacity: 1; transform: translateY(0dp); } 80% { opacity: 1; } 100% { opacity: 0; } }
.sp-row, .loot, .gt-row, .cl-row, .gt-hero, .typer, .boss, .marquee, .clip-list { flex-shrink: 0; }
.gtc.dmgs { flex: 2; }
.dmgs .dn { margin: 0 4dp; }
.card.loot { height: 150dp; padding: 14dp; box-sizing: border-box; }

/* =====================================================================================
   v7 scenes: Motion (spell cast), 3D (card deck), Gradients (loading screen), Effects (frosted glass)
   Shader decorators only under .shader-on, filters/box-shadow/backdrop only under .cap-*.
   ===================================================================================== */

/* ---- Motion: spell-cast sequence. Lua swaps ph-charge / ph-fire / ph-impact on #mo_stage. ---- */
.mo-stage { position: relative; height: 340dp; border-radius: 12dp; overflow: hidden; border: 1dp #ffffff1c; }
.mo-world { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.mo-sky { position: absolute; left: 0; top: 0; right: 0; bottom: 0; decorator: vertical-gradient(#070b1f #1d1640); }
.shader-on .mo-sky { decorator: linear-gradient(180deg, #050816 0%, #141238 55%, #2a1a4a 100%); }
.mo-moon { position: absolute; right: 12%; top: 26dp; width: 46dp; height: 46dp; border-radius: 23dp; background-color: #dfe6ff; opacity: 0.85; }
.cap-boxshadow .mo-moon { box-shadow: #b8c8ff66 0dp 0dp 30dp 6dp; }
.mo-floor { position: absolute; left: 0; right: 0; bottom: 0; height: 78dp; decorator: vertical-gradient(#1a1d36 #0a0b18); border-top: 1dp #ffffff14; }
.mo-runes { position: absolute; left: 4%; bottom: 52dp; width: 140dp; height: 30dp; border-radius: 70dp; border: 2dp #ffffff10; opacity: 0.3;
	transition: opacity 0.3s cubic-out, transform 0.3s cubic-out; }
.ph-charge .mo-runes { opacity: 1; transform: scale(1.15); }
.mo-shadow { position: absolute; left: -6dp; right: -6dp; bottom: -6dp; height: 12dp; border-radius: 30dp; background-color: #00000088; }
.mo-caster { position: absolute; left: 8%; bottom: 66dp; width: 60dp; height: 110dp; }
.mo-robe { position: absolute; left: 6dp; bottom: 0; width: 48dp; height: 78dp; border-radius: 22dp 22dp 6dp 6dp; decorator: vertical-gradient(#3b4b8f #1c2350); border: 1dp #ffffff22; }
.mo-hood { position: absolute; left: 14dp; top: 6dp; width: 32dp; height: 34dp; border-radius: 16dp 16dp 12dp 12dp; background-color: #2a3570; border: 1dp #ffffff22; }
.mo-staff { position: absolute; left: 56dp; bottom: 0; width: 5dp; height: 120dp; border-radius: 2dp; background-color: #8a6a3f; }
.mo-gem { position: absolute; left: -5dp; top: -10dp; width: 15dp; height: 15dp; border-radius: 8dp; background-color: #7fd4ff; transition: transform 0.25s back-out; }
.ph-charge .mo-gem { transform: scale(1.5); }
.mo-charge { position: absolute; left: 8%; margin-left: 30dp; bottom: 148dp; width: 64dp; height: 64dp; opacity: 0; transform: scale(0.2);
	transition: opacity 0.2s cubic-out, transform 0.9s cubic-out; }
.ph-charge .mo-charge { opacity: 1; transform: scale(1); }
.mo-ring { position: absolute; left: 0; top: 0; width: 60dp; height: 60dp; border-radius: 30dp; border: 2dp #7fd4ff; }
.mo-ring.r2 { left: 10dp; top: 10dp; width: 40dp; height: 40dp; border-radius: 20dp; border-width: 3dp; }
.page.on .ph-charge .mo-ring.r1 { animation: 0.9s linear-in-out infinite mospin; }
.page.on .ph-charge .mo-ring.r2 { animation: 0.6s linear-in-out infinite mospinr; }
@keyframes mospin { from { transform: rotate(0deg) scale(1.1); } to { transform: rotate(360deg) scale(0.85); } }
@keyframes mospinr { from { transform: rotate(360deg); } to { transform: rotate(0deg); } }
.mo-ring.r1 { border-color: #7fd4ff #7fd4ff00 #7fd4ff #7fd4ff00; }
.mo-core { position: absolute; left: 22dp; top: 22dp; width: 20dp; height: 20dp; border-radius: 10dp; background-color: #e8f8ff; }
.cap-boxshadow .mo-core { box-shadow: #7fd4ffcc 0dp 0dp 18dp 6dp; }
.mo-mote { position: absolute; width: 6dp; height: 6dp; border-radius: 3dp; background-color: #bfeaff; }
.mo-mote.m1 { left: -16dp; top: 4dp; } .mo-mote.m2 { left: 70dp; top: 20dp; } .mo-mote.m3 { left: 24dp; top: 74dp; }
.page.on .ph-charge .mo-mote { animation: 0.45s cubic-in infinite moin; }
@keyframes moin { from { transform: translate(0dp, 0dp); opacity: 1; } to { transform: translate(0dp, 0dp) scale(0.2); opacity: 0; } }
.mo-bolt { position: absolute; left: 13%; bottom: 160dp; width: 90dp; height: 26dp; opacity: 0; }
.ph-fire .mo-bolt { left: 74%; opacity: 1; transition: left 0.55s cubic-in, opacity 0.05s linear-in-out; }
.mo-orb { position: absolute; right: 0; top: 0; width: 26dp; height: 26dp; border-radius: 13dp; background-color: #e8f8ff; border: 3dp #7fd4ff; }
.shader-on .mo-orb { border-width: 0; decorator: radial-gradient(circle, #ffffff 0%, #bfeaff 40%, #7fd4ff 70%, #7fd4ff00 100%); background-color: transparent; }
.cap-filters .mo-orb { filter: drop-shadow(#7fd4ff 0dp 0dp 8dp); }
.mo-trail { position: absolute; left: 0; right: 12dp; top: 8dp; height: 10dp; border-radius: 5dp; decorator: horizontal-gradient(#7fd4ff00 #7fd4ffcc); }
.cap-filters .mo-trail { filter: blur(2dp); }
.page.on .ph-fire .mo-orb { animation: 0.12s linear-in-out infinite alternate orbwob; }
@keyframes orbwob { from { transform: scale(0.9); } to { transform: scale(1.15); } }
.mo-target { position: absolute; left: 80%; bottom: 66dp; width: 56dp; height: 96dp; }
.mo-dummy { position: absolute; left: 0; bottom: 0; width: 56dp; height: 96dp; border-radius: 28dp 28dp 10dp 10dp; decorator: vertical-gradient(#6a3a3a #2c1414); border: 1dp #ffffff22; transform-origin: 50% 100%; }
.mo-eye { position: absolute; top: 26dp; width: 8dp; height: 5dp; border-radius: 3dp; background-color: #ffcf45; }
.mo-eye.e1 { left: 15dp; } .mo-eye.e2 { left: 33dp; }
.page.on .ph-impact .mo-dummy { animation: 0.5s cubic-out 1 dummyhit; }
@keyframes dummyhit { 0% { transform: rotate(0deg); } 20% { transform: rotate(14deg) scale(1.05, 0.95); } 50% { transform: rotate(-6deg); } 100% { transform: rotate(0deg); } }
.mo-burst { position: absolute; left: 80%; margin-left: -32dp; bottom: 82dp; width: 120dp; height: 120dp; opacity: 0; }
.ph-impact .mo-burst { opacity: 1; }
.mo-shock { position: absolute; left: 10dp; top: 10dp; width: 96dp; height: 96dp; border-radius: 48dp; border: 4dp #7fd4ff; opacity: 0; }
.page.on .ph-impact .mo-shock.sh1 { animation: 0.6s cubic-out 1 shock; }
.page.on .ph-impact .mo-shock.sh2 { animation: 0.8s cubic-out 0.12s 1 shock; }
@keyframes shock { from { transform: scale(0.15); opacity: 1; } to { transform: scale(1.6); opacity: 0; } }
.mo-core2 { position: absolute; left: 40dp; top: 40dp; width: 36dp; height: 36dp; border-radius: 18dp; background-color: #ffffff; opacity: 0; }
.cap-boxshadow .mo-core2 { box-shadow: #7fd4ff 0dp 0dp 30dp 12dp; }
.page.on .ph-impact .mo-core2 { animation: 0.35s cubic-out 1 core2; }
@keyframes core2 { from { transform: scale(0.4); opacity: 1; } to { transform: scale(1.8); opacity: 0; } }
.mo-spk { position: absolute; left: 56dp; top: 56dp; width: 7dp; height: 7dp; border-radius: 4dp; background-color: #bfeaff; opacity: 0; }
.page.on .ph-impact .mo-spk.k1 { animation: 0.6s cubic-out 1 spk1; }
.page.on .ph-impact .mo-spk.k2 { animation: 0.7s cubic-out 1 spk2; }
.page.on .ph-impact .mo-spk.k3 { animation: 0.55s cubic-out 1 spk3; }
.page.on .ph-impact .mo-spk.k4 { animation: 0.65s cubic-out 1 spk4; }
.page.on .ph-impact .mo-spk.k5 { animation: 0.6s cubic-out 1 spk5; }
.page.on .ph-impact .mo-spk.k6 { animation: 0.75s cubic-out 1 spk6; }
@keyframes spk1 { from { transform: translate(0dp, 0dp); opacity: 1; } to { transform: translate(-70dp, -60dp) scale(0.3); opacity: 0; } }
@keyframes spk2 { from { transform: translate(0dp, 0dp); opacity: 1; } to { transform: translate(60dp, -80dp) scale(0.3); opacity: 0; } }
@keyframes spk3 { from { transform: translate(0dp, 0dp); opacity: 1; } to { transform: translate(80dp, 10dp) scale(0.3); opacity: 0; } }
@keyframes spk4 { from { transform: translate(0dp, 0dp); opacity: 1; } to { transform: translate(-80dp, 20dp) scale(0.3); opacity: 0; } }
@keyframes spk5 { from { transform: translate(0dp, 0dp); opacity: 1; } to { transform: translate(-20dp, -95dp) scale(0.3); opacity: 0; } }
@keyframes spk6 { from { transform: translate(0dp, 0dp); opacity: 1; } to { transform: translate(30dp, 60dp) scale(0.3); opacity: 0; } }
.mo-dmg { position: absolute; left: 80%; margin-left: -20dp; bottom: 190dp; font-size: 30dp; font-weight: bold; color: #bfeaff; opacity: 0;
	font-effect: outline(2dp #000000cc); }
.page.on .ph-impact .mo-dmg { animation: 0.9s back-out 1 modmg; }
@keyframes modmg { 0% { transform: translateY(10dp) scale(0.4); opacity: 0; } 25% { transform: translateY(0dp) scale(1.35); opacity: 1; }
	45% { transform: translateY(-6dp) scale(1); opacity: 1; } 100% { transform: translateY(-44dp) scale(0.95); opacity: 0; } }
.page.on .ph-impact .mo-world { animation: 0.4s linear-in-out 1 moshake; }
@keyframes moshake { 0% { transform: translate(0dp, 0dp); } 15% { transform: translate(-7dp, 3dp); } 30% { transform: translate(6dp, -4dp); }
	45% { transform: translate(-5dp, -2dp); } 60% { transform: translate(4dp, 3dp); } 80% { transform: translate(-2dp, 1dp); } 100% { transform: translate(0dp, 0dp); } }
.mo-flash { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #bfeaff; opacity: 0; }
.page.on .ph-impact .mo-flash { animation: 0.3s cubic-out 1 moflash; }
@keyframes moflash { from { opacity: 0.45; } to { opacity: 0; } }
.mo-hud { position: absolute; left: 0; right: 0; bottom: 16dp; display: flex; justify-content: center; }
.mo-cast { position: relative; width: 260dp; height: 20dp; border-radius: 10dp; background-color: #00000099; border: 1dp #ffffff30; overflow: hidden; opacity: 0.35;
	transition: opacity 0.25s cubic-out; }
.ph-charge .mo-cast { opacity: 1; }
.mo-cbf { position: absolute; left: 0; top: 0; bottom: 0; width: 0%; decorator: horizontal-gradient(#2a7fd0 #9fe4ff); }
.ph-charge .mo-cbf { width: 100%; transition: width 0.9s linear-in-out; }
.ph-fire .mo-cbf { width: 100%; }
.mo-cbt { position: absolute; left: 0; right: 0; top: 2dp; text-align: center; font-size: 11dp; font-weight: bold; color: #ffffff; font-effect: outline(1dp #000000aa); }
/* schools */
.sc-fire .mo-ring, .sc-fire .mo-shock { border-color: #ff8a3d; }
.sc-fire .mo-ring.r1 { border-color: #ff8a3d #ff8a3d00 #ff8a3d #ff8a3d00; }
.sc-fire .mo-gem, .sc-fire .mo-mote, .sc-fire .mo-spk { background-color: #ffb36b; }
.sc-fire .mo-orb { border-color: #ff8a3d; }
.shader-on .sc-fire .mo-orb { decorator: radial-gradient(circle, #ffffff 0%, #ffe08a 35%, #ff6a1a 70%, #ff6a1a00 100%); }
.cap-filters .sc-fire .mo-orb { filter: drop-shadow(#ff6a1a 0dp 0dp 8dp); }
.sc-fire .mo-trail { decorator: horizontal-gradient(#ff6a1a00 #ffb36bcc); }
.sc-fire .mo-dmg { color: #ffcf8a; }
.sc-fire .mo-flash { background-color: #ffb36b; }
.cap-boxshadow .sc-fire .mo-core, .cap-boxshadow .sc-fire .mo-core2 { box-shadow: #ff8a3dcc 0dp 0dp 22dp 8dp; }
.sc-fire .mo-cbf { decorator: horizontal-gradient(#c2401a #ffcf6b); }
.sc-shadow .mo-ring, .sc-shadow .mo-shock { border-color: #b07cff; }
.sc-shadow .mo-ring.r1 { border-color: #b07cff #b07cff00 #b07cff #b07cff00; }
.sc-shadow .mo-gem, .sc-shadow .mo-mote, .sc-shadow .mo-spk { background-color: #d2b2ff; }
.sc-shadow .mo-orb { border-color: #b07cff; }
.shader-on .sc-shadow .mo-orb { decorator: radial-gradient(circle, #ffffff 0%, #d2b2ff 30%, #7a3cff 70%, #7a3cff00 100%); }
.cap-filters .sc-shadow .mo-orb { filter: drop-shadow(#7a3cff 0dp 0dp 8dp); }
.sc-shadow .mo-trail { decorator: horizontal-gradient(#7a3cff00 #b07cffcc); }
.sc-shadow .mo-dmg { color: #e0c8ff; }
.sc-shadow .mo-flash { background-color: #7a3cff; }
.cap-boxshadow .sc-shadow .mo-core, .cap-boxshadow .sc-shadow .mo-core2 { box-shadow: #b07cffcc 0dp 0dp 22dp 8dp; }
.sc-shadow .mo-cbf { decorator: horizontal-gradient(#4a1fa0 #d2b2ff); }
.mo-ctl { display: flex; flex-direction: row; align-items: center; gap: 8dp; }
.mo-sp { flex: 1; }
.mo-sch { display: flex; flex-direction: row; align-items: center; gap: 6dp; padding: 6dp 12dp; border-radius: 16dp; border: 1dp #ffffff22;
	background-color: #ffffff0c; font-size: 12dp; font-weight: bold; color: #c8d2ea; transition: background-color 0.2s cubic-out, border-color 0.2s cubic-out; }
.mo-sch:hover { background-color: #ffffff1c; }
.mo-sch.on { background-color: #3d6fe055; border-color: #7fb0ff; color: #ffffff; }
.mo-dotc { width: 10dp; height: 10dp; border-radius: 5dp; }
.mo-dotc.frost { background-color: #7fd4ff; } .mo-dotc.fire { background-color: #ff8a3d; } .mo-dotc.shadow { background-color: #b07cff; }
#mo_auto.on { background-color: #2fcf9540; border-color: #2fcf95; color: #ffffff; }

/* ---- 3D: card deck. Lua sets pm2/pm1/p0/pp1/pp2 on each card; .carousel / .fan on #dk. ---- */
.dk-stage { position: relative; height: 330dp; border-radius: 12dp; overflow: hidden; border: 1dp #ffffff1c; decorator: vertical-gradient(#0d1430 #070a18); }
.dk-glow { position: absolute; left: 50%; margin-left: -220dp; bottom: 18dp; width: 440dp; height: 60dp; border-radius: 220dp; background-color: #3d6fe022; }
.shader-on .dk-glow { background-color: transparent; decorator: radial-gradient(ellipse, #4c8dff55 0%, #4c8dff00 70%); }
.dk-persp { position: absolute; left: 0; top: 0; right: 0; bottom: 0; perspective: 900dp; }
.dkc { position: absolute; left: 50%; margin-left: -72dp; top: 52dp; width: 144dp; height: 208dp;
	transition: transform 0.55s cubic-out, opacity 0.4s cubic-out; }
.dk-in { position: absolute; left: 0; top: 0; width: 144dp; height: 208dp; transition: transform 0.6s cubic-in-out; }
.dk-in.flip { transform: rotateY(180deg); }
.dk-face { position: absolute; left: 0; top: 0; width: 140dp; height: 204dp; border-radius: 12dp; border: 2dp #e0c070; }
.dk-front { transition: opacity 0.01s linear-in-out 0.3s; }
.dk-in.flip .dk-front { opacity: 0; }
.dk-back { transform: rotateY(180deg); opacity: 0; transition: opacity 0.01s linear-in-out 0.3s; decorator: vertical-gradient(#2a1d48 #120c24); }
.dk-in.flip .dk-back { opacity: 1; }
.cap-boxshadow .dk-face { box-shadow: #000000aa 0dp 10dp 20dp 0dp; }
.cap-boxshadow .dkc.p0 .dk-face { box-shadow: #000000aa 0dp 14dp 24dp 0dp, #ffd27a66 0dp 0dp 18dp 2dp; }
.dk-fire { decorator: vertical-gradient(#7a2614 #2a0c08); }
.dk-frost { decorator: vertical-gradient(#1b4f7a #0a1a2c); }
.dk-nature { decorator: vertical-gradient(#1f6a3a #0a2414); }
.dk-shadow { decorator: vertical-gradient(#4a2380 #160a2c); }
.dk-gold { decorator: vertical-gradient(#7a5a14 #2c1e06); }
.shader-on .dk-fire { decorator: linear-gradient(160deg, #b8401f 0%, #5a1a0e 55%, #1c0805 100%); }
.shader-on .dk-frost { decorator: linear-gradient(160deg, #3a8fd0 0%, #163c62 55%, #08121f 100%); }
.shader-on .dk-nature { decorator: linear-gradient(160deg, #3fae62 0%, #18502c 55%, #08180e 100%); }
.shader-on .dk-shadow { decorator: linear-gradient(160deg, #8a4cd8 0%, #3a1a6a 55%, #10061f 100%); }
.shader-on .dk-gold { decorator: linear-gradient(160deg, #e0b040 0%, #6a4a10 55%, #1c1204 100%); }
.dk-cost { position: absolute; left: -8dp; top: -8dp; width: 30dp; height: 30dp; border-radius: 15dp; background-color: #2a5fd0; border: 2dp #e0c070;
	text-align: center; line-height: 26dp; font-size: 14dp; font-weight: bold; color: #ffffff; }
.dk-art { position: absolute; left: 14dp; top: 18dp; width: 108dp; height: 78dp; border-radius: 8dp; border: 1dp #ffffff30; background-color: #00000055;
	display: flex; align-items: center; justify-content: center; }
.dk-ico { width: 44dp; height: 44dp; }
.page.on .dkc.p0 .dk-ico { animation: 1.8s sine-in-out infinite alternate dkfloat; }
@keyframes dkfloat { from { transform: translateY(2dp) scale(1); } to { transform: translateY(-4dp) scale(1.08); } }
.dk-name { position: absolute; left: 0; right: 0; top: 106dp; text-align: center; font-size: 14dp; font-weight: bold; color: #ffffff; font-effect: shadow(1dp 1dp #000000); }
.dk-type { position: absolute; left: 0; right: 0; top: 126dp; text-align: center; font-size: 11dp; color: #e0c070; }
.dk-stat { position: absolute; left: 14dp; right: 14dp; bottom: 14dp; display: flex; flex-direction: row; justify-content: space-between;
	font-size: 12dp; font-weight: bold; color: #ffffff; padding-top: 8dp; border-top: 1dp #ffffff26; }
.dk-sig { position: absolute; left: 40dp; top: 30dp; width: 56dp; height: 56dp; border-radius: 28dp; border: 3dp #e0c070; transform: rotate(45deg); }
.dk-desc { position: absolute; left: 14dp; right: 14dp; top: 110dp; text-align: center; font-size: 12dp; color: #d8d0f0; }
.carousel .dkc.p0 { transform: translateZ(40dp); }
.carousel .dkc.pp1 { transform: translateX(150dp) translateZ(-60dp) rotateY(-32deg); opacity: 0.9; }
.carousel .dkc.pm1 { transform: translateX(-150dp) translateZ(-60dp) rotateY(32deg); opacity: 0.9; }
.carousel .dkc.pp2 { transform: translateX(250dp) translateZ(-200dp) rotateY(-52deg); opacity: 0.55; }
.carousel .dkc.pm2 { transform: translateX(-250dp) translateZ(-200dp) rotateY(52deg); opacity: 0.55; }
.carousel .dkc.p0:hover { transform: translateZ(70dp) translateY(-6dp); }
.fan .dkc { transform-origin: 50% 160%; }
.fan .dkc.p0 { transform: translateY(-14dp); }
.fan .dkc.pp1 { transform: rotate(11deg); }
.fan .dkc.pm1 { transform: rotate(-11deg); }
.fan .dkc.pp2 { transform: rotate(22deg) translateY(6dp); opacity: 0.85; }
.fan .dkc.pm2 { transform: rotate(-22deg) translateY(6dp); opacity: 0.85; }
.fan .dkc.p0:hover { transform: translateY(-30dp) scale(1.06); }
.dkc.pm2, .dkc.pp2 { z-index: 1; } .dkc.pm1, .dkc.pp1 { z-index: 2; } .dkc.p0 { z-index: 3; }
.dk-ctl { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 8dp; }
.dk-arrow { width: 34dp; text-align: center; }

/* ---- Gradients: loading-screen scene ---- */
.ls { position: relative; height: 380dp; border-radius: 12dp; overflow: hidden; border: 1dp #ffffff1c; }
.ls-sky { position: absolute; left: 0; top: 0; right: 0; bottom: 0; decorator: vertical-gradient(#140f3a #f08050); }
.shader-on .ls-sky { decorator: linear-gradient(180deg, #0b0a2a 0%, #2c1a5a 30%, #8a2f6a 55%, #e8604a 75%, #ffb060 90%, #ffd890 100%); }
.ls-rays { display: none; position: absolute; left: 50%; margin-left: -330dp; top: 220dp; margin-top: -330dp; width: 660dp; height: 660dp; }
.shader-on .ls-rays { display: block; decorator: repeating-conic-gradient(#fff0c014 0deg, #fff0c014 5deg, #fff0c000 5deg, #fff0c000 15deg); }
.shader-on .page.on .ls-rays { animation: 60s linear-in-out infinite spin; }
.ls-aura, .ls-aura2 { display: none; position: absolute; left: 50%; top: 220dp; }
.ls-aura { margin-left: -120dp; margin-top: -120dp; width: 240dp; height: 240dp; border-radius: 120dp; }
.ls-aura2 { margin-left: -90dp; margin-top: -90dp; width: 180dp; height: 180dp; border-radius: 90dp; }
.shader-on .ls-aura { display: block; decorator: conic-gradient(#ffd27a00 0deg, #ffd27a90 60deg, #ff6a9a00 120deg, #ffd27a90 200deg, #ff6a9a00 260deg, #ffe0a090 320deg, #ffd27a00 360deg); }
.shader-on .ls-aura2 { display: block; decorator: conic-gradient(from 90deg, #ffffff00 0deg, #fff6d0a0 40deg, #ffffff00 90deg, #ffffff00 180deg, #fff6d0a0 220deg, #ffffff00 270deg); }
.shader-on .page.on .ls-aura { animation: 9s linear-in-out infinite spin; }
.shader-on .page.on .ls-aura2 { animation: 6s linear-in-out infinite lsrev; }
@keyframes lsrev { from { transform: rotate(360deg); } to { transform: rotate(0deg); } }
.ls-sun { position: absolute; left: 50%; margin-left: -60dp; top: 160dp; width: 120dp; height: 120dp; border-radius: 60dp; background-color: #ffd890; }
.shader-on .ls-sun { background-color: transparent; border-radius: 0; decorator: radial-gradient(circle, #fffbe8 0%, #ffe8a0 30%, #ffb060 55%, #ffb06000 70%); }
.page.on .ls-sun { animation: 3s sine-in-out infinite alternate lssun; }
@keyframes lssun { from { transform: scale(0.96); } to { transform: scale(1.06); } }
.ls-mtn { position: absolute; transform: rotate(45deg); }
.ls-mtn.m1 { left: -60dp; top: 250dp; width: 260dp; height: 260dp; background-color: #3a1a4a; }
.ls-mtn.m2 { left: 55%; top: 236dp; width: 300dp; height: 300dp; background-color: #2e1440; }
.ls-mtn.m3 { left: 22%; top: 290dp; width: 240dp; height: 240dp; background-color: #1a0a26; }
.ls-haze { position: absolute; left: 0; right: 0; bottom: 0; height: 140dp; decorator: vertical-gradient(#0b0a2a00 #0b0a2af0); }
.ls-title { position: absolute; left: 0; right: 0; top: 44dp; text-align: center; font-size: 56dp; font-weight: bold; color: #fff4dc;
	font-family: Georgia; font-effect: glow(2dp 10dp #ff8a3dcc); }
.page.on .ls-title { animation: 2.4s sine-in-out infinite alternate lstitle; }
@keyframes lstitle { from { transform: scale(1); } to { transform: scale(1.03); } }
.ls-sub { position: absolute; left: 0; right: 0; top: 112dp; text-align: center; font-size: 13dp; font-weight: bold; color: #ffd8a8; font-family: Georgia; }
.ls-foot { position: absolute; left: 40dp; right: 40dp; bottom: 22dp; }
.ls-tip { font-size: 12dp; color: #d8cce8; text-align: center; margin-bottom: 8dp; height: 16dp; }
.ls-load { position: relative; height: 12dp; border-radius: 6dp; background-color: #00000088; border: 1dp #ffffff30; overflow: hidden; }
.ls-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0%; overflow: hidden; decorator: horizontal-gradient(#c2456a #ffd27a); }
.shader-on .ls-fill { decorator: linear-gradient(90deg, #8a2f6a 0%, #e8604a 50%, #ffd890 100%); }
.ls-stripes { display: none; position: absolute; left: -40dp; top: 0; bottom: 0; width: 760dp; }
.shader-on .ls-stripes { display: block; decorator: repeating-linear-gradient(120deg, #ffffff30 0dp, #ffffff30 8dp, #ffffff00 8dp, #ffffff00 16dp); }
.shader-on .page.on .ls-stripes { animation: 0.8s linear-in-out infinite lsstripe; }
@keyframes lsstripe { from { transform: translateX(0dp); } to { transform: translateX(18dp); } }
.ls-head { position: absolute; right: 0; top: 0; bottom: 0; width: 18dp; decorator: horizontal-gradient(#ffffff00 #ffffffcc); }
.ls-pct { position: absolute; right: 0; top: 0; font-size: 12dp; font-weight: bold; color: #ffe8c0; }

/* ---- Effects: frosted glass panels over a live backdrop ---- */
.fg { position: relative; height: 470dp; border-radius: 12dp; overflow: hidden; border: 1dp #ffffff1c; }
.fg-bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; decorator: vertical-gradient(#0e1838 #2a0e3a); }
.shader-on .fg-bg { decorator: linear-gradient(135deg, #0a1838 0%, #1a1050 45%, #3a0e40 100%); }
.fg-orb { position: absolute; width: 180dp; height: 180dp; border-radius: 90dp; opacity: 0.75; }
.fg-orb.fo1 { left: 6%; top: 30dp; background-color: #3d6fe0; }
.fg-orb.fo2 { left: 46%; top: 200dp; background-color: #e040b8; width: 220dp; height: 220dp; border-radius: 110dp; }
.fg-orb.fo3 { left: 70%; top: -30dp; background-color: #2fcf95; width: 150dp; height: 150dp; border-radius: 75dp; }
.fg-orb.fo4 { left: 24%; top: 280dp; background-color: #ffb43d; width: 120dp; height: 120dp; border-radius: 60dp; }
.shader-on .fg-orb.fo1 { background-color: transparent; decorator: radial-gradient(circle, #4c8dffff 0%, #4c8dff00 70%); }
.shader-on .fg-orb.fo2 { background-color: transparent; decorator: radial-gradient(circle, #e040b8ff 0%, #e040b800 70%); }
.shader-on .fg-orb.fo3 { background-color: transparent; decorator: radial-gradient(circle, #2fcf95ff 0%, #2fcf9500 70%); }
.shader-on .fg-orb.fo4 { background-color: transparent; decorator: radial-gradient(circle, #ffb43dff 0%, #ffb43d00 70%); }
.page.on .fg-orb.fo1 { animation: 7s sine-in-out infinite alternate fgdrift1; }
.page.on .fg-orb.fo2 { animation: 9s sine-in-out infinite alternate fgdrift2; }
.page.on .fg-orb.fo3 { animation: 8s sine-in-out infinite alternate fgdrift3; }
.page.on .fg-orb.fo4 { animation: 6s sine-in-out infinite alternate fgdrift1; }
@keyframes fgdrift1 { from { transform: translate(0dp, 0dp); } to { transform: translate(140dp, 60dp); } }
@keyframes fgdrift2 { from { transform: translate(0dp, 0dp) scale(1); } to { transform: translate(-180dp, -90dp) scale(1.2); } }
@keyframes fgdrift3 { from { transform: translate(0dp, 0dp); } to { transform: translate(-120dp, 140dp); } }
.fg-grid { display: none; position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.shader-on .fg-grid { display: block; decorator: repeating-linear-gradient(0deg, #ffffff08 0dp, #ffffff08 1dp, #ffffff00 1dp, #ffffff00 28dp); }
.fg-glass { position: absolute; border-radius: 14dp; border: 1dp #ffffff40; background-color: #0c1430e0; padding: 10dp 12dp; }
.cap-backdrop .fg-glass { background-color: #ffffff16; backdrop-filter: blur(7dp); }
.cap-boxshadow .fg-glass { box-shadow: #00000088 0dp 12dp 26dp 0dp; }
.fg-h { display: flex; flex-direction: row; justify-content: space-between; align-items: center; font-size: 13dp; font-weight: bold; color: #ffffff; margin-bottom: 8dp; }
.fg-n { font-size: 11dp; color: #b8c4e8; font-weight: normal; }
.fg-inv { left: 16dp; top: 16dp; width: 230dp; }
.fg-slots { display: flex; flex-direction: row; flex-wrap: wrap; gap: 6dp; }
.fg-s { position: relative; width: 48dp; height: 48dp; border-radius: 9dp; background-color: #0000004a; border: 1dp #ffffff26; transition: transform 0.18s back-out; }
.fg-s:hover { transform: translateY(-3dp) scale(1.06); }
.fg-s.empty { background-color: #00000022; border-color: #ffffff12; }
.fg-s.r-uncommon { border-color: #3fd46a; } .fg-s.r-rare { border-color: #4c8dff; } .fg-s.r-epic { border-color: #b46cff; } .fg-s.r-legendary { border-color: #ff9a2a; }
.cap-boxshadow .fg-s.r-legendary { box-shadow: #ff9a2a88 0dp 0dp 10dp 1dp; }
.cap-boxshadow .fg-s.r-epic { box-shadow: #b46cff66 0dp 0dp 8dp 0dp; }
.fg-i { position: absolute; left: 7dp; top: 7dp; width: 34dp; height: 34dp; }
.fg-i:hover { transform: none; }
.cap-filters .fg-i { filter: drop-shadow(#000000d0 0dp 4dp 3dp); }
.cap-filters .r-legendary .fg-i { filter: drop-shadow(#ff9a2a 0dp 0dp 5dp); }
.fg-q { position: absolute; right: 3dp; bottom: 1dp; font-size: 10dp; font-weight: bold; color: #ffffff; font-effect: outline(1dp #000000); }
.fg-coins { display: flex; flex-direction: row; gap: 12dp; margin-top: 10dp; font-size: 12dp; font-weight: bold; }
.fg-c { padding-left: 14dp; } .fg-c.cpp { color: #d8e8ff; } .fg-c.cgp { color: #ffd45a; } .fg-c.csp { color: #c8c8d0; }
.fg-map { right: 16dp; top: 16dp; width: 250dp; }
.fg-mapin { position: relative; height: 120dp; border-radius: 10dp; overflow: hidden; border: 1dp #ffffff26; background-color: #183a2a; }
.fg-terrain { position: absolute; left: 0; top: 0; right: 0; bottom: 0; decorator: vertical-gradient(#245a3a #12301f); }
.shader-on .fg-terrain { decorator: radial-gradient(circle at 30% 40%, #3a8a52 0%, #1f5034 45%, #0e2a1a 100%); }
.fg-road { position: absolute; left: -20dp; top: 70dp; width: 300dp; height: 6dp; background-color: #c8a87088; transform: rotate(-12deg); }
.fg-road.r2 { left: 100dp; top: -20dp; width: 6dp; height: 200dp; transform: rotate(18deg); }
.fg-pin { position: absolute; width: 12dp; height: 12dp; border-radius: 6dp; border: 2dp #ffffff; }
.fg-pin.p1 { left: 40dp; top: 30dp; background-color: #ffcf45; } .fg-pin.p2 { left: 180dp; top: 100dp; background-color: #ff4d6d; } .fg-pin.p3 { left: 190dp; top: 26dp; background-color: #4c8dff; }
.cap-filters .fg-pin { filter: drop-shadow(#000000 0dp 3dp 2dp); }
.fg-me { position: absolute; left: 118dp; top: 66dp; width: 18dp; height: 18dp; }
.fg-arrow { position: absolute; left: 3dp; top: 1dp; width: 12dp; height: 16dp; background-color: #ffffff; border-radius: 6dp 6dp 2dp 2dp; }
.page.on .fg-arrow { animation: 4s sine-in-out infinite alternate fgturn; }
@keyframes fgturn { from { transform: rotate(-40deg); } to { transform: rotate(50deg); } }
.fg-ping { position: absolute; left: -11dp; top: -11dp; width: 36dp; height: 36dp; border-radius: 18dp; border: 2dp #ffffffaa; opacity: 0; }
.page.on .fg-ping { animation: 1.6s cubic-out infinite fgping; }
@keyframes fgping { from { transform: scale(0.3); opacity: 1; } to { transform: scale(1.4); opacity: 0; } }
.fg-party { right: 16dp; top: 196dp; width: 250dp; }
.pt-h { display: flex; flex-direction: row; justify-content: space-between; font-size: 13dp; font-weight: bold; color: #ffffff; margin-bottom: 6dp; }
.pt-n { font-size: 11dp; color: #b8c4e8; font-weight: normal; }
.pt-row { display: flex; flex-direction: row; align-items: center; gap: 8dp; height: 24dp; margin-bottom: 3dp; transition: opacity 0.3s cubic-out; }
.pt-cls { width: 30dp; font-size: 10dp; font-weight: bold; color: #e0c070; }
.pt-mid { flex: 1; }
.pt-name { font-size: 11dp; color: #ffffff; height: 13dp; }
.pt-bar { position: relative; height: 6dp; border-radius: 3dp; background-color: #00000088; overflow: hidden; }
.pt-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 3dp; decorator: horizontal-gradient(#1f9e52 #5ff09a); transition: width 0.35s cubic-out; }
.pt-mbar { position: relative; height: 3dp; margin-top: 2dp; border-radius: 2dp; background-color: #00000088; overflow: hidden; }
.pt-mfill { position: absolute; left: 0; top: 0; bottom: 0; background-color: #4c8dff; transition: width 0.35s cubic-out; }
.pt-hp { width: 36dp; text-align: right; font-size: 11dp; font-weight: bold; color: #d8f8e4; }
.pt-row.low .pt-fill { decorator: horizontal-gradient(#b02030 #ff6a5a); }
.pt-row.low .pt-hp { color: #ff8a80; }
.page.on .pt-row.low .pt-name { animation: 0.6s sine-in-out infinite alternate ptlow; }
@keyframes ptlow { from { color: #ffffff; } to { color: #ff8a80; } }
.pt-row.dead { opacity: 0.4; }
.pt-f { display: flex; flex-direction: row; align-items: center; gap: 8dp; margin-top: 6dp; }
.pt-in { flex: 1; height: 20dp; padding: 2dp 6dp; border-radius: 6dp; border: 1dp #ffffff30; background-color: #00000055; font-size: 11dp; color: #ffffff; }
.pt-in:focus { border-color: #7fb0ff; }
.pt-ck { display: flex; flex-direction: row; align-items: center; gap: 4dp; font-size: 11dp; color: #c8d2ea; }
.pt-ck input { width: 14dp; height: 14dp; border-radius: 3dp; border: 1dp #ffffff50; background-color: #00000055; }
.pt-ck input:checked { background-color: #3d6fe0; border-color: #7fb0ff; }
.pt-off { padding: 8dp 4dp; font-size: 12dp; color: #c8d2ea; }
.pt-off-h { font-size: 13dp; font-weight: bold; color: #ffffff; margin-bottom: 6dp; }
.pt-off-r { height: 18dp; margin-top: 6dp; border-radius: 4dp; background-color: #ffffff10; }

/* keys available: hotkey labels on the HUD ability bar light up */
.keys-on .abk { color: #ffffff; background-color: #3d6fe0cc; }

/* ---- spell school gems (spell icons out of game / when eq://spell lookup fails) ---- */
.sgem { display: flex; align-items: center; justify-content: center; border-radius: 40dp; border: 1dp #ffffff66;
	background-color: #5a6a8a; decorator: vertical-gradient(#9aaacc #2a3450); }
.sgem span { font-size: 14dp; font-weight: bold; color: #ffffff; font-effect: outline(1dp #00000099); }
.sgem.has-img { border-width: 0; border-radius: 4dp; background-color: transparent; decorator: none; }
.sgem img { width: 100%; height: 100%; }
.bi.sgem span { font-size: 11dp; }
.dk-ico.sgem span { font-size: 22dp; }
.g-evocation { decorator: vertical-gradient(#ffb36b #a02a10); border-color: #ffd0a0; }
.g-alteration { decorator: vertical-gradient(#8af0a8 #1a6a34); border-color: #c0ffd0; }
.g-abjuration { decorator: vertical-gradient(#9fd0ff #1a3e8a); border-color: #d0e8ff; }
.g-conjuration { decorator: vertical-gradient(#e0a8ff #5a1f8a); border-color: #f0d0ff; }
.g-divination { decorator: vertical-gradient(#ffe48a #8a6a10); border-color: #fff0c0; }
.g-necromancy { decorator: vertical-gradient(#b08aff #2a0f4a); border-color: #d8c0ff; }
.shader-on .g-evocation { decorator: radial-gradient(circle at 35% 30%, #fff0d0 0%, #ff8a3d 40%, #8a1c08 100%); }
.shader-on .g-alteration { decorator: radial-gradient(circle at 35% 30%, #e0ffe8 0%, #3fd46a 40%, #0e4a20 100%); }
.shader-on .g-abjuration { decorator: radial-gradient(circle at 35% 30%, #e8f4ff 0%, #4c8dff 40%, #0e2468 100%); }
.shader-on .g-conjuration { decorator: radial-gradient(circle at 35% 30%, #f8e8ff 0%, #b46cff 40%, #3a0e6a 100%); }
.shader-on .g-divination { decorator: radial-gradient(circle at 35% 30%, #fffbe0 0%, #ffcf45 40%, #6a4a08 100%); }
.shader-on .g-necromancy { decorator: radial-gradient(circle at 35% 30%, #e8d8ff 0%, #7a3cff 40%, #1a0636 100%); }
.shader-on .g-none { decorator: radial-gradient(circle at 35% 30%, #ffffff 0%, #8a9ac0 40%, #1e2638 100%); }
.cap-boxshadow .g-evocation { box-shadow: #ff8a3d88 0dp 0dp 8dp 0dp; }
.cap-boxshadow .g-alteration { box-shadow: #3fd46a88 0dp 0dp 8dp 0dp; }
.cap-boxshadow .g-abjuration { box-shadow: #4c8dff88 0dp 0dp 8dp 0dp; }
.cap-boxshadow .g-conjuration { box-shadow: #b46cff88 0dp 0dp 8dp 0dp; }
.cap-boxshadow .g-divination { box-shadow: #ffcf4588 0dp 0dp 8dp 0dp; }
.cap-boxshadow .g-necromancy { box-shadow: #7a3cff88 0dp 0dp 8dp 0dp; }

/* decorative layers never take clicks (the hud background orbs covered the Combat sim button,
   and each ability's shine strip, clipped visually but not for hit-testing, sat over the previous slot) */
.hudbg, .orb, .abclip, .abcd, .shine, .abt, .abk { pointer-events: none; }
.lt-orb, .dk-sig { pointer-events: none; }
