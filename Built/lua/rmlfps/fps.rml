<rml><head><title>RmlFps</title><link type="text/rcss" href="fps.rcss"/></head>
<body id="body"><div id="bg"></div>
<div id="hd"><div class="grip" id="grip" drag="1"></div>
 <img id="hico" src="img/ic_fps_64.png"/><span id="title">FPS Meter</span><div id="sub"><span id="lockic">&#9679; locked &#183; </span><span id="subt">measuring...</span></div>
 <div class="ib" id="a-compact" action="compact">&#8211;</div><div class="ib" id="a-x" action="stop">&#215;</div></div>
<div id="hline"></div>
<div id="tabs"><div class="tab sel" id="a-tab:stats" action="tab:stats">Stats</div><div class="tab" id="a-tab:set" action="tab:set">Settings</div></div>
<div id="cost"><span id="cost1">meter cost --</span><br/><span id="cost2"></span></div>
<div id="statp">
 <div class="tile" id="hero"><div id="fps">--</div><span id="fpsu">FPS</span><div id="grade">measuring</div><div id="ms">-- ms per frame</div></div>
 <div class="tile" id="t_l1"><span class="tk">1% LOW</span><div class="tv" id="l1">--</div><div class="td" id="l1d">1 in 100</div></div><div class="tile" id="t_l01"><span class="tk">0.1% LOW</span><div class="tv" id="l01">--</div><div class="td" id="l01d">1 in 1000</div></div>
 <div class="tile" id="t_avg"><span class="tk">AVERAGE</span><div class="tv" id="avg">--</div><div class="td" id="avgd">last 30 seconds</div></div><div class="tile" id="t_wst"><span class="tk">WORST FRAME</span><div class="tv" id="wst">--</div><div class="td" id="wstd">last 5 seconds</div></div>
 <div class="tile" id="gtile"><span class="tk">LAST 20 SECONDS</span><span id="gmm"></span><div id="graph"><canvas id="vfps"/><div class="gb" id="b1" style="left: 0px;"></div><div class="gb" id="b2" style="left: 4px;"></div><div class="gb" id="b3" style="left: 8px;"></div><div class="gb" id="b4" style="left: 12px;"></div><div class="gb" id="b5" style="left: 16px;"></div><div class="gb" id="b6" style="left: 20px;"></div><div class="gb" id="b7" style="left: 24px;"></div><div class="gb" id="b8" style="left: 28px;"></div><div class="gb" id="b9" style="left: 32px;"></div><div class="gb" id="b10" style="left: 36px;"></div><div class="gb" id="b11" style="left: 40px;"></div><div class="gb" id="b12" style="left: 44px;"></div><div class="gb" id="b13" style="left: 48px;"></div><div class="gb" id="b14" style="left: 52px;"></div><div class="gb" id="b15" style="left: 56px;"></div><div class="gb" id="b16" style="left: 60px;"></div><div class="gb" id="b17" style="left: 64px;"></div><div class="gb" id="b18" style="left: 68px;"></div><div class="gb" id="b19" style="left: 72px;"></div><div class="gb" id="b20" style="left: 76px;"></div><div class="gb" id="b21" style="left: 80px;"></div><div class="gb" id="b22" style="left: 84px;"></div><div class="gb" id="b23" style="left: 88px;"></div><div class="gb" id="b24" style="left: 92px;"></div><div class="gb" id="b25" style="left: 96px;"></div><div class="gb" id="b26" style="left: 100px;"></div><div class="gb" id="b27" style="left: 104px;"></div><div class="gb" id="b28" style="left: 108px;"></div><div class="gb" id="b29" style="left: 112px;"></div><div class="gb" id="b30" style="left: 116px;"></div><div class="gb" id="b31" style="left: 120px;"></div><div class="gb" id="b32" style="left: 124px;"></div><div class="gb" id="b33" style="left: 128px;"></div><div class="gb" id="b34" style="left: 132px;"></div><div class="gb" id="b35" style="left: 136px;"></div><div class="gb" id="b36" style="left: 140px;"></div><div class="gb" id="b37" style="left: 144px;"></div><div class="gb" id="b38" style="left: 148px;"></div><div class="gb" id="b39" style="left: 152px;"></div><div class="gb" id="b40" style="left: 156px;"></div><div class="gb" id="b41" style="left: 160px;"></div><div class="gb" id="b42" style="left: 164px;"></div><div class="gb" id="b43" style="left: 168px;"></div><div class="gb" id="b44" style="left: 172px;"></div><div class="gb" id="b45" style="left: 176px;"></div><div class="gb" id="b46" style="left: 180px;"></div><div class="gb" id="b47" style="left: 184px;"></div><div class="gb" id="b48" style="left: 188px;"></div><div class="gb" id="b49" style="left: 192px;"></div><div class="gb" id="b50" style="left: 196px;"></div><div class="gb" id="b51" style="left: 200px;"></div><div class="gb" id="b52" style="left: 204px;"></div><div class="gb" id="b53" style="left: 208px;"></div><div class="gb" id="b54" style="left: 212px;"></div><div class="gb" id="b55" style="left: 216px;"></div><div class="gb" id="b56" style="left: 220px;"></div><div class="gb" id="b57" style="left: 224px;"></div><div class="gb" id="b58" style="left: 228px;"></div><div class="gb" id="b59" style="left: 232px;"></div><div class="gb" id="b60" style="left: 236px;"></div><div class="gb" id="b61" style="left: 240px;"></div><div class="gb" id="b62" style="left: 244px;"></div><div class="gb" id="b63" style="left: 248px;"></div><div class="gb" id="b64" style="left: 252px;"></div><div class="gb" id="b65" style="left: 256px;"></div><div class="gb" id="b66" style="left: 260px;"></div><div class="gb" id="b67" style="left: 264px;"></div><div class="gb" id="b68" style="left: 268px;"></div><div class="gb" id="b69" style="left: 272px;"></div><div class="gb" id="b70" style="left: 276px;"></div><div class="gb" id="b71" style="left: 280px;"></div><div class="gb" id="b72" style="left: 284px;"></div><div class="gb" id="b73" style="left: 288px;"></div><div class="gb" id="b74" style="left: 292px;"></div><div class="gb" id="b75" style="left: 296px;"></div><div class="gb" id="b76" style="left: 300px;"></div><div class="gb" id="b77" style="left: 304px;"></div><div class="gb" id="b78" style="left: 308px;"></div><div class="gb" id="b79" style="left: 312px;"></div><div class="gb" id="b80" style="left: 316px;"></div><div class="gl" id="gl_good"></div><div class="gl" id="gl_ok"></div><span class="glab" id="glab_good"></span><span class="glab" id="glab_ok"></span><div id="gcur"></div></div></div>
 <div class="tile" id="t_cpu"><span class="tk">CPU <span class="tu">eqgame</span></span><div class="tv" id="cpu">--</div><div class="td" id="cpud">measuring</div></div><div class="tile" id="t_gpu"><span class="tk">GPU <span class="tu">eqgame 3D</span></span><div class="tv" id="gpu">--</div><div class="td" id="gpud">starting</div></div><div class="tile" id="t_vram"><span class="tk">VRAM <span class="tu">eqgame</span></span><div class="tv" id="vram">--</div><div class="td" id="vramd">starting</div></div>
 <div class="tile" id="htile"><span class="tk">CPU / GPU &#183; LAST 40 SECONDS</span><span id="hmm"></span><div id="hgraph"><canvas id="vhw"/><span class="hlab" id="hlab_c">CPU</span><span class="hlab" id="hlab_g">GPU</span><div id="hnote">Needs MQ2RmlUi canvas API 4 for this graph</div></div></div>
 <div class="tile" id="t_mem"><span class="tk">LUA MEMORY</span><div class="tv" id="mem">--</div><div class="td" id="memd">this script</div></div><div class="tile" id="t_zone"><span class="tk">ZONE</span><div class="tv" id="zone">--</div><div class="td" id="zoned"></div></div><div class="tile" id="t_ui"><span class="tk" id="uik">LUA SCRIPTS</span><div class="tv" id="ui">--</div><div class="td" id="uid"></div></div>
 <div class="tile" id="scr"><span class="tk" id="sch">LUA SCRIPTS</span><span id="scmore"></span><div class="sc empty" id="s1" style="left: 10px; top: 22px;"><span class="sd"></span><span id="s1n"></span> <span class="sp" id="s1p"></span></div><div class="sc empty" id="s2" style="left: 172px; top: 22px;"><span class="sd"></span><span id="s2n"></span> <span class="sp" id="s2p"></span></div><div class="sc empty" id="s3" style="left: 10px; top: 37px;"><span class="sd"></span><span id="s3n"></span> <span class="sp" id="s3p"></span></div><div class="sc empty" id="s4" style="left: 172px; top: 37px;"><span class="sd"></span><span id="s4n"></span> <span class="sp" id="s4p"></span></div><div class="sc empty" id="s5" style="left: 10px; top: 52px;"><span class="sd"></span><span id="s5n"></span> <span class="sp" id="s5p"></span></div><div class="sc empty" id="s6" style="left: 172px; top: 52px;"><span class="sd"></span><span id="s6n"></span> <span class="sp" id="s6p"></span></div></div>
 <div class="tile" id="ab"><div id="hint" class="idle">Start or stop a script to see what it costs.</div>
  <div id="abb"><div class="btn" id="a-ab" action="ab">Mark baseline</div><div class="btn" id="a-reset" action="reset">Reset lows</div><div class="btn" id="a-rec" action="rec">&#9679; Rec</div></div></div>
</div>
<div id="setp">
 <div class="row click" id="a-opt:compact" action="opt:compact"><span class="rl">Compact mode</span><span class="rd">Small pill: FPS, frame time and 1% low only</span><div class="sw" id="sw_compact"><div class="kn"></div></div></div>
 <div class="row click" id="a-opt:locked" action="opt:locked"><span class="rl">Lock position</span><span class="rd">Stops the meter from being dragged by accident</span><div class="sw" id="sw_locked"><div class="kn"></div></div></div>
 <div class="row tall"><span class="rl">Background</span><div class="chips"><div class="chip" id="a-mode:full" action="mode:full">Solid</div><div class="chip" id="a-mode:clear" action="mode:clear">See-through</div><div class="chip" id="a-mode:hover" action="mode:hover">Show on hover</div></div></div>
 <div class="row"><span class="rl">Colour thresholds</span><span class="rd" id="thrd" style="right: 140px;">Green 60+ fps, yellow 30+</span>
  <div class="stp"><div class="sa" id="a-thr:-" action="thr:-">&#8249;</div><span class="sv" id="thrv">60 / 30</span><div class="sa" id="a-thr:+" action="thr:+">&#8250;</div></div></div>
 <div class="row tall2"><span class="rl">Position</span><div class="chips"><div class="chip" id="a-corner:free" action="corner:free">Free</div><div class="chip" id="a-corner:tl" action="corner:tl">Top left</div><div class="chip" id="a-corner:tr" action="corner:tr">Top right</div><div class="chip" id="a-corner:bl" action="corner:bl">Bottom left</div><div class="chip" id="a-corner:br" action="corner:br">Bottom right</div></div></div>
 <div class="row click" id="a-opt:viz" action="opt:viz"><span class="rl">Visualizer graphs</span><span class="rd" id="vizd">Animated bars, peak caps and glow</span><div class="sw" id="sw_viz"><div class="kn"></div></div></div>
 <div class="row click" id="a-opt:gpu" action="opt:gpu"><span class="rl">GPU and VRAM stats</span><span class="rd" id="gpud2">Hidden idle-priority sampler</span><div class="sw" id="sw_gpu"><div class="kn"></div></div></div>
 <div class="row click" id="a-opt:rec" action="opt:rec"><span class="rl">Record to CSV</span><span class="rd" id="recd">One row per second to Logs</span><div class="sw" id="sw_rec"><div class="kn"></div></div></div>
 <div id="sbtns"><div class="btn" id="a-ab2" action="ab">A/B baseline</div><div class="btn" id="a-reset2" action="reset">Reset lows</div><div class="btn red" id="a-stop2" action="stop">Stop meter</div></div>
 <div id="snote">Saved in config/rmlfps.ini. Right-click the meter to jump here.</div>
</div>
<div id="cbox"><div class="grip" id="cgrip" drag="1"></div><div id="cfps">--</div><span id="cu">FPS</span><div id="cms">-- ms</div><div id="cl1"></div>
 <div class="ib" id="a-expand" action="expand">&#8599;</div></div>
</body></rml>
