<rml><head><title>PocketFarm</title><link type="text/rcss" href="pocketfarm.rcss"/></head><body id="body">
<div id="root"><div class="bgl"></div><div class="bgv"></div><div class="bgg"></div><div class="trim"></div><div class="cn tl"></div><div class="cn tr"></div><div class="cn bl"></div><div class="cn br"></div>
<div id="hdr" drag="1"><div class="hbar"><div class="hgl"></div></div><div class="seal"></div><div class="hname"><span class="htitle">PocketFarm</span><span class="hsub" id="hsub">Farming and SpawnWatch</span></div><div class="hright"><span class="zchip"><span class="ic i_tent"></span><span id="hzone">zone</span></span><span class="hbtn" id="bclear" action="clear"><span class="bl" id="bclearl">See-through</span></span><span class="xb" id="bx" action="close"><span class="ii i_x"></span></span></div></div>
<div id="ribbon"><span class="pill" id="pfarm"><span class="pd"></span><span id="tfarm">Paused</span></span><span class="pill" id="prest"><span class="pd"></span><span id="trest">Ready</span></span><span class="pill" id="pcamp"><span class="pd"></span><span id="tcamp">Roaming</span></span><span class="rstat" id="rstat"></span></div>
<div id="pages">
<div class="page" id="pg-farm">
<div class="card gauges"><div class="ct">YOUR RESOURCES</div>
<div class="gauge ghp"><span class="gl">Health</span><div class="gt"><div class="gf" id="ghp"></div><div class="gs"></div></div><span class="gv" id="vhp">0%</span></div>
<div class="gauge gmp"><span class="gl">Mana</span><div class="gt"><div class="gf" id="gmp"></div><div class="gs"></div></div><span class="gv" id="vmp">0%</span></div>
<div class="gauge gen"><span class="gl">Endurance</span><div class="gt"><div class="gf" id="gen"></div><div class="gs"></div></div><span class="gv" id="ven">0%</span></div>
</div>
<div class="card ctl"><div class="ct">FARMING</div><div class="crow"><span class="big go" id="bgo" action="go"><span class="ic i_d_play"></span><span class="bl" id="bgol">Start farming</span></span><span class="big stop" id="bpause" action="pause"><span class="ic i_pause"></span><span class="bl" id="bpausel">Pause</span></span></div><div class="crow sm"><span class="btn" id="bini" action="ini"><span class="ic i_reload"></span><span class="bl" id="binil">Reload zone settings</span></span><span class="btn" id="bscan" action="scan"><span class="ic i_radar"></span><span class="bl" id="bscanl">Scan now</span></span><span class="btn" id="blist" action="alerts"><span class="ic i_list"></span><span class="bl" id="blistl">Show alert lists</span></span></div></div>
<div class="card tgt" id="ctgt"><div class="ct">FARMING TARGET</div><span class="ic tic i_target"></span><div class="tname" id="tname">None</div><div class="tmeta" id="tmeta">Waiting for a pull</div><div class="tbar"><div class="tfill" id="tfill"></div></div><span class="thp" id="thp"></span></div>
<div class="card quick"><div class="ct"><span id="qtitle">SPAWNWATCH</span><span class="ctr" id="qstat"></span></div>
<div class="qrow" id="q1"><span class="qn" id="qn1"></span><span class="qd" id="qd1"></span><span class="qh" id="qh1"></span><span class="ib" id="qt1" action="qt:1"><span class="ii i_target"></span></span><span class="ib nv" id="qv1" action="qv:1"><span class="ii i_nav"></span></span></div>
<div class="qrow" id="q2"><span class="qn" id="qn2"></span><span class="qd" id="qd2"></span><span class="qh" id="qh2"></span><span class="ib" id="qt2" action="qt:2"><span class="ii i_target"></span></span><span class="ib nv" id="qv2" action="qv:2"><span class="ii i_nav"></span></span></div>
<div class="qrow" id="q3"><span class="qn" id="qn3"></span><span class="qd" id="qd3"></span><span class="qh" id="qh3"></span><span class="ib" id="qt3" action="qt:3"><span class="ii i_target"></span></span><span class="ib nv" id="qv3" action="qv:3"><span class="ii i_nav"></span></span></div>
<div class="qrow" id="q4"><span class="qn" id="qn4"></span><span class="qd" id="qd4"></span><span class="qh" id="qh4"></span><span class="ib" id="qt4" action="qt:4"><span class="ii i_target"></span></span><span class="ib nv" id="qv4" action="qv:4"><span class="ii i_nav"></span></span></div>
<div class="qrow" id="q5"><span class="qn" id="qn5"></span><span class="qd" id="qd5"></span><span class="qh" id="qh5"></span><span class="ib" id="qt5" action="qt:5"><span class="ii i_target"></span></span><span class="ib nv" id="qv5" action="qv:5"><span class="ii i_nav"></span></span></div>
<div class="qempty" id="qempty">Nothing up right now.</div><div class="qmore" id="qmore"></div></div>
</div>
<div class="page inp" id="pg-spawns"><div class="card add"><div class="ct">WATCH A SPAWN IN <span id="szone">ZONE</span></div><div class="arow"><input type="text" id="iwatch" class="fin wide" value=""/><span class="btn go" id="badd" action="wadd"><span class="ic i_plus"></span><span class="bl" id="baddl">Add to watchlist</span></span><span class="btn" id="bscan2" action="scan"><span class="ic i_radar"></span><span class="bl" id="bscan2l">Scan</span></span></div><div class="hint">Type a name (for example "a fire beetle") or any spawn search.</div></div>
<div class="sortbar"><span class="sl">Sort by</span><span class="chip" id="so-name" action="sort:name"><span class="bl">Name</span><span class="sa" id="sa-name"></span></span><span class="chip" id="so-dist" action="sort:dist"><span class="bl">Distance</span><span class="sa" id="sa-dist"></span></span><span class="chip" id="so-up" action="sort:up"><span class="bl">Health</span><span class="sa" id="sa-up"></span></span><span class="scount" id="scount"></span></div>
<div class="slist">
<div class="srow" id="s1"><span class="sn" id="sn1"></span><span class="lv" id="sl1"></span><span class="sh" id="sh1"></span><span class="sd" id="sd1"></span><span class="sc" id="sc1"></span><span class="ib wt" id="sw1" action="sw:1"><span class="ii i_watch"></span></span><span class="ib ig" id="si1" action="si:1"><span class="ii i_ban"></span></span><span class="ib" id="st1" action="st:1"><span class="ii i_target"></span></span><span class="ib nv" id="sv1" action="sv:1"><span class="ii i_nav"></span></span></div>
<div class="srow" id="s2"><span class="sn" id="sn2"></span><span class="lv" id="sl2"></span><span class="sh" id="sh2"></span><span class="sd" id="sd2"></span><span class="sc" id="sc2"></span><span class="ib wt" id="sw2" action="sw:2"><span class="ii i_watch"></span></span><span class="ib ig" id="si2" action="si:2"><span class="ii i_ban"></span></span><span class="ib" id="st2" action="st:2"><span class="ii i_target"></span></span><span class="ib nv" id="sv2" action="sv:2"><span class="ii i_nav"></span></span></div>
<div class="srow" id="s3"><span class="sn" id="sn3"></span><span class="lv" id="sl3"></span><span class="sh" id="sh3"></span><span class="sd" id="sd3"></span><span class="sc" id="sc3"></span><span class="ib wt" id="sw3" action="sw:3"><span class="ii i_watch"></span></span><span class="ib ig" id="si3" action="si:3"><span class="ii i_ban"></span></span><span class="ib" id="st3" action="st:3"><span class="ii i_target"></span></span><span class="ib nv" id="sv3" action="sv:3"><span class="ii i_nav"></span></span></div>
<div class="srow" id="s4"><span class="sn" id="sn4"></span><span class="lv" id="sl4"></span><span class="sh" id="sh4"></span><span class="sd" id="sd4"></span><span class="sc" id="sc4"></span><span class="ib wt" id="sw4" action="sw:4"><span class="ii i_watch"></span></span><span class="ib ig" id="si4" action="si:4"><span class="ii i_ban"></span></span><span class="ib" id="st4" action="st:4"><span class="ii i_target"></span></span><span class="ib nv" id="sv4" action="sv:4"><span class="ii i_nav"></span></span></div>
<div class="srow" id="s5"><span class="sn" id="sn5"></span><span class="lv" id="sl5"></span><span class="sh" id="sh5"></span><span class="sd" id="sd5"></span><span class="sc" id="sc5"></span><span class="ib wt" id="sw5" action="sw:5"><span class="ii i_watch"></span></span><span class="ib ig" id="si5" action="si:5"><span class="ii i_ban"></span></span><span class="ib" id="st5" action="st:5"><span class="ii i_target"></span></span><span class="ib nv" id="sv5" action="sv:5"><span class="ii i_nav"></span></span></div>
<div class="srow" id="s6"><span class="sn" id="sn6"></span><span class="lv" id="sl6"></span><span class="sh" id="sh6"></span><span class="sd" id="sd6"></span><span class="sc" id="sc6"></span><span class="ib wt" id="sw6" action="sw:6"><span class="ii i_watch"></span></span><span class="ib ig" id="si6" action="si:6"><span class="ii i_ban"></span></span><span class="ib" id="st6" action="st:6"><span class="ii i_target"></span></span><span class="ib nv" id="sv6" action="sv:6"><span class="ii i_nav"></span></span></div>
<div class="srow" id="s7"><span class="sn" id="sn7"></span><span class="lv" id="sl7"></span><span class="sh" id="sh7"></span><span class="sd" id="sd7"></span><span class="sc" id="sc7"></span><span class="ib wt" id="sw7" action="sw:7"><span class="ii i_watch"></span></span><span class="ib ig" id="si7" action="si:7"><span class="ii i_ban"></span></span><span class="ib" id="st7" action="st:7"><span class="ii i_target"></span></span><span class="ib nv" id="sv7" action="sv:7"><span class="ii i_nav"></span></span></div>
<div class="srow" id="s8"><span class="sn" id="sn8"></span><span class="lv" id="sl8"></span><span class="sh" id="sh8"></span><span class="sd" id="sd8"></span><span class="sc" id="sc8"></span><span class="ib wt" id="sw8" action="sw:8"><span class="ii i_watch"></span></span><span class="ib ig" id="si8" action="si:8"><span class="ii i_ban"></span></span><span class="ib" id="st8" action="st:8"><span class="ii i_target"></span></span><span class="ib nv" id="sv8" action="sv:8"><span class="ii i_nav"></span></span></div>
<div class="srow" id="s9"><span class="sn" id="sn9"></span><span class="lv" id="sl9"></span><span class="sh" id="sh9"></span><span class="sd" id="sd9"></span><span class="sc" id="sc9"></span><span class="ib wt" id="sw9" action="sw:9"><span class="ii i_watch"></span></span><span class="ib ig" id="si9" action="si:9"><span class="ii i_ban"></span></span><span class="ib" id="st9" action="st:9"><span class="ii i_target"></span></span><span class="ib nv" id="sv9" action="sv:9"><span class="ii i_nav"></span></span></div>
<div class="srow" id="s10"><span class="sn" id="sn10"></span><span class="lv" id="sl10"></span><span class="sh" id="sh10"></span><span class="sd" id="sd10"></span><span class="sc" id="sc10"></span><span class="ib wt" id="sw10" action="sw:10"><span class="ii i_watch"></span></span><span class="ib ig" id="si10" action="si:10"><span class="ii i_ban"></span></span><span class="ib" id="st10" action="st:10"><span class="ii i_target"></span></span><span class="ib nv" id="sv10" action="sv:10"><span class="ii i_nav"></span></span></div>
<div class="sempty" id="sempty">Nothing up yet. Press Scan, or add a spawn to the watchlist.</div></div>
<div class="pager"><span class="pgb" id="sprev" action="sp:prev"><span class="ii i_chl"></span></span><span class="pgt" id="spage">Page 1 of 1</span><span class="pgb" id="snext" action="sp:next"><span class="ii i_chr"></span></span></div></div>
<div class="page" id="pg-watch"><div class="card timers"><div class="ct">RESPAWN TIMERS<span class="ctr"><span class="btn sm red" id="btclr" action="tclear"><span class="ic i_trash"></span><span class="bl" id="btclrl">Clear all</span></span></span></div>
<div class="trow" id="t1"><span class="ic i_hourglass"></span><span class="tn" id="tn1"></span><span class="tstate" id="ts1"></span><span class="ib rd" id="tx1" action="tx:1"><span class="ii i_x"></span></span></div>
<div class="trow" id="t2"><span class="ic i_hourglass"></span><span class="tn" id="tn2"></span><span class="tstate" id="ts2"></span><span class="ib rd" id="tx2" action="tx:2"><span class="ii i_x"></span></span></div>
<div class="trow" id="t3"><span class="ic i_hourglass"></span><span class="tn" id="tn3"></span><span class="tstate" id="ts3"></span><span class="ib rd" id="tx3" action="tx:3"><span class="ii i_x"></span></span></div>
<div class="trow" id="t4"><span class="ic i_hourglass"></span><span class="tn" id="tn4"></span><span class="tstate" id="ts4"></span><span class="ib rd" id="tx4" action="tx:4"><span class="ii i_x"></span></span></div>
<div class="trow" id="t5"><span class="ic i_hourglass"></span><span class="tn" id="tn5"></span><span class="tstate" id="ts5"></span><span class="ib rd" id="tx5" action="tx:5"><span class="ii i_x"></span></span></div>
<div class="trow" id="t6"><span class="ic i_hourglass"></span><span class="tn" id="tn6"></span><span class="tstate" id="ts6"></span><span class="ib rd" id="tx6" action="tx:6"><span class="ii i_x"></span></span></div>
<div class="qempty" id="tempty">No active timers. A timer starts when a watched spawn drops off.</div><div class="qmore" id="tmore"></div></div>
<div class="card wl"><div class="ct">WATCHLIST<span class="ctr"><span class="btn sm red" id="bwclr" action="wclear"><span class="ic i_trash"></span><span class="bl" id="bwclrl">Clear this zone</span></span></span></div><div class="zsel"><span class="pgb" id="wprev" action="wz:prev"><span class="ii i_chl"></span></span><span class="zname" id="wzone">No zones yet</span><span class="pgb" id="wnext" action="wz:next"><span class="ii i_chr"></span></span></div>
<div class="wrow" id="w1"><span class="ic i_eye"></span><span class="wq" id="wq1"></span><span class="ib rd" id="wd1" action="wd:1"><span class="ii i_trash"></span></span></div>
<div class="wrow" id="w2"><span class="ic i_eye"></span><span class="wq" id="wq2"></span><span class="ib rd" id="wd2" action="wd:2"><span class="ii i_trash"></span></span></div>
<div class="wrow" id="w3"><span class="ic i_eye"></span><span class="wq" id="wq3"></span><span class="ib rd" id="wd3" action="wd:3"><span class="ii i_trash"></span></span></div>
<div class="wrow" id="w4"><span class="ic i_eye"></span><span class="wq" id="wq4"></span><span class="ib rd" id="wd4" action="wd:4"><span class="ii i_trash"></span></span></div>
<div class="wrow" id="w5"><span class="ic i_eye"></span><span class="wq" id="wq5"></span><span class="ib rd" id="wd5" action="wd:5"><span class="ii i_trash"></span></span></div>
<div class="wrow" id="w6"><span class="ic i_eye"></span><span class="wq" id="wq6"></span><span class="ib rd" id="wd6" action="wd:6"><span class="ii i_trash"></span></span></div>
<div class="wrow" id="w7"><span class="ic i_eye"></span><span class="wq" id="wq7"></span><span class="ib rd" id="wd7" action="wd:7"><span class="ii i_trash"></span></span></div>
<div class="qempty" id="wempty">Watchlist empty. Add spawns on the Spawns page.</div><div class="qmore" id="wmore"></div></div></div>
<div class="page inp" id="pg-set"><div class="scol l">
<div class="card"><div class="ct">SEARCH AREA</div><div class="nrow"><span class="nl">Pull radius</span><span class="nv" id="nr">0</span><input type="text" id="ir" class="fin num" value=""/><span class="btn go sm" id="bsetr" action="set:r"><span class="bl" id="bsetrl">Set</span></span></div><div class="nrow"><span class="nl">Height radius</span><span class="nv" id="nz">0</span><input type="text" id="iz" class="fin num" value=""/><span class="btn go sm" id="bsetz" action="set:z"><span class="bl" id="bsetzl">Set</span></span></div></div>
<div class="card camp"><div class="ct">CAMP</div><div class="campt" id="campt">Camp is off. You roam freely.</div><span class="btn go" id="bcamp" action="camp"><span class="ic i_tent"></span><span class="bl" id="bcampl">Set camp here</span></span></div>
<div class="card"><div class="ct">OPTIONS</div>
<div class="tog" id="o-debug" action="opt:debug"><span class="sw"><span class="kn"></span></span><span class="tl">Debug messages in the log</span></div>
<div class="tog" id="o-alerts" action="opt:alerts"><span class="sw"><span class="kn"></span></span><span class="tl">Alert when a watched spawn is up</span></div>
<div class="tog" id="o-auto" action="opt:auto"><span class="sw"><span class="kn"></span></span><span class="tl">Scan spawns every 5 seconds</span></div>
<div class="tog" id="o-zone" action="opt:zone"><span class="sw"><span class="kn"></span></span><span class="tl">Scan the whole zone, not only the watchlist</span></div>
<div class="tog" id="o-clear" action="opt:clear"><span class="sw"><span class="kn"></span></span><span class="tl">See-through window</span></div>
<div class="tog" id="o-btn" action="opt:btn"><span class="sw"><span class="kn"></span></span><span class="tl">Show launcher button when closed</span></div>
</div></div><div class="scol r">
<div class="card lists"><div class="ct">IGNORE AND PULL LISTS</div><div class="lhead"><span class="nl ign">Ignore</span><span class="lk">Now:</span><span class="lnow" id="curig"></span></div><div class="lrow"><input type="text" id="iig" class="fin lst" value=""/><span class="btn sm red" id="baddig" action="ladd:ig"><span class="bl" id="baddigl">Add</span></span><span class="btn sm" id="bclrig" action="lclr:ig"><span class="bl" id="bclrigl">Clear</span></span></div><div class="lhead"><span class="nl pul">Pull only</span><span class="lk">Now:</span><span class="lnow" id="curpl"></span></div><div class="lrow"><input type="text" id="ipl" class="fin lst" value=""/><span class="btn sm go" id="baddpl" action="ladd:pl"><span class="bl" id="baddpll">Add</span></span><span class="btn sm" id="bclrpl" action="lclr:pl"><span class="bl" id="bclrpll">Clear</span></span></div><div class="hint">Pull "ALL" means every mob in range. Names are saved per zone.</div></div>
<div class="card"><div class="ct">WINDOW</div><div class="hint">Drag the window by its header. The spot is saved for this character.</div><div class="crow sm"><span class="btn" id="breset" action="resetpos"><span class="ic i_reload"></span><span class="bl" id="bresetl">Reset position</span></span><span class="btn red" id="bstop" action="stop"><span class="ic i_x"></span><span class="bl" id="bstopl">Stop PocketFarm</span></span></div></div>
<div class="card"><div class="ct">ABOUT</div><div class="hint">PocketFarm v3.5 engine by Kaen01, RmlUi edition. Commands stay available as /pkf aliases.</div></div>
</div></div>
<div class="page" id="pg-log"><div class="logbar"><span class="btn sm" id="blclr" action="logclear"><span class="ic i_trash"></span><span class="bl" id="blclrl">Clear log</span></span><span class="lcount" id="lcount">0 lines</span><span class="lpg"><span class="pgb" id="lold" action="log:old"><span class="ii i_up"></span></span><span class="btn sm" id="lfol" action="log:follow"><span class="bl" id="lfoll">Newest</span></span><span class="pgb" id="lnew" action="log:new"><span class="ii i_dn"></span></span></span></div><div class="card logbox">
<div class="ll" id="l1"></div>
<div class="ll" id="l2"></div>
<div class="ll" id="l3"></div>
<div class="ll" id="l4"></div>
<div class="ll" id="l5"></div>
<div class="ll" id="l6"></div>
<div class="ll" id="l7"></div>
<div class="ll" id="l8"></div>
<div class="ll" id="l9"></div>
<div class="ll" id="l10"></div>
<div class="ll" id="l11"></div>
<div class="ll" id="l12"></div>
<div class="ll" id="l13"></div>
<div class="ll" id="l14"></div>
<div class="ll" id="l15"></div>
<div class="ll" id="l16"></div>
<div class="ll" id="l17"></div>
<div class="ll" id="l18"></div>
<div class="ll" id="l19"></div>
</div></div>
</div>
<div id="dock"><div class="dbar"></div><span class="dk" id="d-farm" action="tab:farm"><span class="di i_wheat"></span><span class="bl">Farm</span></span><span class="dk" id="d-spawns" action="tab:spawns"><span class="di i_radar"></span><span class="bl">Spawns</span></span><span class="dk" id="d-watch" action="tab:watch"><span class="di i_hourglass"></span><span class="bl">Timers</span></span><span class="dk" id="d-set" action="tab:set"><span class="di i_gear"></span><span class="bl">Settings</span></span><span class="dk" id="d-log" action="tab:log"><span class="di i_scroll"></span><span class="bl">Log</span></span></div>
</div></body></rml>
