<rml><head><title>CombatFx XP</title><link type="text/rcss" href="cfxui.rcss"/></head><body id="body"><div class="shell"><div class="g0"></div><div class="g1"></div><div class="g2"></div><div class="hd sm" drag="1"><img class="hico" src="../img/ic_xp_64.png"/><span class="htt">Experience</span><div class="hbtns"><div class="hb" action="reset" id="a-reset">Reset</div><div class="hb x" action="close" id="a-close">&#215;</div></div></div><div class="tw"><div class="xbar"><div class="xfill" id="xpf"></div><div class="xsh"></div><div class="tick" style="left: 10%;"></div><div class="tick" style="left: 20%;"></div><div class="tick" style="left: 30%;"></div><div class="tick" style="left: 40%;"></div><div class="tick" style="left: 50%;"></div><div class="tick" style="left: 60%;"></div><div class="tick" style="left: 70%;"></div><div class="tick" style="left: 80%;"></div><div class="tick" style="left: 90%;"></div><div class="xlab" id="xpl"></div></div><div class="xbar"><div class="xfill" id="aaf"></div><div class="xsh"></div><div class="tick" style="left: 10%;"></div><div class="tick" style="left: 20%;"></div><div class="tick" style="left: 30%;"></div><div class="tick" style="left: 40%;"></div><div class="tick" style="left: 50%;"></div><div class="tick" style="left: 60%;"></div><div class="tick" style="left: 70%;"></div><div class="tick" style="left: 80%;"></div><div class="tick" style="left: 90%;"></div><div class="xlab" id="aal"></div></div><div class="tiles"><div class="tl"><img src="../img/ic_xp_32.png"/><span class="tv" id="xph"></span><span class="tk">Level % per hour</span></div><div class="tl c2"><img src="../img/ic_aa_32.png"/><span class="tv" id="aah"></span><span class="tk">AA per hour</span></div><div class="tl"><img src="../img/ic_ttl_32.png"/><span class="tv" id="ttl"></span><span class="tk">Next level in</span></div><div class="tl c2"><img src="../img/ic_ses_32.png"/><span class="tv" id="ses"></span><span class="tk" id="sesk">Session time</span></div></div></div></div></body></rml>
