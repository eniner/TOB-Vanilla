/* combatfx XP + loot trackers: static styles only, no animations, no blur */
.tw { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 6px 10px; }
.th { height: 18px; line-height: 18px; white-space: nowrap; font-weight: bold; font-size: 12px; color: #f2edff; }
.th .b { float: right; height: 16px; line-height: 16px; padding: 0px 6px; margin: 0px 0px 0px 3px; font-size: 10px; }
.bar { position: relative; height: 12px; margin: 3px 0px 1px 0px; background-color: #00000090; border: 1px #3a3f62; border-radius: 3px; }
.fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0%; border-radius: 2px; }
#xpf { background-color: #d8b040; } #aaf { background-color: #5aa8ff; }
.bl { position: absolute; left: 0; right: 0; top: 0; height: 12px; line-height: 12px; text-align: center; font-size: 10px; font-weight: bold; font-effect: outline(1px #000000); }
.tr { height: 16px; line-height: 16px; white-space: nowrap; font-size: 11px; overflow: hidden; }
.tk { display: inline-block; width: 64px; color: #8a93a6; }
.lr { height: 15px; line-height: 15px; white-space: nowrap; font-size: 11px; overflow: hidden; }
.unk { color: #ffc35a; }
.pp { color: #ffe08a; } .gp { color: #ffd040; } .sp { color: #c8d0e0; } .cp { color: #d08a50; }
