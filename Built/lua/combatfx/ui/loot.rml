<rml><head><title>CombatFx Loot</title><link type="text/rcss" href="cfxui.rcss"/></head><body id="body"><div class="shell"><div class="g0"></div><div class="g1"></div><div class="g2"></div><div class="hd sm" drag="1"><img class="hico" src="../img/ic_loot_64.png"/><span class="htt">Loot value</span><div class="hbtns"><div class="hb" action="reset" id="a-reset">Reset</div><div class="hb x" action="close" id="a-close">&#215;</div></div></div><div class="tw"><div class="coins" id="tot"></div><div class="tiles"><div class="tl"><img src="../img/ic_ses_32.png"/><span class="tv" id="rate"></span><span class="tk">Value per hour</span></div><div class="tl c2"><img src="../img/ic_loot_32.png"/><span class="tv" id="cnt"></span><span class="tk" id="cntk">Items looted</span></div></div><div class="clr" style="height: 0px;"></div><div class="sec">RECENT LOOT</div><div id="lrows"><div class="lrow" id="lr1"></div><div class="lrow" id="lr2"></div><div class="lrow" id="lr3"></div><div class="lrow" id="lr4"></div><div class="lrow" id="lr5"></div><div class="lrow" id="lr6"></div><div class="lrow" id="lr7"></div><div class="lrow" id="lr8"></div></div><div class="pgr"><div class="arr" action="prev" id="a-prev">&#9664;</div><span id="pg"></span><div class="arr" action="next" id="a-next">&#9654;</div></div><div class="note">Vendor value before faction and Charisma</div></div></div></body></rml>
