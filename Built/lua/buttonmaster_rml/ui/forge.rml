<rml><head><title>Button Master</title><link type="text/rcss" href="forge.rcss"/></head><body id="body"><div class="win"><div class="pbg"/><div class="pgr"/><div class="emb"/><div class="cn tl"/><div class="cn tr"/><div class="cn bl"/><div class="cn br"/><div class="head"><div class="hgl"/><div class="lava"/><div class="hdrag" drag="1"><div class="hicon"><span class="ico i-gear"/></div><span id="htitle" class="htitle">Button Master</span><span id="hsub" class="hsub">OBSIDIAN FORGE</span></div><div class="hbtns"><div id="bclear" class="hb" action="clear"><span class="ico i-eye"/></div><div id="bx" class="hb" action="close"><span class="ico i-x"/></div></div></div><div class="tabs"><span id="tab-bars" class="tab" action="tab:bars"><span class="ico i-gear"/>Bars</span><span id="tab-sets" class="tab" action="tab:sets"><span class="ico i-scroll"/>Sets</span><span id="tab-lib" class="tab" action="tab:lib"><span class="ico i-star"/>Buttons</span><span id="tab-share" class="tab" action="tab:share"><span class="ico i-arrowup"/>Share</span><span id="tab-fx" class="tab" action="tab:fx"><span class="ico i-flame"/>Effects</span><span id="tab-sim" class="tab" action="tab:sim"><span class="ico i-play"/>Simulator</span></div><div class="crack"/><div id="pg-bars" class="page inp"><div><span id="bar1" class="chip" action="bar:1">Bar 1</span><span id="bar2" class="chip" action="bar:2">Bar 2</span><span id="bar3" class="chip" action="bar:3">Bar 3</span><span id="bar4" class="chip" action="bar:4">Bar 4</span><span id="bar5" class="chip" action="bar:5">Bar 5</span><span id="bar6" class="chip" action="bar:6">Bar 6</span><span id="bar7" class="chip" action="bar:7">Bar 7</span><span id="bar8" class="chip" action="bar:8">Bar 8</span><span id="bnew" class="chip" action="newbar">+ New bar</span></div><div class="card" style="left:0;top:34px;width:300px;height:226px;"><span class="cap">DISPLAY</span><div class="opt"><div id="o-vis" class="tg" action="o:vis"><div class="kn"/><span class="cl">ON</span><span class="clo">off</span></div><span class="tx">Show this bar</span></div><div class="opt"><div id="o-lock" class="tg" action="o:lock"><div class="kn"/><span class="cl">ON</span><span class="clo">off</span></div><span class="tx">Lock position and size</span></div><div class="opt"><div id="o-title" class="tg" action="o:title"><div class="kn"/><span class="cl">ON</span><span class="clo">off</span></div><span class="tx">Show the title strip</span></div><div class="opt"><div id="o-compact" class="tg" action="o:compact"><div class="kn"/><span class="cl">ON</span><span class="clo">off</span></div><span class="tx">Compact (first set only, no set tabs)</span></div><div class="opt"><div id="o-adv" class="tg" action="o:adv"><div class="kn"/><span class="cl">ON</span><span class="clo">off</span></div><span class="tx">Show commands in tooltips</span></div><div class="row"><span class="lbl">Bar title</span><input id="btitle" class="text" type="text" value="" style="width:180px;"/></div></div><div class="card" style="left:316px;top:34px;width:404px;height:226px;"><span class="cap">LAYOUT</span><div class="row"><span class="lbl">Columns</span><span class="btn sm" action="dec:cols">-</span><span id="vcols" class="chip on" style="width:46px;text-align:center;">0</span><span class="btn sm" action="inc:cols">+</span></div><div class="row"><span class="lbl">Rows</span><span class="btn sm" action="dec:rows">-</span><span id="vrows" class="chip on" style="width:46px;text-align:center;">0</span><span class="btn sm" action="inc:rows">+</span></div><div class="row"><span class="lbl">Button size</span><span class="btn sm" action="dec:size">-</span><span id="vsize" class="chip on" style="width:46px;text-align:center;">0</span><span class="btn sm" action="inc:size">+</span></div><div class="row"><span class="lbl">Spacing</span><span class="btn sm" action="dec:gap">-</span><span id="vgap" class="chip on" style="width:46px;text-align:center;">0</span><span class="btn sm" action="inc:gap">+</span></div><div class="row"><span class="lbl">Theme</span><span id="th-forge" class="chip" action="theme:forge">Forge</span><span id="th-arcane" class="chip" action="theme:arcane">Arcane</span><span id="th-steel" class="chip" action="theme:steel">Steel</span><span id="th-ember" class="chip" action="theme:ember">Ember</span><span id="th-none" class="chip" action="theme:none">None</span></div><div class="row"><span class="lbl">Refresh</span><span id="fps1" class="chip" action="fps:1">Instant</span><span id="fps2" class="chip" action="fps:2">10 per sec</span><span id="fps3" class="chip" action="fps:3">4 per sec</span><span id="fps4" class="chip" action="fps:4">1 per sec</span></div></div><div class="card" style="left:0;top:274px;width:720px;height:132px;"><span class="cap">SETS ON THIS BAR (shown as tabs)</span><div style="position:absolute;left:8px;top:26px;width:360px;"><div id="bs1" class="lrow off"><span id="bsn1" class="nm"></span><span class="acts"><span class="btn sm" action="bsu:1">Up</span><span class="btn sm" action="bsd:1">Down</span><span class="btn sm red" action="bsx:1">Remove</span></span></div><div id="bs2" class="lrow off"><span id="bsn2" class="nm"></span><span class="acts"><span class="btn sm" action="bsu:2">Up</span><span class="btn sm" action="bsd:2">Down</span><span class="btn sm red" action="bsx:2">Remove</span></span></div><div id="bs3" class="lrow off"><span id="bsn3" class="nm"></span><span class="acts"><span class="btn sm" action="bsu:3">Up</span><span class="btn sm" action="bsd:3">Down</span><span class="btn sm red" action="bsx:3">Remove</span></span></div><span id="bsmore" class="dim" style="font-size:11px;"></span></div><div style="position:absolute;left:380px;top:26px;width:332px;"><span class="dim" style="display:block;font-size:11px;margin-bottom:4px;">Add a set:</span><span id="as1" class="chip" action="as:1"></span><span id="as2" class="chip" action="as:2"></span><span id="as3" class="chip" action="as:3"></span><span id="as4" class="chip" action="as:4"></span><span id="as5" class="chip" action="as:5"></span><span id="as6" class="chip" action="as:6"></span><span id="as7" class="chip" action="as:7"></span><span id="as8" class="chip" action="as:8"></span><span id="as9" class="chip" action="as:9"></span><span id="as10" class="chip" action="as:10"></span></div></div><div style="position:absolute;left:0;top:414px;"><span class="btn sm" action="resetpos">Reset bar position</span><span id="bdel" class="btn sm red" action="delbar">Delete this bar</span><span class="btn sm" action="showall">Show every bar</span></div></div><div id="pg-sets" class="page inp"><div class="card" style="left:0;top:0;width:300px;height:400px;"><span class="cap">ALL SETS</span><div id="sl1" class="lrow off" action="sl:1"><span id="sln1" class="nm"></span><span id="slm1" class="meta" style="left:220px;"></span></div><div id="sl2" class="lrow off" action="sl:2"><span id="sln2" class="nm"></span><span id="slm2" class="meta" style="left:220px;"></span></div><div id="sl3" class="lrow off" action="sl:3"><span id="sln3" class="nm"></span><span id="slm3" class="meta" style="left:220px;"></span></div><div id="sl4" class="lrow off" action="sl:4"><span id="sln4" class="nm"></span><span id="slm4" class="meta" style="left:220px;"></span></div><div id="sl5" class="lrow off" action="sl:5"><span id="sln5" class="nm"></span><span id="slm5" class="meta" style="left:220px;"></span></div><div id="sl6" class="lrow off" action="sl:6"><span id="sln6" class="nm"></span><span id="slm6" class="meta" style="left:220px;"></span></div><div id="sl7" class="lrow off" action="sl:7"><span id="sln7" class="nm"></span><span id="slm7" class="meta" style="left:220px;"></span></div><div id="sl8" class="lrow off" action="sl:8"><span id="sln8" class="nm"></span><span id="slm8" class="meta" style="left:220px;"></span></div><div id="sl9" class="lrow off" action="sl:9"><span id="sln9" class="nm"></span><span id="slm9" class="meta" style="left:220px;"></span></div><div style="position:absolute;left:8px;bottom:42px;"><span class="btn sm" action="slp:prev">Prev</span><span id="slpg" class="dim" style="font-size:11px;margin:0 6px;"></span><span class="btn sm" action="slp:next">Next</span></div><div style="position:absolute;left:8px;bottom:8px;"><input id="nset" class="text" type="text" value="" style="width:160px;"/><span class="btn sm go" action="newset" style="margin-left:6px;">Create set</span></div></div><div class="card" style="left:316px;top:0;width:404px;height:400px;"><span id="selset" class="cap">BUTTONS IN SET</span><div id="ss1" class="lrow off hasic"><img id="ssi1" class="li" src="../img/ui/none.png"/><span id="ssn1" class="nm"></span><span class="acts"><span class="btn sm" action="sse:1">Edit</span><span class="btn sm" action="ssu:1">Up</span><span class="btn sm" action="ssd:1">Down</span><span class="btn sm red" action="ssx:1">Unassign</span></span></div><div id="ss2" class="lrow off hasic"><img id="ssi2" class="li" src="../img/ui/none.png"/><span id="ssn2" class="nm"></span><span class="acts"><span class="btn sm" action="sse:2">Edit</span><span class="btn sm" action="ssu:2">Up</span><span class="btn sm" action="ssd:2">Down</span><span class="btn sm red" action="ssx:2">Unassign</span></span></div><div id="ss3" class="lrow off hasic"><img id="ssi3" class="li" src="../img/ui/none.png"/><span id="ssn3" class="nm"></span><span class="acts"><span class="btn sm" action="sse:3">Edit</span><span class="btn sm" action="ssu:3">Up</span><span class="btn sm" action="ssd:3">Down</span><span class="btn sm red" action="ssx:3">Unassign</span></span></div><div id="ss4" class="lrow off hasic"><img id="ssi4" class="li" src="../img/ui/none.png"/><span id="ssn4" class="nm"></span><span class="acts"><span class="btn sm" action="sse:4">Edit</span><span class="btn sm" action="ssu:4">Up</span><span class="btn sm" action="ssd:4">Down</span><span class="btn sm red" action="ssx:4">Unassign</span></span></div><div id="ss5" class="lrow off hasic"><img id="ssi5" class="li" src="../img/ui/none.png"/><span id="ssn5" class="nm"></span><span class="acts"><span class="btn sm" action="sse:5">Edit</span><span class="btn sm" action="ssu:5">Up</span><span class="btn sm" action="ssd:5">Down</span><span class="btn sm red" action="ssx:5">Unassign</span></span></div><div id="ss6" class="lrow off hasic"><img id="ssi6" class="li" src="../img/ui/none.png"/><span id="ssn6" class="nm"></span><span class="acts"><span class="btn sm" action="sse:6">Edit</span><span class="btn sm" action="ssu:6">Up</span><span class="btn sm" action="ssd:6">Down</span><span class="btn sm red" action="ssx:6">Unassign</span></span></div><div id="ss7" class="lrow off hasic"><img id="ssi7" class="li" src="../img/ui/none.png"/><span id="ssn7" class="nm"></span><span class="acts"><span class="btn sm" action="sse:7">Edit</span><span class="btn sm" action="ssu:7">Up</span><span class="btn sm" action="ssd:7">Down</span><span class="btn sm red" action="ssx:7">Unassign</span></span></div><div id="ss8" class="lrow off hasic"><img id="ssi8" class="li" src="../img/ui/none.png"/><span id="ssn8" class="nm"></span><span class="acts"><span class="btn sm" action="sse:8">Edit</span><span class="btn sm" action="ssu:8">Up</span><span class="btn sm" action="ssd:8">Down</span><span class="btn sm red" action="ssx:8">Unassign</span></span></div><div id="ss9" class="lrow off hasic"><img id="ssi9" class="li" src="../img/ui/none.png"/><span id="ssn9" class="nm"></span><span class="acts"><span class="btn sm" action="sse:9">Edit</span><span class="btn sm" action="ssu:9">Up</span><span class="btn sm" action="ssd:9">Down</span><span class="btn sm red" action="ssx:9">Unassign</span></span></div><div style="position:absolute;left:8px;bottom:42px;"><span class="btn sm" action="ssp:prev">Prev</span><span id="sspg" class="dim" style="font-size:11px;margin:0 6px;"></span><span class="btn sm" action="ssp:next">Next</span><span class="btn sm go" action="ssnew" style="margin-left:10px;"><span class="ico i-plus"/>New button</span></div><div style="position:absolute;left:8px;bottom:8px;"><input id="rset" class="text" type="text" value="" style="width:150px;"/><span class="btn sm" action="renset" style="margin-left:6px;">Rename</span><span id="bdset" class="btn sm red" action="delset">Delete set</span></div></div></div><div id="pg-lib" class="page inp"><div class="row"><input id="lsearch" class="text" type="text" value="" style="width:220px;"/><span id="lcount" class="dim" style="font-size:12px;margin-left:10px;line-height:26px;"></span><span class="btn sm" action="dedupe" style="margin-left:14px;">Remove duplicate buttons</span></div><div id="bl1" class="lrow off hasic"><img id="bli1" class="li" src="../img/ui/none.png"/><span id="bln1" class="nm"></span><span id="blm1" class="meta"></span><span class="acts"><span class="btn sm" action="ble:1">Edit</span><span class="btn sm" action="bla:1">Add to set</span><span class="btn sm red" action="blx:1">Delete</span></span></div><div id="bl2" class="lrow off hasic"><img id="bli2" class="li" src="../img/ui/none.png"/><span id="bln2" class="nm"></span><span id="blm2" class="meta"></span><span class="acts"><span class="btn sm" action="ble:2">Edit</span><span class="btn sm" action="bla:2">Add to set</span><span class="btn sm red" action="blx:2">Delete</span></span></div><div id="bl3" class="lrow off hasic"><img id="bli3" class="li" src="../img/ui/none.png"/><span id="bln3" class="nm"></span><span id="blm3" class="meta"></span><span class="acts"><span class="btn sm" action="ble:3">Edit</span><span class="btn sm" action="bla:3">Add to set</span><span class="btn sm red" action="blx:3">Delete</span></span></div><div id="bl4" class="lrow off hasic"><img id="bli4" class="li" src="../img/ui/none.png"/><span id="bln4" class="nm"></span><span id="blm4" class="meta"></span><span class="acts"><span class="btn sm" action="ble:4">Edit</span><span class="btn sm" action="bla:4">Add to set</span><span class="btn sm red" action="blx:4">Delete</span></span></div><div id="bl5" class="lrow off hasic"><img id="bli5" class="li" src="../img/ui/none.png"/><span id="bln5" class="nm"></span><span id="blm5" class="meta"></span><span class="acts"><span class="btn sm" action="ble:5">Edit</span><span class="btn sm" action="bla:5">Add to set</span><span class="btn sm red" action="blx:5">Delete</span></span></div><div id="bl6" class="lrow off hasic"><img id="bli6" class="li" src="../img/ui/none.png"/><span id="bln6" class="nm"></span><span id="blm6" class="meta"></span><span class="acts"><span class="btn sm" action="ble:6">Edit</span><span class="btn sm" action="bla:6">Add to set</span><span class="btn sm red" action="blx:6">Delete</span></span></div><div id="bl7" class="lrow off hasic"><img id="bli7" class="li" src="../img/ui/none.png"/><span id="bln7" class="nm"></span><span id="blm7" class="meta"></span><span class="acts"><span class="btn sm" action="ble:7">Edit</span><span class="btn sm" action="bla:7">Add to set</span><span class="btn sm red" action="blx:7">Delete</span></span></div><div id="bl8" class="lrow off hasic"><img id="bli8" class="li" src="../img/ui/none.png"/><span id="bln8" class="nm"></span><span id="blm8" class="meta"></span><span class="acts"><span class="btn sm" action="ble:8">Edit</span><span class="btn sm" action="bla:8">Add to set</span><span class="btn sm red" action="blx:8">Delete</span></span></div><div id="bl9" class="lrow off hasic"><img id="bli9" class="li" src="../img/ui/none.png"/><span id="bln9" class="nm"></span><span id="blm9" class="meta"></span><span class="acts"><span class="btn sm" action="ble:9">Edit</span><span class="btn sm" action="bla:9">Add to set</span><span class="btn sm red" action="blx:9">Delete</span></span></div><div id="bl10" class="lrow off hasic"><img id="bli10" class="li" src="../img/ui/none.png"/><span id="bln10" class="nm"></span><span id="blm10" class="meta"></span><span class="acts"><span class="btn sm" action="ble:10">Edit</span><span class="btn sm" action="bla:10">Add to set</span><span class="btn sm red" action="blx:10">Delete</span></span></div><div id="bl11" class="lrow off hasic"><img id="bli11" class="li" src="../img/ui/none.png"/><span id="bln11" class="nm"></span><span id="blm11" class="meta"></span><span class="acts"><span class="btn sm" action="ble:11">Edit</span><span class="btn sm" action="bla:11">Add to set</span><span class="btn sm red" action="blx:11">Delete</span></span></div><div><span class="btn sm" action="blp:prev">Prev</span><span id="blpg" class="dim" style="font-size:11px;margin:0 6px;"></span><span class="btn sm" action="blp:next">Next</span><span id="blto" class="dim" style="font-size:11px;margin-left:10px;"></span></div></div><div id="pg-share" class="page inp"><div class="card" style="left:0;top:0;width:720px;height:96px;"><span class="cap">SHARE A SET (copies share text to your clipboard)</span><div><span id="xs1" class="chip" action="xs:1"></span><span id="xs2" class="chip" action="xs:2"></span><span id="xs3" class="chip" action="xs:3"></span><span id="xs4" class="chip" action="xs:4"></span><span id="xs5" class="chip" action="xs:5"></span><span id="xs6" class="chip" action="xs:6"></span><span id="xs7" class="chip" action="xs:7"></span><span id="xs8" class="chip" action="xs:8"></span><span id="xs9" class="chip" action="xs:9"></span><span id="xs10" class="chip" action="xs:10"></span><span id="xs11" class="chip" action="xs:11"></span><span id="xs12" class="chip" action="xs:12"></span></div></div><div class="card" style="left:0;top:110px;width:720px;height:96px;"><span class="cap">IMPORT A BUTTON OR SET (paste share text, Ctrl+V)</span><div class="row"><input id="imp" class="text" type="text" value="" style="width:460px;"/><span class="btn sm" action="paste" style="margin-left:6px;">Paste</span><span id="bimp" class="btn sm go" action="import">Import</span></div><span id="impv" class="dim" style="font-size:11px;"></span></div><div class="card" style="left:0;top:220px;width:720px;height:186px;"><span class="cap">COPY ANOTHER CHARACTER'S BARS TO THIS CHARACTER (replaces yours)</span><div id="cl1" class="lrow off"><span id="cln1" class="nm"></span><span class="acts"><span id="clb1" class="btn sm" action="cl:1">Copy to me</span></span></div><div id="cl2" class="lrow off"><span id="cln2" class="nm"></span><span class="acts"><span id="clb2" class="btn sm" action="cl:2">Copy to me</span></span></div><div id="cl3" class="lrow off"><span id="cln3" class="nm"></span><span class="acts"><span id="clb3" class="btn sm" action="cl:3">Copy to me</span></span></div><div id="cl4" class="lrow off"><span id="cln4" class="nm"></span><span class="acts"><span id="clb4" class="btn sm" action="cl:4">Copy to me</span></span></div><div id="cl5" class="lrow off"><span id="cln5" class="nm"></span><span class="acts"><span id="clb5" class="btn sm" action="cl:5">Copy to me</span></span></div><span id="clnone" class="dim" style="font-size:11px;">No other characters in this config.</span></div></div><div id="pg-fx" class="page"><div class="card" style="left:0;top:0;width:420px;height:240px;"><span class="cap">EFFECTS FOR EVERY BAR</span><div class="opt"><div id="o-rfx" class="tg" action="o:rfx"><div class="kn"/><span class="cl">ON</span><span class="clo">off</span></div><span class="tx">Reduced effects (keeps glows and flashes, stops animation)</span></div><span class="cap" style="margin-top:8px;">QUALITY (animation frame rate)</span><div><span id="q-low" class="chip" action="q:low">Low  6 fps</span><span id="q-balanced" class="chip" action="q:balanced">Balanced  10 fps</span><span id="q-high" class="chip" action="q:high">High  15 fps</span></div><span class="dim" style="display:block;font-size:11px;margin-top:8px;">Effects only animate on bars you can see. A hidden bar costs nothing.</span><span id="fxstat" style="display:block;font-size:12px;margin-top:10px;"></span></div><div class="card" style="left:0;top:274px;width:704px;height:96px;"><span class="cap">ABOUT AND CREDITS</span><span class="dim" style="display:block;font-size:11px;">ButtonMaster RML, an RmlUi port of ButtonMaster by Derple and Special.Ed.</span><span class="dim" style="display:block;font-size:11px;margin-top:3px;">Game icons by Lorc, Delapouite and other contributors, from game-icons.net, licensed CC BY 3.0. Full list in CREDITS.txt.</span></div><div class="card" style="left:436px;top:0;width:284px;height:240px;"><span class="cap">HOW EFFECTS ARE DRAWN</span><span class="dim" style="display:block;font-size:11px;">Every effect is a small picture strip. Each bar flips one switch per animation step, so 36 burning buttons cost about the same Lua work as one. No blur and no shadows are used.</span></div></div><div id="pg-sim" class="page"><div class="card" style="left:0;top:0;width:720px;height:96px;"><span class="cap">SIMULATE A BAR  (no commands are sent while simulating)</span><div><span id="sb1" class="chip" action="sbar:1">Bar 1</span><span id="sb2" class="chip" action="sbar:2">Bar 2</span><span id="sb3" class="chip" action="sbar:3">Bar 3</span><span id="sb4" class="chip" action="sbar:4">Bar 4</span><span id="sb5" class="chip" action="sbar:5">Bar 5</span><span id="sb6" class="chip" action="sbar:6">Bar 6</span><span id="sb7" class="chip" action="sbar:7">Bar 7</span><span id="sb8" class="chip" action="sbar:8">Bar 8</span><span id="sb-demo" class="chip" action="sbar:demo">Demo bar</span></div><div><span id="splay" class="btn sm go" action="splay"><span class="ico i-play"/>Play</span><span class="btn sm" action="sreset">Reset</span><span class="btn sm red" action="sstop">Stop simulating</span><span id="spd-05" class="chip" action="spd:05">0.5x</span><span id="spd-1" class="chip" action="spd:1">1x</span><span id="spd-2" class="chip" action="spd:2">2x</span><span id="sm-rot" class="chip" action="smode:rot">Rotation</span><span id="sm-rand" class="chip" action="smode:rand">Random use</span></div></div><span id="sstat" style="position:absolute;left:4px;top:104px;font-size:12px;"></span><div style="position:absolute;left:0;top:126px;width:720px;"><div id="sr1" class="lrow off hasic"><img id="sri1" class="li" src="../img/ui/none.png"/><span id="srn1" class="nm"></span><span id="srs1" class="meta" style="left:200px;"></span><span class="acts"><span id="srp1" class="btn sm go" action="srp:1">Press</span><span id="srr1" class="chip" action="srr:1">Ready</span><span id="src1" class="chip" action="src:1">Cooldown</span><span id="srd1" class="chip" action="srd:1">Disabled</span><span id="srk1" class="chip" action="srk:1">Condition</span></span></div><div id="sr2" class="lrow off hasic"><img id="sri2" class="li" src="../img/ui/none.png"/><span id="srn2" class="nm"></span><span id="srs2" class="meta" style="left:200px;"></span><span class="acts"><span id="srp2" class="btn sm go" action="srp:2">Press</span><span id="srr2" class="chip" action="srr:2">Ready</span><span id="src2" class="chip" action="src:2">Cooldown</span><span id="srd2" class="chip" action="srd:2">Disabled</span><span id="srk2" class="chip" action="srk:2">Condition</span></span></div><div id="sr3" class="lrow off hasic"><img id="sri3" class="li" src="../img/ui/none.png"/><span id="srn3" class="nm"></span><span id="srs3" class="meta" style="left:200px;"></span><span class="acts"><span id="srp3" class="btn sm go" action="srp:3">Press</span><span id="srr3" class="chip" action="srr:3">Ready</span><span id="src3" class="chip" action="src:3">Cooldown</span><span id="srd3" class="chip" action="srd:3">Disabled</span><span id="srk3" class="chip" action="srk:3">Condition</span></span></div><div id="sr4" class="lrow off hasic"><img id="sri4" class="li" src="../img/ui/none.png"/><span id="srn4" class="nm"></span><span id="srs4" class="meta" style="left:200px;"></span><span class="acts"><span id="srp4" class="btn sm go" action="srp:4">Press</span><span id="srr4" class="chip" action="srr:4">Ready</span><span id="src4" class="chip" action="src:4">Cooldown</span><span id="srd4" class="chip" action="srd:4">Disabled</span><span id="srk4" class="chip" action="srk:4">Condition</span></span></div><div id="sr5" class="lrow off hasic"><img id="sri5" class="li" src="../img/ui/none.png"/><span id="srn5" class="nm"></span><span id="srs5" class="meta" style="left:200px;"></span><span class="acts"><span id="srp5" class="btn sm go" action="srp:5">Press</span><span id="srr5" class="chip" action="srr:5">Ready</span><span id="src5" class="chip" action="src:5">Cooldown</span><span id="srd5" class="chip" action="srd:5">Disabled</span><span id="srk5" class="chip" action="srk:5">Condition</span></span></div><div id="sr6" class="lrow off hasic"><img id="sri6" class="li" src="../img/ui/none.png"/><span id="srn6" class="nm"></span><span id="srs6" class="meta" style="left:200px;"></span><span class="acts"><span id="srp6" class="btn sm go" action="srp:6">Press</span><span id="srr6" class="chip" action="srr:6">Ready</span><span id="src6" class="chip" action="src:6">Cooldown</span><span id="srd6" class="chip" action="srd:6">Disabled</span><span id="srk6" class="chip" action="srk:6">Condition</span></span></div><div id="sr7" class="lrow off hasic"><img id="sri7" class="li" src="../img/ui/none.png"/><span id="srn7" class="nm"></span><span id="srs7" class="meta" style="left:200px;"></span><span class="acts"><span id="srp7" class="btn sm go" action="srp:7">Press</span><span id="srr7" class="chip" action="srr:7">Ready</span><span id="src7" class="chip" action="src:7">Cooldown</span><span id="srd7" class="chip" action="srd:7">Disabled</span><span id="srk7" class="chip" action="srk:7">Condition</span></span></div><div id="sr8" class="lrow off hasic"><img id="sri8" class="li" src="../img/ui/none.png"/><span id="srn8" class="nm"></span><span id="srs8" class="meta" style="left:200px;"></span><span class="acts"><span id="srp8" class="btn sm go" action="srp:8">Press</span><span id="srr8" class="chip" action="srr:8">Ready</span><span id="src8" class="chip" action="src:8">Cooldown</span><span id="srd8" class="chip" action="srd:8">Disabled</span><span id="srk8" class="chip" action="srk:8">Condition</span></span></div><div><span class="btn sm" action="srpg:prev">Prev</span><span id="srpg" class="dim" style="font-size:11px;margin:0 6px;"></span><span class="btn sm" action="srpg:next">Next</span></div></div></div><div class="foot"><span id="msg" class="msg"></span><span style="position:absolute;right:0;top:3px;"><span class="btn" action="close" style="margin-right:0;">Done</span></span></div></div></body></rml>